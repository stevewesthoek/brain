#!/usr/bin/env bash
# qwen — local QWEN 2.5 coder 14b CLI with file context support
# Wrapper that connects to the QWEN Ollama instance (port 11435)
# Usage:
#   qwen "prompt"                         — send prompt to QWEN
#   qwen file:path/to/file "question"    — read file + send question
#   qwen file:path/to/dir "question"     — scan dir + send question
#   qwen @pattern "question"              — find files matching pattern + send question
#   qwen                                  — interactive mode (cwd = context)

set -euo pipefail

OLLAMA_HOST="127.0.0.1:11435"
MODEL="qwen2.5-coder:14b"
MAX_CONTEXT=12000  # token limit for file context

# Check if QWEN instance is running
if ! curl -s "http://$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
  echo "✗ QWEN instance not running on $OLLAMA_HOST" >&2
  echo "Start it with: qwen-service start" >&2
  exit 1
fi

# Function to read file(s) and build context
build_context() {
  local file_pattern="$1"
  local context=""
  local char_count=0

  # Handle @pattern syntax (glob)
  if [[ "$file_pattern" == @* ]]; then
    local pattern="${file_pattern#@}"
    while IFS= read -r file; do
      if [[ -f "$file" ]]; then
        local file_content
        file_content=$(<"$file")
        local file_chars=${#file_content}
        if (( char_count + file_chars < MAX_CONTEXT )); then
          context+="
---
File: $file
---
$file_content
"
          char_count=$((char_count + file_chars))
        fi
      fi
    done < <(find . -name "$pattern" -type f 2>/dev/null | head -10)
  # Handle file: syntax (direct path or directory)
  elif [[ "$file_pattern" == file:* ]]; then
    local filepath="${file_pattern#file:}"

    # If it's a directory, scan for key files
    if [[ -d "$filepath" ]]; then
      local dir="$filepath"
      # Priority: find key files first
      local key_patterns=("README.md" "CLAUDE.md" "package.json" ".env.example" "Dockerfile" "docker-compose.yml" "*.config.ts" "*.config.js" "tsconfig.json")

      for pattern in "${key_patterns[@]}"; do
        while IFS= read -r file; do
          if [[ -f "$file" ]]; then
            local file_content
            file_content=$(<"$file")
            local file_chars=${#file_content}
            if (( char_count + file_chars < MAX_CONTEXT )); then
              context+="
---
File: $file
---
$file_content
"
              char_count=$((char_count + file_chars))
            fi
          fi
        done < <(find "$dir" -maxdepth 2 -name "$pattern" -type f 2>/dev/null)
      done

    # Single file
    elif [[ -f "$filepath" ]]; then
      context=$(<"$filepath")
      char_count=${#context}
    else
      echo "✗ File or directory not found: $filepath" >&2
      return 1
    fi
  fi

  if [[ -z "$context" ]]; then
    echo "✗ No files found or file is empty" >&2
    return 1
  fi

  echo "$context"
}

# Function to auto-load repo context (for interactive mode)
auto_load_context() {
  local cwd="$1"
  local context=""
  local char_count=0

  # Scan for key files in current directory
  # Prioritize smaller, config-like files first, truncate large files
  for file in package.json .env.example Dockerfile docker-compose.yml tsconfig.json README.md CLAUDE.md; do
    if [[ -f "$cwd/$file" && $char_count -lt $MAX_CONTEXT ]]; then
      local file_content
      file_content=$(<"$cwd/$file")
      local file_chars=${#file_content}

      # For CLAUDE.md and other large files, take only first 3000 chars
      if [[ "$file" == "CLAUDE.md" && $file_chars -gt 3000 ]]; then
        file_content="${file_content:0:3000}..."
        file_chars=3003
      fi

      if (( char_count + file_chars < MAX_CONTEXT )); then
        context+="
---
File: $file
---
$file_content
"
        char_count=$((char_count + file_chars))
      fi
    fi
  done

  if [[ -n "$context" ]]; then
    echo "$context"
  fi
}

# Function to send prompt to QWEN and handle streaming
query_qwen() {
  local prompt="$1"

  # Escape and prepare JSON
  local json_prompt
  json_prompt=$(printf '%s\n' "$prompt" | jq -R -s -c '.')

  # Send request and collect full response before printing
  curl -X POST "http://$OLLAMA_HOST/api/generate" \
    -H "Content-Type: application/json" \
    -d "{\"model\": \"$MODEL\", \"prompt\": $json_prompt, \"stream\": true}" \
    --no-buffer 2>/dev/null | \
    jq -r '.response // empty' 2>/dev/null | \
    tr -d '\n' | \
    fold -w 80 -s

  echo ""
}

# Main logic
if [ $# -eq 0 ]; then
  # Interactive mode - auto-load repo context
  echo "QWEN 2.5 coder 14b (local, via Ollama)"
  echo "Working directory: $(pwd)"
  echo ""

  # Try to auto-load context
  auto_context=$(auto_load_context "$(pwd)") || true
  if [[ -n "$auto_context" ]]; then
    echo "[Auto-loaded repo context: README.md, package.json, etc.]"
    echo ""
  fi

  echo "Type your prompt and press Enter. Type 'exit' to quit."
  echo "Use: file:path/to/file or file:path/to/dir or @pattern for explicit context"
  echo ""

  while true; do
    printf "qwen> "
    read -r user_input

    if [ "$user_input" = "exit" ] || [ "$user_input" = "quit" ]; then
      echo "Goodbye!"
      break
    fi

    if [ -z "$user_input" ]; then
      continue
    fi

    # Check if input starts with file: or @
    if [[ "$user_input" =~ ^(file:|@) ]]; then
      # Extract file pattern and question
      pattern=$(echo "$user_input" | awk '{print $1}')
      question=$(echo "$user_input" | cut -d' ' -f2- 2>/dev/null || echo "")

      if [[ -z "$question" ]]; then
        echo "Usage: file:path \"question\" or @pattern \"question\"" >&2
        continue
      fi

      echo "[Loading context...]"
      if ! context=$(build_context "$pattern" 2>/dev/null); then
        continue
      fi

      full_prompt="Context from files:
$context

Question: $question"
      query_qwen "$full_prompt"
    else
      # Use auto-loaded context + user prompt
      if [[ -n "${auto_context:-}" ]]; then
        full_prompt="You have been provided with the following files from the repository:

$auto_context

---

Based on these files, answer the following question:
$user_input"
        query_qwen "$full_prompt"
      else
        query_qwen "$user_input"
      fi
    fi

    echo ""
  done
else
  # Non-interactive mode: parse arguments
  first_arg="$1"
  shift || true

  if [[ "$first_arg" =~ ^(file:|@) ]]; then
    # File context mode
    context=$(build_context "$first_arg" 2>/dev/null) || exit 1

    question="$*"
    if [[ -z "$question" ]]; then
      echo "Error: No question provided" >&2
      exit 1
    fi

    full_prompt="Context from files:
$context

Question: $question"
    query_qwen "$full_prompt"
  else
    # Regular prompt mode (all args are the prompt)
    if [ $# -eq 0 ]; then
      query_qwen "$first_arg"
    else
      query_qwen "$first_arg $*"
    fi
  fi
fi
