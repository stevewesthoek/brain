{
  "name": "google-ads-dashboard",
  "version": "1.0.0",
  "description": "Google Ads Mutation Dashboard - Web UI for reviewing and approving mutations",
  "main": "dashboard-server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec ts-node --esm tools/google-ads/dashboard-server.ts",
    "dev:frontend": "vite",
    "build:backend": "tsc tools/google-ads/dashboard-server.ts --outDir dist --module commonjs --target es2020",
    "build:frontend": "vite build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "node dist/tools/google-ads/dashboard-server.js",
    "start": "npm run start:backend",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/ws": "^8.5.4",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "vite": "^4.4.9",
    "@vitejs/plugin-react": "^4.0.3",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
