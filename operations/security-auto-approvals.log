if items:
    item = items[0]
    status = re.search(r'\"status\":\"([^\"]+)\"', item)
    created = re.search(r'\"createdAt\":\"([^\"]+)\"', item)
    logpath = re.search(r'\"logPath\":\"([^\"]+)\"', item)
