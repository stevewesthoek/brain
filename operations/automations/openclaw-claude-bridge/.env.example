# ── Inbound auth (OpenClaw → Bridge) ──────────────────────────────────────────
# Shared secret. OpenClaw sends this in X-Bridge-Secret header.
BRIDGE_SECRET=change_me_strong_secret

# ── Binding ────────────────────────────────────────────────────────────────────
# Mac Mini Tailscale IP — bridge only listens here, not 0.0.0.0
BRIDGE_HOST=100.86.124.66
BRIDGE_PORT=3457

# ── IP allowlist ───────────────────────────────────────────────────────────────
# Comma-separated Tailscale IPs allowed to call this bridge
ALLOWED_IPS=100.101.212.108

# ── OpenClaw callback (Bridge → OpenClaw) ──────────────────────────────────────
OPENCLAW_GATEWAY_URL=http://100.101.212.108:18789
OPENCLAW_AGENT_ID=main
# Bearer token from OpenClaw gateway config — NEVER commit this value
OPENCLAW_BEARER_TOKEN=your_openclaw_bearer_token_here

# ── Repos ──────────────────────────────────────────────────────────────────────
REPOS_ROOT=/Users/Office/Repos

# ── Session / polling ──────────────────────────────────────────────────────────
OUTPUT_TRUNCATE_CHARS=4000
POLL_INTERVAL_MS=1500
POLL_MAX_ATTEMPTS=60
STABILITY_REQUIRED_POLLS=3
CLAUDE_STARTUP_WAIT_MS=4000

# ── Skills ─────────────────────────────────────────────────────────────────────
SKILLS_DIR=/Users/Office/Repos/stevewesthoek/brain/ai/skills/active

# ── Safety ─────────────────────────────────────────────────────────────────────
# DANGEROUS: enables POST /shell — keep false in production
ALLOW_SHELL_EXEC=false

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
