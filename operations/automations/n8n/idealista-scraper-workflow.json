{
  "name": "Idealista Scraper Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "87a19ecf-e99a-4a3e-8482-7ff79f2aac18",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "87a19ecf-e99a-4a3e-8482-7ff79f2aac18"
    },
    {
      "parameters": {
        "actorId": "apify/idealista-scraper",
        "options": {
          "body": "={{$json.body}}",
          "token": "YOUR_APIFY_TOKEN"
        }
      },
      "name": "Apify Idealista Scraper",
      "type": "n8n-nodes-base.apify",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "credentials": {
        "apifyApi": {
          "id": "YOUR_APIFY_CREDENTIALS_ID",
          "name": "Apify account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "append",
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "sheetName": "Sheet1",
        "fields": {
          "values": "={{$node[\"Apify Idealista Scraper\"].json.defaultDatasetId}}"
        },
        "options": {}
      },
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        750,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIALS_ID",
          "name": "Google account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "sender@example.com",
        "toEmail": "={{$json.body.clientEmail}}",
        "subject": "Idealista Scraper Results",
        "text": "Your Idealista scrape is complete. The data has been added to your Google Sheet.",
        "options": {}
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIALS_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "body": "={{$node[\"Apify Idealista Scraper\"].json}}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Apify Idealista Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apify Idealista Scraper": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "id": "1"
}