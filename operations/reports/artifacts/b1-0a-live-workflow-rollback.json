    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\nconst now = new Date();\nconst source = String(b.source || 'chatgpt');\nconst title = String(b.title || 'Untitled Capture');\nconst content = String(b.content || b.text || b.note || '');\nconst typeHint = b.type_hint ? String(b.type_hint) : '';\nconst sourceUrl = b.url || b.source_url || b.link || '';\nconst created = now.toISOString();\nconst date = created.slice(0, 10);\nconst compactStamp = created.replace(/[-:]/g, '').replace(/\\..+$/, '').replace('T', '-');\nconst slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 70) || 'untitled-capture';\nconst inboxPrefix = 'inbox/new';\nconst filepath = inboxPrefix + '/' + compactStamp + '-' + slug + '.md';\n\nreturn [{\n  json: {\n    source,\n    title,\n    content,\n    typeHint,\n    sourceUrl,\n    created,\n    date,\n    filepath,\n    queuedForClassification: true,\n    classifier: 'Mind Steward',\n  },\n}];\n"
      },
      "id": "prepare-capture",
      "name": "Prepare Capture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function utf8ToBase64(str) {\n  const bytes = [];\n  for (let i = 0; i < str.length; i++) {\n    let code = str.charCodeAt(i);\n    if (code < 0x80) { bytes.push(code); }\n    else if (code < 0x800) { bytes.push(0xc0 | (code >> 6)); bytes.push(0x80 | (code & 0x3f)); }\n    else if (code >= 0xd800 && code <= 0xdbff) {\n      i++;\n      const next = str.charCodeAt(i);\n      const fullCode = 0x10000 + (((code & 0x3ff) << 10) | (next & 0x3ff));\n      bytes.push(0xf0 | (fullCode >> 18));\n      bytes.push(0x80 | ((fullCode >> 12) & 0x3f));\n      bytes.push(0x80 | ((fullCode >> 6) & 0x3f));\n      bytes.push(0x80 | (fullCode & 0x3f));\n    } else {\n      bytes.push(0xe0 | (code >> 12));\n      bytes.push(0x80 | ((code >> 6) & 0x3f));\n      bytes.push(0x80 | (code & 0x3f));\n    }\n  }\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\n  let output = '';\n  for (let i = 0; i < bytes.length; i += 3) {\n    const a = bytes[i], b = bytes[i + 1], c = bytes[i + 2];\n    output += chars[a >> 2];\n    output += chars[((a & 3) << 4) | ((b ?? 0) >> 4)];\n    output += b === undefined ? '=' : chars[((b & 15) << 2) | ((c ?? 0) >> 6)];\n    output += c === undefined ? '=' : chars[c & 63];\n  }\n  return output;\n}\n\nfunction yamlString(value) {\n  return JSON.stringify(String(value ?? ''));\n}\n\nconst capture = $('Prepare Capture').first().json;\nconst sourceLines = [];\nif (capture.sourceUrl) sourceLines.push('- URL: ' + capture.sourceUrl);\nif (capture.typeHint) sourceLines.push('- Type hint: ' + capture.typeHint);\nconst sourceBlock = sourceLines.length ? sourceLines.join('\\n') : '- Source: ' + capture.source;\n\nconst md = [\n  '---',\n  'type: capture',\n  'source: ' + yamlString(capture.source),\n  'status: queued',\n  'para_type: inbox',\n  'confidence: 0',\n  'signal_quality: 0',\n  'title: ' + yamlString(capture.title),\n  'created: ' + yamlString(capture.created),\n  'mind_steward_status: queued',\n  'mind_steward_local_only: true',\n  'mind_steward_task_type: mind_capture_classification',\n  '---',\n  '',\n  '# ' + capture.title,\n  '',\n  '## Source',\n  sourceBlock,\n  '',\n  '## Content',\n  capture.content,\n  '',\n].join('\\n');\n\nreturn [{\n  json: {\n    ...capture,\n    markdown: md,\n    base64: utf8ToBase64(md),\n  },\n}];"
      },
