{
  "openapi": "3.1.0",
  "info": {
    "title": "Save to Mind API",
    "version": "1.1.0",
    "description": "Save conversations and ideas to Mind inbox/new. Classification is a separate operator-invoked private Bedrock action; it is not scheduled."
  },
  "servers": [
    {
      "url": "https://n8n.prochat.tools"
    }
  ],
  "paths": {
    "/webhook/mind-inbox": {
      "post": {
        "operationId": "saveToMind",
        "summary": "Save a conversation or idea to Mind",
        "description": "Creates a new Markdown capture in mind/inbox/new without running or scheduling classification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "content"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Source of the capture.",
                    "default": "chatgpt"
                  },
                  "title": {
                    "type": "string",
                    "description": "Short descriptive title for the capture."
                  },
                  "content": {
                    "type": "string",
                    "description": "Full capture content."
                  },
                  "type_hint": {
                    "type": "string",
                    "description": "Optional hint stored with the capture for later Mind Steward classification.",
                    "enum": [
                      "project",
                      "area",
                      "resource",
                      "task",
                      "decision",
                      "research",
                      "inbox"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capture saved; no classifier execution is implied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Save status."
                    },
                    "result": {
                      "type": "string",
                      "description": "Save result."
                    },
                    "queued_for_classification": {
                      "type": "boolean",
                      "description": "Whether the capture is eligible for a separately invoked operator classification. This does not mean classification is scheduled."
                    },
                    "classifier": {
                      "type": "string",
                      "description": "Classifier responsible for later processing."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "500": {
            "description": "Server error during save."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
