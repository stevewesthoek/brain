{
  "name": "ING Statement Monthly",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "days": 1,
              "hours": 9,
              "minutes": 0,
              "triggerAtStart": false
            }
          ]
        },
        "triggerAtStart": false
      },
      "id": "87cf9b36-d2f9-4f2c-b7c9-8a3f7c5e1d4b",
      "name": "Trigger - Monthly (1st, 9 AM Lisbon)",
      "type": "n8n-nodes-base.cronTrigger",
      "typeVersion": 1,
      "position": [
        250,
        400
      ]
    },
    {
      "parameters": {
        "setAllData": false,
        "values": {
          "string": {
            "retryAttempt": 0,
            "attemptType": "initial"
          }
        }
      },
      "id": "a1b2c3d4-e5f6-4a5b-6c7d-8e9f0a1b2c3d",
      "name": "Initialize Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        400
      ]
    },
    {
      "parameters": {
        "command": "#!/bin/bash\nset -e\n\n# Load ING credentials\nsource ~/.config/ing/.env\n\n# Set timeout based on attempt type\nif [ \"{{ $json.attemptType }}\" = \"initial\" ]; then\n  TIMEOUT_SECONDS=600\nelse\n  TIMEOUT_SECONDS=600\nfi\n\n# Run Playwright script\nnode ~/tools/scripts/bank-statement-login.js\nEXIT_CODE=$?\n\necho \"{\\\"exitCode\\\": $EXIT_CODE}\"\nexit $EXIT_CODE\n",
        "workingDirectory": "~"
      },
      "id": "b2c3d4e5-f6a7-4b5c-7d8e-9f0a1b2c3d4e",
      "name": "Execute - Login & Download Statements",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        650,
        400
      ],
      "onError": "continueErrorHandling"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "{{ $node[\"Execute - Login & Download Statements\"].status }}",
              "operation": "equals",
              "value2": "success"
            }
          ]
        }
      },
      "id": "c3d4e5f6-a7b8-4c5d-8e9f-0a1b2c3d4e5f",
      "name": "IF - Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        850,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ntfy.sh/stevewesthoek-bank-approval",
        "headerParameters": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "text/plain"
            }
          ]
        },
        "body": "ING statements downloaded successfully"
      },
      "id": "d4e5f6a7-b8c9-4d5e-9f0a-1b2c3d4e5f6a",
      "name": "Notify Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ntfy.sh/stevewesthoek-bank-approval",
        "headerParameters": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "text/plain"
            }
          ]
        },
        "body": "ING login timed out. Retrying..."
      },
      "id": "e5f6a7b8-c9d0-4e5f-0a1b-2c3d4e5f6a7b",
      "name": "Notify Timeout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1050,
        500
      ]
    },
    {
      "parameters": {
        "waitTillDate": "={{ $now.plus(10, 'minutes') }}"
      },
      "id": "f6a7b8c9-d0e1-4f5a-1b2c-3d4e5f6a7b8c",
      "name": "Wait 10 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "setAllData": false,
        "values": {
          "string": {
            "retryAttempt": "={{ $json.retryAttempt + 1 }}"
          }
        }
      },
      "id": "a7b8c9d0-e1f2-4a5b-1c2d-3e4f5a6b7c8d",
      "name": "Increment Retry Counter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1450,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "{{ $json.retryAttempt }}",
              "operation": "lessThan",
              "value2": 9
            }
          ]
        }
      },
      "id": "b8c9d0e1-f2a3-4b5c-2d3e-4f5a6b7c8d9e",
      "name": "IF - Retry < 9?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1650,
        500
      ]
    },
    {
      "parameters": {
        "to": "info@prochat.tools",
        "subject": "ING Bank Statement Download Failed — Manual Action Required",
        "emailType": "html",
        "htmlEmail": "<h2>ING Statement Download Failed</h2>\n<p>The automated download of your ING bank statements failed after 9 attempts (3 every 10 minutes, 6 hourly).</p>\n<p><strong>Reason:</strong> You did not approve the 2FA login request on your phone in time.</p>\n<p><strong>Action Required:</strong></p>\n<ol>\n  <li>Click the link below to retry the download</li>\n  <li>When prompted, immediately approve the login on your ING app</li>\n</ol>\n<p><a href=\"https://n8n.prochat.tools/webhook/ing-fallback-{{ $json.attemptId }}\" style=\"background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;\">Retry Download</a></p>\n<p>If this doesn't work, log in manually to <a href=\"https://mijnzakelijk.ing.nl/banking/overview\">mijnzakelijk.ing.nl</a> and download the statements.</p>"
      },
      "id": "c9d0e1f2-a3b4-4c5d-3e4f-5a6b7c8d9e0f",
      "name": "Send Fallback Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.1,
      "position": [
        1850,
        650
      ]
    },
    {
      "parameters": {
        "jsCode": "// Re-execute the Playwright script for retry\nreturn [\n  {\n    \"message\": \"Retrying download with attempt \" + $json.retryAttempt\n  }\n];"
      },
      "id": "d0e1f2a3-b4c5-4d5e-4f5a-6b7c8d9e0f1a",
      "name": "Retry Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1450,
        300
      ]
    }
  ],
  "connections": {
    "Trigger - Monthly (1st, 9 AM Lisbon)": {
      "main": [
        [
          {
            "node": "Initialize Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Variables": {
      "main": [
        [
          {
            "node": "Execute - Login & Download Statements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute - Login & Download Statements": {
      "main": [
        [
          {
            "node": "IF - Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Success?": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Timeout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Success": {
      "main": [
        [
          {
            "node": "Retry Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Timeout": {
      "main": [
        [
          {
            "node": "Wait 10 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 Minutes": {
      "main": [
        [
          {
            "node": "Increment Retry Counter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Increment Retry Counter": {
      "main": [
        [
          {
            "node": "IF - Retry < 9?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Retry < 9?": {
      "main": [
        [
          {
            "node": "Execute - Login & Download Statements",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Fallback Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null
}
