# Clerk CLI Configuration Template
# Copy this to ~/.config/clerk/.env if you need to store Clerk credentials
# locally for automated workflows (e.g., n8n, cron scripts)
#
# NOTE: The Clerk CLI uses browser OAuth (stored in ~/.clerk.json).
# This file is optional and only needed if you want to programmatically
# authenticate without browser interaction.
#
# For details, see: brain/operations/runbooks/clerk-cli.md

# CLERK_API_KEY=sk_test_xxxxx
# ^ Secret API key from Clerk dashboard (if needed for API access, not CLI)
#   See: https://dashboard.clerk.com/apps → Select app → API Keys → Secret Key

# CLERK_JWT_KEY=xxxxx
# ^ JWT template key (optional, for local JWT verification)
#   See: https://dashboard.clerk.com/apps → Select app → API Keys

# CLERK_APP_ID=app_xxxxx
# ^ Default app ID (optional, for multi-app setups)
#   See: https://dashboard.clerk.com/apps → Select app → ID

# CLERK_DEFAULT_ENV=production
# ^ Environment: production or development (optional)

# CLERK_DEBUG=false
# ^ Enable debug logging (optional, set to true for troubleshooting)
