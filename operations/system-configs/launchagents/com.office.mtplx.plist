<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.office.mtplx</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/mtplx</string>
        <string>quickstart</string>
        <string>--profile</string>
        <string>sustained</string>
        <string>--port</string>
        <string>8000</string>
        <string>--api-key</string>
        <string>sk-proj-mtplx-internal-000000</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/Office/.local/video-orchestrator/logs/mtplx.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Office/.local/video-orchestrator/logs/mtplx.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/Office</string>
</dict>
</plist>
