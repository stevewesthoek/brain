<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.office.nightly-scheduler</string>

    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/node</string>
      <string>/Users/Office/Repos/stevewesthoek/brain-runtime/tools/scripts/brain-scheduler-runner.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Office/Repos/stevewesthoek/brain-runtime</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/Office/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Office/Library/Logs/office-scheduler/nightly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Office/Library/Logs/office-scheduler/nightly.error.log</string>
  </dict>
</plist>
