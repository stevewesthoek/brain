<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.office.brain-cli-access-health</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>/Users/Office/Repos/stevewesthoek/brain/tools/scripts/cli-access-health-watch.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Office/Repos/stevewesthoek/brain</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/Office/.local/bin:/Users/Office/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Office/Library/Logs/office-scheduler/cli-access-health.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Office/Library/Logs/office-scheduler/cli-access-health.error.log</string>
  </dict>
</plist>
