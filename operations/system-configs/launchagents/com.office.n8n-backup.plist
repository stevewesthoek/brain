<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Legacy standalone agent. Superseded by com.office.nightly-scheduler. -->
  <dict>
    <key>Label</key>
    <string>com.office.n8n-backup</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>/Users/Office/Repos/stevewesthoek/brain/tools/scripts/run-n8n-backup-schedule.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Office/Repos/stevewesthoek/brain</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Office/Library/Logs/com.office.n8n-backup.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Office/Library/Logs/com.office.n8n-backup.log</string>
  </dict>
</plist>
