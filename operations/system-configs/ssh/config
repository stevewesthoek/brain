# ============================================================
# M4 Mac Mini Pro / Office machine
# ============================================================
# General M4 access.
# This alias points back to this M4 machine.
# Keep it for consistency with scripts, testing, and shared config habits.
# Default: Tailscale.
# Terminal SSH prefers Thunderbolt when 192.168.2.1:22 is reachable.
# Thunderbolt override for terminal SSH.
# If 192.168.2.1:22 is reachable, terminal SSH uses Thunderbolt.
Match host office exec "/usr/bin/nc -G 1 -z 192.168.2.1 22"
  HostName 192.168.2.1
  ConnectTimeout 2

Host office
  HostName 100.86.124.66
  User office
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostKeyAlias office-m4
  ConnectTimeout 5
  ServerAliveInterval 15
  ServerAliveCountMax 2

# Fixed Office routes used by Codex and other applications that do not
# evaluate the dynamic Match exec override reliably.
Host office-repos-tb
  HostName 192.168.2.1
  User office
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostKeyAlias office-m4
  ConnectTimeout 2
  ServerAliveInterval 15
  ServerAliveCountMax 2

Host office-repos-ts
  HostName 100.86.124.66
  User office
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostKeyAlias office-m4
  ConnectTimeout 8
  ServerAliveInterval 15
  ServerAliveCountMax 2

# ============================================================
# Global SSH defaults
# ============================================================
# Applies to every Host unless overridden above.
#
# AddKeysToAgent: Automatically adds used SSH keys to the ssh-agent.
#   
# UseKeychain: macOS-specific. Lets SSH store/use key passphrases from Keychain.
#   
# IdentityFile: Default SSH key to try when a host does not define its own key.
#   
# Keep this block at the bottom. OpenSSH uses the first value it gets for many
# options, so specific host rules should appear above general defaults.
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
