# ============================================================
# MacBook: prefer Thunderbolt when reachable, otherwise use Tailscale
# ============================================================
# Thunderbolt override for terminal SSH.
Match host MacBook,macbook exec "/usr/bin/nc -G 1 -z 192.168.2.2 22"
  HostName 192.168.2.2
  ConnectTimeout 2

Host MacBook macbook
  HostName 100.70.12.18
  User Steve
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostKeyAlias macbook-m1
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ConnectTimeout 5

