[user]
	name = Steve Westhoek
	email = info@prochat.tools
[alias]
	pushall = !git push origin main && git push demo main
	pushallt = !git push origin --tags && git push demo --tags
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[includeIf "gitdir:/Users/Office/Repos/stevewesthoek/"]
	path = /Users/Office/.gitconfig-github-stevewesthoek
[includeIf "gitdir:/Users/Office/Repos/prochattools/"]
	path = /Users/Office/.gitconfig-github-prochattools
[includeIf "gitdir:/Users/Office/Repos/prochatdemo/"]
	path = /Users/Office/.gitconfig-github-prochatdemo
[includeIf "gitdir:/Users/Office/Repos/yeshuaacademy/"]
	path = /Users/Office/.gitconfig-github-yeshuaacademy
