#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: azure-service-principal-wrapper <profile-name> [az args...]" >&2
  exit 1
fi

profile_name="$1"
shift

cred_file="${AZURE_AI_CREDENTIALS_DIR:-$HOME/.config/azure-ai/credentials}/${profile_name}.env"
config_dir="${AZURE_AI_CONFIG_DIR:-$HOME/.config/azure-ai/profiles}/${profile_name}"

if [[ ! -f "${cred_file}" ]]; then
  echo "Azure credential file not found: ${cred_file}" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "${cred_file}"

: "${AZURE_CLIENT_ID:?missing AZURE_CLIENT_ID}"
: "${AZURE_CLIENT_SECRET:?missing AZURE_CLIENT_SECRET}"
: "${AZURE_TENANT_ID:?missing AZURE_TENANT_ID}"
: "${AZURE_SUBSCRIPTION_ID:?missing AZURE_SUBSCRIPTION_ID}"

mkdir -p "${config_dir}"
export AZURE_CONFIG_DIR="${config_dir}"

az_bin="${AZURE_CLI_BIN:-/opt/homebrew/bin/az}"

if ! "${az_bin}" account show --output none >/dev/null 2>&1; then
  "${az_bin}" login \
    --service-principal \
    --username "${AZURE_CLIENT_ID}" \
    --password "${AZURE_CLIENT_SECRET}" \
    --tenant "${AZURE_TENANT_ID}" \
    --output none
fi

"${az_bin}" account set --subscription "${AZURE_SUBSCRIPTION_ID}" >/dev/null
exec "${az_bin}" "$@"
