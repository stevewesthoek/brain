#!/usr/bin/env bash
set -euo pipefail

# Warm Stable Audio 3 model caches by running a short generation for each requested model.
# This downloads the selected weights into the local Hugging Face cache.

stable_audio_repo="${STABLE_AUDIO_3_REPO:-$HOME/ai-models/stable-audio-3}"
output_dir="${STABLE_AUDIO_3_WARMUP_DIR:-/tmp}"

models=("$@")
if [[ ${#models[@]} -eq 0 ]]; then
  models=(small-music small-sfx medium)
fi

for model in "${models[@]}"; do
  case "${model}" in
    small-music)
      prompt="test tone"
      duration=5
      output="${output_dir}/stable-audio-small-music.wav"
      ;;
    small-sfx)
      prompt="test effect"
      duration=5
      output="${output_dir}/stable-audio-small-sfx.wav"
      ;;
    medium)
      prompt="test pad"
      duration=5
      output="${output_dir}/stable-audio-medium.wav"
      ;;
    *)
      echo "unknown model: ${model}" >&2
      exit 1
      ;;
  esac

  uv run --directory "${stable_audio_repo}" stable-audio \
    --model "${model}" \
    -p "${prompt}" \
    --duration "${duration}" \
    -o "${output}"
done
