#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  cat >&2 <<'EOF'
usage: cloudflare-cli <profile-name> <command> [args...]

profiles:
  prochat-provisioner
  prochat-destroyer
  jpvbootcamp-provisioner
  jpvbootcamp-destroyer
EOF
  exit 1
fi

profile_name="$1"
shift

exec /Users/Office/Repos/stevewesthoek/brain/operations/system-configs/bin/cloudflare-account-wrapper "${profile_name}" "$@"
