{
  "version": 4,
  "providers": [
    {
      "id": "gemini-free",
      "label": "Gemini free-tier",
      "type": "gemini",
      "api_key_env": "GEMINI_API_KEY",
      "expose_api_key": false,
      "cost_per_1k_tokens": 0.0,
      "priority": 1,
      "capabilities": ["text/small", "text/medium", "text/large"],
      "max_context_tokens": 1000000,
      "health_check": { "env_exists": "GEMINI_API_KEY" },
      "timeout_connect_sec": 5,
      "timeout_inference_sec": 180,
      "schedule_preference": "any",
      "models": ["gemini-2.5-flash"],
      "privacy_allowed": "non_sensitive_only",
      "quota_policy": {
        "track": ["rpm", "tpm", "rpd"],
        "rpm_limit": 60,
        "tpm_limit": 1000000,
        "rpd_limit": 1000000,
        "fallback_on": ["quota_exhausted", "429", "health_failure", "quality_failure"]
      },
      "notes": "Use first for eligible non-sensitive high-volume text drafts while free-tier quota remains. Do not use for sensitive, private, offline, or external-provider-disallowed payloads."
    },
    {
      "id": "ollama-m4pro",
      "label": "Mac Mini M4 Pro (local)",
      "type": "openai-compatible",
      "base_url": "http://localhost:11434/v1",
      "api_key": null,
      "cost_per_1k_tokens": 0.0,
      "priority": 2,
      "capabilities": ["text/small", "text/medium", "text/large", "image/analyze"],
      "max_context_tokens": 128000,
      "health_check": { "endpoint": "http://localhost:11434/api/tags", "method": "GET", "expect_status": 200 },
      "timeout_connect_sec": 3,
      "timeout_inference_sec": 120,
      "schedule_preference": "any",
      "preferred_models": ["qwen2.5:14b", "qwen2.5:32b", "llama3.1:8b"]
    },
    {
      "id": "ollama-m1",
      "label": "MacBook M1 (Thunderbolt node)",
      "type": "openai-compatible",
      "base_url": "http://192.168.2.2:11434/v1",
      "api_key": null,
      "cost_per_1k_tokens": 0.0,
      "priority": 3,
      "capabilities": ["text/small", "text/medium"],
      "max_context_tokens": 32768,
      "health_check": { "endpoint": "http://192.168.2.2:11434/api/tags", "method": "GET", "expect_status": 200 },
      "timeout_connect_sec": 5,
      "timeout_inference_sec": 180,
      "schedule_preference": "batch_window",
      "preferred_models": ["qwen2.5:14b", "llama3.1:8b", "llama3.2:3b"],
      "notes": "M1 MacBook on Thunderbolt Bridge. 2-3x slower than M4 Pro. Prefer for batch/overnight tasks."
    },
    {
      "id": "whisper-m4pro",
      "label": "MLX Whisper (M4 Pro local)",
      "type": "whisper",
      "binary": "mlx_whisper",
      "cost_per_1k_tokens": 0.0,
      "priority": 2,
      "capabilities": ["audio/transcribe"],
      "health_check": { "binary_exists": "mlx_whisper" },
      "schedule_preference": "any",
      "models": ["large-v3", "distil-large-v3"],
      "notes": "Local M4 Pro whisper. Lower priority than M1 remote so M4 Pro stays free for text inference."
    },
    {
      "id": "whisper-m1",
      "label": "MLX Whisper (M1 MacBook remote)",
      "type": "whisper-remote",
      "base_url": "http://192.168.2.2:4891",
      "cost_per_1k_tokens": 0.0,
      "priority": 1,
      "capabilities": ["audio/transcribe"],
      "health_check": { "endpoint": "http://192.168.2.2:4891/health", "method": "GET", "expect_status": 200 },
      "timeout_connect_sec": 5,
      "timeout_inference_sec": 600,
      "schedule_preference": "any",
      "models": ["large-v3", "distil-large-v3"],
      "notes": "M1 MacBook dedicated whisper worker over Thunderbolt. Preferred for transcription to free M4 Pro GPU for text inference."
    },
    {
      "id": "codex-cli",
      "label": "ChatGPT subscription Codex CLI",
      "type": "cli",
      "cost_per_1k_tokens": 0.0,
      "priority": 4,
      "capabilities": ["text/small", "text/medium", "text/large", "text/review"],
      "max_context_tokens": 200000,
      "health_check": { "binary_exists": "codex" },
      "timeout_connect_sec": 5,
      "timeout_inference_sec": 300,
      "schedule_preference": "any",
      "models": ["gpt-5.4-mini", "gpt-5.4", "gpt-5.5"],
      "notes": "Local Codex CLI routing under the ChatGPT subscription. No OpenAI API use."
    },
    {
      "id": "claude-bedrock",
      "label": "Amazon Bedrock model portfolio",
      "type": "bedrock",
      "cost_per_1k_tokens": 0.0,
      "priority": 5,
      "capabilities": ["text/small", "text/medium", "text/large", "text/review", "text/large-context-batch"],
      "max_context_tokens": 200000,
      "health_check": { "binary_exists": "aws" },
      "timeout_connect_sec": 5,
      "timeout_inference_sec": 300,
      "schedule_preference": "any",
      "models": ["bedrock-model-portfolio"],
      "notes": "Cost-quality Bedrock portfolio. Cheap capable models are tried before premium Claude fallbacks. No direct Anthropic API use."
    }
  ]
}
