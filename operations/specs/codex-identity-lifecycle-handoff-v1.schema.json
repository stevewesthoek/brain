{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prochat.local/brain/codex-identity-lifecycle-handoff-v1.schema.json",
  "title": "Codex Identity Lifecycle Handoff v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "handoffId",
    "phase",
    "status",
    "expectedMainSha",
    "expectedOriginMainSha",
    "sourceCheckout",
    "canonicalCheckout",
    "profilesRoot",
    "profiles",
    "configOwnership",
    "processAbsencePredicates",
    "externalOperations",
    "webGptPolicy",
    "rollback",
    "continuationEvidencePath",
    "containsSecrets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "brain.codex.identity.lifecycle-handoff" },
    "handoffId": { "type": "string", "pattern": "^codex-identity-[A-Za-z0-9TZ-]+$" },
    "phase": { "const": "A" },
    "status": { "const": "READY_FOR_EXTERNAL_PHASE" },
    "preparedAt": { "type": "string", "format": "date-time" },
    "expectedMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expectedOriginMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceCheckout": { "type": "string", "pattern": "^/" },
    "canonicalCheckout": { "type": "string", "pattern": "^/" },
    "profilesRoot": { "type": "string", "pattern": "^/" },
    "candidateCatalog": { "type": "string", "pattern": "^/" },
    "canonicalCatalog": { "type": "string", "pattern": "^/" },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "runtimeProfileId", "role", "preferred", "purpose", "root"],
        "properties": {
          "accountId": { "type": "string", "pattern": "^account:[A-Za-z0-9._-]+$" },
          "runtimeProfileId": { "type": "string", "pattern": "^runtime_profile:[A-Za-z0-9._-]+$" },
          "role": { "enum": ["primary", "secondary"] },
          "preferred": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "configOwnership": { "type": "object" },
    "processAbsencePredicates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "externalOperations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "webGptPolicy": { "type": "object" },
    "rollback": { "type": "object" },
    "preparationEvidence": { "type": "object" },
    "continuationEvidencePath": { "type": "string", "pattern": "^/" },
    "containsSecrets": { "const": false }
  }
}
