{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prochat.local/brain/codex-identity-profile-lifecycle-handoff-v2.schema.json",
  "title": "Codex Identity Profile-Scoped Lifecycle Handoff v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "handoffId",
    "phase",
    "status",
    "expectedMainSha",
    "expectedOriginMainSha",
    "sourceCheckout",
    "canonicalCheckout",
    "profilesRoot",
    "candidateCatalog",
    "canonicalCatalog",
    "profiles",
    "policy",
    "webGptPolicy",
    "continuationEvidencePath",
    "containsSecrets"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "kind": { "const": "brain.codex.identity.profile-lifecycle-handoff" },
    "handoffId": { "type": "string", "pattern": "^codex-profile-[A-Za-z0-9TZ-]+$" },
    "phase": { "const": "PROFILE_SCOPED" },
    "status": { "const": "READY_FOR_PROFILE_SCOPED_EXECUTION" },
    "expectedMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expectedOriginMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceCheckout": { "type": "string", "pattern": "^/" },
    "canonicalCheckout": { "type": "string", "pattern": "^/" },
    "profilesRoot": { "type": "string", "pattern": "^/" },
    "candidateCatalog": { "type": "string", "pattern": "^/" },
    "canonicalCatalog": { "type": "string", "pattern": "^/" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "runtimeProfileId", "role", "preferred", "purpose", "root"],
        "properties": {
          "accountId": { "type": "string", "pattern": "^account:[A-Za-z0-9._-]+$" },
          "runtimeProfileId": { "type": "string", "pattern": "^runtime_profile:[A-Za-z0-9._-]+$" },
          "role": { "type": "string", "minLength": 1 },
          "preferred": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "lifecycleScope",
        "globalProcessQuiescenceRequired",
        "targetProfileLeaseRequired",
        "sharedDefaultRootMutation",
        "webGptMutation",
        "oauthReadOrCopy",
        "canonicalCatalogMutation",
        "nAccountModel"
      ],
      "properties": {
        "lifecycleScope": { "const": "profile_scoped" },
        "globalProcessQuiescenceRequired": { "const": false },
        "targetProfileLeaseRequired": { "const": true },
        "sharedDefaultRootMutation": { "const": false },
        "webGptMutation": { "const": false },
        "oauthReadOrCopy": { "const": false },
        "canonicalCatalogMutation": { "const": false },
        "nAccountModel": { "const": "dynamic_collection" }
      }
    },
    "webGptPolicy": { "type": "object" },
    "continuationEvidencePath": { "type": "string", "pattern": "^/" },
    "containsSecrets": { "const": false }
  }
}
