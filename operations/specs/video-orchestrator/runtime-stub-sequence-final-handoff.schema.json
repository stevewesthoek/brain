{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-sequence-final-handoff.schema.json",
  "title": "Runtime Stub Sequence Final Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_sequence_final_handoff_id", "runtime_stub_sequence_regression_report_id", "runtime_stub_sequence_integrity_audit_id", "runtime_stub_archive_final_summary_id", "render_plan_id", "project_id", "platform", "created_at", "handoff_state", "required_artifacts", "handoff_scope", "handoff_controls", "handoff_sections", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_sequence_final_handoff_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_regression_report_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_integrity_audit_id": { "type": "string", "minLength": 1 },
    "runtime_stub_archive_final_summary_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "handoff_state": { "type": "string", "enum": ["draft", "complete", "runtime_stub_sequence_handed_off", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_sequence_regression_report_validated", "runtime_stub_sequence_integrity_audit_validated"], "properties": { "runtime_stub_sequence_regression_report_validated": { "type": "boolean", "const": true }, "runtime_stub_sequence_integrity_audit_validated": { "type": "boolean", "const": true } } },
    "handoff_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "handoff_controls": { "type": "object", "additionalProperties": false, "required": ["handoff_only", "sequence_handoff_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "handoff_only": { "type": "boolean", "const": true }, "sequence_handoff_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "handoff_sections": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["section_id", "section_kind", "safe_summary", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "ready_for_real_upload_now"], "properties": { "section_id": { "type": "string" }, "section_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_sequence_regression_report_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubSequenceFinalHandoff", "revokeRuntimeStubSequenceFinalHandoff"] }, "source_runtime_stub_sequence_regression_report_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
