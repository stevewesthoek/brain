{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-activation-contract.schema.json",
  "title": "Runtime Activation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_activation_contract_id", "explicit_runtime_activation_design_safe_report_id", "explicit_runtime_activation_design_boundary_id", "render_plan_id", "project_id", "platform", "created_at", "contract_state", "required_artifacts", "contract_scope", "contract_controls", "contract_terms", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_activation_contract_id": { "type": "string", "minLength": 1 },
    "explicit_runtime_activation_design_safe_report_id": { "type": "string", "minLength": 1 },
    "explicit_runtime_activation_design_boundary_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "contract_state": { "type": "string", "enum": ["draft", "created", "approved_for_future_contract_review", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["explicit_runtime_activation_design_safe_report_validated", "explicit_runtime_activation_design_boundary_validated"], "properties": { "explicit_runtime_activation_design_safe_report_validated": { "type": "boolean", "const": true }, "explicit_runtime_activation_design_boundary_validated": { "type": "boolean", "const": true } } },
    "contract_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "contract_controls": { "type": "object", "additionalProperties": false, "required": ["contract_only", "activation_contract_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_wiring_implemented", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "contract_only": { "type": "boolean", "const": true }, "activation_contract_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_wiring_implemented": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "contract_terms": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["term_id", "term_kind", "safe_summary", "runtime_enabled_now", "ready_for_real_upload_now", "contains_runtime_callable", "contains_raw_payload", "contains_secret_material"], "properties": { "term_id": { "type": "string" }, "term_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "runtime_enabled_now": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_explicit_runtime_activation_design_safe_report_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeActivationContract", "revokeRuntimeActivationContract"] }, "source_explicit_runtime_activation_design_safe_report_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
