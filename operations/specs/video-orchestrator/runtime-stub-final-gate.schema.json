{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-final-gate.schema.json",
  "title": "Runtime Stub Final Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_final_gate_id", "runtime_stub_release_candidate_safe_report_id", "runtime_stub_release_candidate_id", "runtime_stub_manifest_id", "render_plan_id", "project_id", "platform", "created_at", "final_gate_state", "required_artifacts", "gate_scope", "gate_controls", "gate_checks", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_final_gate_id": { "type": "string", "minLength": 1 },
    "runtime_stub_release_candidate_safe_report_id": { "type": "string", "minLength": 1 },
    "runtime_stub_release_candidate_id": { "type": "string", "minLength": 1 },
    "runtime_stub_manifest_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "final_gate_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_final_gate_review", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_release_candidate_safe_report_validated", "runtime_stub_release_candidate_validated"], "properties": { "runtime_stub_release_candidate_safe_report_validated": { "type": "boolean", "const": true }, "runtime_stub_release_candidate_validated": { "type": "boolean", "const": true } } },
    "gate_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "gate_controls": { "type": "object", "additionalProperties": false, "required": ["final_gate_only", "summary_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "final_gate_only": { "type": "boolean", "const": true }, "summary_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "gate_checks": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["check_id", "check_kind", "check_state", "safe_summary", "opened_now", "runtime_executed_now"], "properties": { "check_id": { "type": "string" }, "check_kind": { "type": "string" }, "check_state": { "type": "string", "enum": ["passed", "failed", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "opened_now": { "type": "boolean", "const": false }, "runtime_executed_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_release_candidate_safe_report_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubFinalGate", "revokeRuntimeStubFinalGate"] }, "source_runtime_stub_release_candidate_safe_report_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
