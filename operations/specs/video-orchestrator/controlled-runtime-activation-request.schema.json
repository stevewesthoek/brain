{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-request.schema.json",
  "title": "Controlled Runtime Activation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_request_id", "controlled_real_upload_enablement_preflight_result_id", "controlled_real_upload_enablement_id", "render_plan_id", "project_id", "platform", "created_at", "activation_request_state", "required_artifacts", "activation_request_scope", "requested_runtime_controls", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_request_id": { "type": "string", "minLength": 1 },
    "controlled_real_upload_enablement_preflight_result_id": { "type": "string", "minLength": 1 },
    "controlled_real_upload_enablement_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "activation_request_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_runtime_activation_safety_contract", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_real_upload_enablement_preflight_result_validated", "controlled_real_upload_enablement_validated"], "properties": { "controlled_real_upload_enablement_preflight_result_validated": { "type": "boolean", "const": true }, "controlled_real_upload_enablement_validated": { "type": "boolean", "const": true } } },
    "activation_request_scope": { "$ref": "#/$defs/scope" },
    "requested_runtime_controls": { "type": "object", "additionalProperties": false, "required": ["single_upload_limit", "operator_kill_switch_required", "dry_run_first_required", "runtime_activation_contract_required", "runtime_activation_dry_run_required", "real_upload_still_blocked"], "properties": { "single_upload_limit": { "type": "integer", "const": 1 }, "operator_kill_switch_required": { "type": "boolean", "const": true }, "dry_run_first_required": { "type": "boolean", "const": true }, "runtime_activation_contract_required": { "type": "boolean", "const": true }, "runtime_activation_dry_run_required": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "execution_boundary": { "$ref": "#/$defs/falseBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_real_upload_enablement_preflight_result_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationRequest", "revokeControlledRuntimeActivationRequest"] }, "source_controlled_real_upload_enablement_preflight_result_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  },
  "$defs": {
    "scope": { "type": "object", "additionalProperties": false, "required": ["artifact_only", "future_next_phase_requested", "real_upload_enabled_now", "upload_execution_enabled_now", "network_calls_enabled_now", "platform_api_calls_enabled_now", "credential_access_enabled_now", "media_read_enabled_now", "dependencies_requested", "package_metadata_changes_requested"], "properties": { "artifact_only": { "type": "boolean", "const": true }, "future_next_phase_requested": { "type": "boolean" }, "real_upload_enabled_now": { "type": "boolean", "const": false }, "upload_execution_enabled_now": { "type": "boolean", "const": false }, "network_calls_enabled_now": { "type": "boolean", "const": false }, "platform_api_calls_enabled_now": { "type": "boolean", "const": false }, "credential_access_enabled_now": { "type": "boolean", "const": false }, "media_read_enabled_now": { "type": "boolean", "const": false }, "dependencies_requested": { "type": "boolean", "const": false }, "package_metadata_changes_requested": { "type": "boolean", "const": false } } },
    "falseBoundary": { "type": "object", "additionalProperties": false, "required": ["ready_for_real_upload", "real_upload_enabled", "runtime_enabled", "runtime_executed", "upload_allowed", "upload_execution_enabled", "platform_api_calls_allowed", "network_calls_allowed", "credentials_accessed", "token_accessed", "keychain_accessed", "env_accessed", "media_file_read", "file_mutation_allowed", "dependencies_added", "package_metadata_changed"], "properties": { "ready_for_real_upload": { "type": "boolean", "const": false }, "real_upload_enabled": { "type": "boolean", "const": false }, "runtime_enabled": { "type": "boolean", "const": false }, "runtime_executed": { "type": "boolean", "const": false }, "upload_allowed": { "type": "boolean", "const": false }, "upload_execution_enabled": { "type": "boolean", "const": false }, "platform_api_calls_allowed": { "type": "boolean", "const": false }, "network_calls_allowed": { "type": "boolean", "const": false }, "credentials_accessed": { "type": "boolean", "const": false }, "token_accessed": { "type": "boolean", "const": false }, "keychain_accessed": { "type": "boolean", "const": false }, "env_accessed": { "type": "boolean", "const": false }, "media_file_read": { "type": "boolean", "const": false }, "file_mutation_allowed": { "type": "boolean", "const": false }, "dependencies_added": { "type": "boolean", "const": false }, "package_metadata_changed": { "type": "boolean", "const": false } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["complete", "ready_for_next_phase", "ready_for_real_upload", "real_upload_enabled", "upload_allowed", "network_calls_allowed", "platform_api_calls_allowed", "credentials_accessed", "media_file_read", "blocking_reasons", "warnings"], "properties": { "complete": { "type": "boolean" }, "ready_for_next_phase": { "type": "boolean" }, "ready_for_real_upload": { "type": "boolean", "const": false }, "real_upload_enabled": { "type": "boolean", "const": false }, "upload_allowed": { "type": "boolean", "const": false }, "network_calls_allowed": { "type": "boolean", "const": false }, "platform_api_calls_allowed": { "type": "boolean", "const": false }, "credentials_accessed": { "type": "boolean", "const": false }, "media_file_read": { "type": "boolean", "const": false }, "blocking_reasons": { "type": "array", "items": { "type": "string" } }, "warnings": { "type": "array", "items": { "type": "string" } } } }
  }
}
