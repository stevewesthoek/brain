{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-real-upload-enablement-preflight-result.schema.json",
  "title": "Controlled Real Upload Enablement Preflight Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_real_upload_enablement_preflight_result_id", "controlled_real_upload_enablement_id", "real_upload_enablement_review_gate_id", "render_plan_id", "project_id", "platform", "created_at", "preflight_state", "required_artifacts", "preflight_scope", "preflight_checks", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_real_upload_enablement_preflight_result_id": { "type": "string", "minLength": 1 },
    "controlled_real_upload_enablement_id": { "type": "string", "minLength": 1 },
    "real_upload_enablement_review_gate_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "preflight_state": { "type": "string", "enum": ["draft", "passed", "failed", "blocked", "revoked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_real_upload_enablement_validated", "real_upload_enablement_review_gate_validated"], "properties": { "controlled_real_upload_enablement_validated": { "type": "boolean", "const": true }, "real_upload_enablement_review_gate_validated": { "type": "boolean", "const": true } } },
    "preflight_scope": { "type": "object", "additionalProperties": false, "required": ["preflight_only", "future_runtime_activation_artifact_requested", "real_upload_enabled_now", "upload_execution_enabled_now", "network_calls_enabled_now", "platform_api_calls_enabled_now", "credential_access_enabled_now", "media_read_enabled_now", "dependencies_requested", "package_metadata_changes_requested"], "properties": { "preflight_only": { "type": "boolean", "const": true }, "future_runtime_activation_artifact_requested": { "type": "boolean" }, "real_upload_enabled_now": { "type": "boolean", "const": false }, "upload_execution_enabled_now": { "type": "boolean", "const": false }, "network_calls_enabled_now": { "type": "boolean", "const": false }, "platform_api_calls_enabled_now": { "type": "boolean", "const": false }, "credential_access_enabled_now": { "type": "boolean", "const": false }, "media_read_enabled_now": { "type": "boolean", "const": false }, "dependencies_requested": { "type": "boolean", "const": false }, "package_metadata_changes_requested": { "type": "boolean", "const": false } } },
    "preflight_checks": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["check_id", "check_kind", "check_state", "safe_summary", "enabled_now"], "properties": { "check_id": { "type": "string" }, "check_kind": { "type": "string" }, "check_state": { "type": "string", "enum": ["passed", "failed", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "enabled_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "real-upload-enablement-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "real-upload-enablement-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_real_upload_enablement_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRealUploadEnablementPreflightResult", "revokeControlledRealUploadEnablementPreflightResult"] }, "source_controlled_real_upload_enablement_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
