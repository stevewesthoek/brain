      "properties": {
        "real_upload_strategy_design_validated": { "const": true },
        "real_upload_execution_request_validated": { "const": true },
        "real_upload_readiness_assessment_validated": { "const": true },
        "dry_run_upload_spike_result_validated": { "const": true },
        "upload_execution_design_validated": { "const": true },
        "upload_execution_approval_validated": { "const": true },
        "platform_upload_request_validated": { "const": true },
        "upload_package_design_validated": { "const": true },
        "local_output_review_validated": { "const": true },
        "spike_result_validated": { "const": true }
      }
    },
    "execution_plan_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_upload_execution_dry_run_requested", "current_real_upload_requested", "current_network_calls_requested", "current_platform_api_calls_requested", "current_credential_access_requested", "plan_only"],
      "properties": {
        "future_upload_execution_dry_run_requested": { "type": "boolean" },
        "current_real_upload_requested": { "const": false },
        "current_network_calls_requested": { "const": false },
        "current_platform_api_calls_requested": { "const": false },
        "current_credential_access_requested": { "const": false },
        "plan_only": { "const": true }
      }
    },
    "planned_steps": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "step_kind", "step_order", "safe_summary", "execution_enabled", "upload_side_effect_allowed", "network_side_effect_allowed", "credential_access_allowed", "platform_api_call_allowed", "blocking_reasons", "warnings"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "step_kind": { "enum": ["operator_preflight_confirmation", "artifact_validation", "credential_boundary_check", "media_reference_resolution_strategy", "metadata_payload_strategy", "platform_endpoint_strategy", "network_boundary_check", "upload_attempt_strategy", "retry_idempotency_strategy", "post_upload_verification_strategy", "failure_handling_strategy", "rollback_strategy", "final_operator_go_no_go"] },
          "step_order": { "type": "integer", "minimum": 1 },
          "safe_summary": { "type": "string", "minLength": 1 },
          "execution_enabled": { "const": false },
          "upload_side_effect_allowed": { "const": false },
          "network_side_effect_allowed": { "const": false },
          "credential_access_allowed": { "const": false },
          "platform_api_call_allowed": { "const": false },
          "blocking_reasons": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "credential_plan": {
      "type": "object",
      "additionalProperties": false,
