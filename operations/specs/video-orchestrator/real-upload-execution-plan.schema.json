{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-orchestrator/real-upload-execution-plan.schema.json",
  "title": "Real Upload Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "real_upload_execution_plan_id",
    "real_upload_strategy_design_id",
    "real_upload_execution_request_id",
    "real_upload_readiness_assessment_id",
    "dry_run_upload_spike_result_id",
    "upload_execution_design_id",
    "upload_execution_approval_id",
    "platform_upload_request_id",
    "upload_package_design_id",
    "local_output_review_id",
    "production_render_spike_result_id",
    "final_render_execution_request_id",
    "render_plan_id",
    "project_id",
    "platform",
    "plan_state",
    "created_at",
    "plan_mode",
    "required_artifacts",
    "execution_plan_scope",
    "planned_steps",
    "credential_plan",
    "network_plan",
    "platform_api_plan",
    "media_access_plan",
    "retry_plan",
    "rollback_plan",
    "post_upload_verification_plan",
    "failure_handling_plan",
    "operator_runbook_plan",
    "execution_boundary",
    "validation",
    "provenance"
