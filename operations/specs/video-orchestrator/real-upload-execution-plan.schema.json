        "plan_required": { "const": true },
        "network_calls_allowed": { "const": false },
        "network_calls_made": { "const": false },
        "external_side_effects_allowed": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "platform_api_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "platform_endpoint_selected", "platform_api_payload_created", "platform_api_payload_stored", "raw_account_ids_stored", "upload_payload_created", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "platform_endpoint_selected": { "const": false },
        "platform_api_payload_created": { "const": false },
        "platform_api_payload_stored": { "const": false },
        "raw_account_ids_stored": { "const": false },
        "upload_payload_created": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "media_access_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "media_file_read", "raw_media_path_stored", "media_file_modified", "media_file_copied", "media_file_moved", "media_file_deleted", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "media_file_read": { "const": false },
        "raw_media_path_stored": { "const": false },
        "media_file_modified": { "const": false },
        "media_file_copied": { "const": false },
        "media_file_moved": { "const": false },
        "media_file_deleted": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "retry_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "max_upload_attempts", "retry_execution_enabled", "idempotency_plan_defined", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "max_upload_attempts": { "const": 0 },
        "retry_execution_enabled": { "const": false },
        "idempotency_plan_defined": { "type": "boolean" },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollback_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "rollback_execution_enabled", "destructive_action_allowed", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "rollback_execution_enabled": { "const": false },
        "destructive_action_allowed": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "post_upload_verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "verification_execution_enabled", "platform_api_calls_allowed", "network_calls_allowed", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "verification_execution_enabled": { "const": false },
        "platform_api_calls_allowed": { "const": false },
        "network_calls_allowed": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failure_handling_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_required", "failure_handling_execution_enabled", "alerting_execution_enabled", "safe_summary", "blocking_reasons", "warnings"],
      "properties": {
        "plan_required": { "const": true },
        "failure_handling_execution_enabled": { "const": false },
        "alerting_execution_enabled": { "const": false },
        "safe_summary": { "type": "string", "minLength": 1 },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operator_runbook_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook_required", "checklist_acknowledged", "understands_plan_only", "understands_no_upload_enabled", "understands_no_credentials_accessed", "understands_no_network_calls", "understands_future_dry_run_execution_phase_required", "safe_summary"],
      "properties": {
        "runbook_required": { "const": true },
        "checklist_acknowledged": { "type": "boolean" },
        "understands_plan_only": { "type": "boolean" },
        "understands_no_upload_enabled": { "type": "boolean" },
        "understands_no_credentials_accessed": { "type": "boolean" },
        "understands_no_network_calls": { "type": "boolean" },
        "understands_future_dry_run_execution_phase_required": { "type": "boolean" },
        "reviewed_by_label": { "type": "string", "minLength": 1 },
        "decision_note_summary": { "type": "string", "minLength": 1 },
        "safe_summary": { "type": "string", "minLength": 1 }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upload_allowed", "upload_execution_enabled", "real_upload_execution_allowed", "platform_api_calls_allowed", "network_calls_allowed", "credentials_accessed", "token_accessed", "keychain_accessed", "env_accessed", "ready_for_real_upload"],
      "properties": {
        "upload_allowed": { "const": false },
        "upload_execution_enabled": { "const": false },
        "real_upload_execution_allowed": { "const": false },
        "platform_api_calls_allowed": { "const": false },
        "network_calls_allowed": { "const": false },
        "credentials_accessed": { "const": false },
        "token_accessed": { "const": false },
        "keychain_accessed": { "const": false },
        "env_accessed": { "const": false },
        "ready_for_real_upload": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_for_future_upload_execution_dry_run", "ready_for_real_upload", "upload_allowed", "upload_execution_enabled", "platform_api_calls_allowed", "network_calls_allowed", "credentials_accessed", "token_accessed", "blocking_reasons", "warnings"],
      "properties": {
        "ready_for_future_upload_execution_dry_run": { "type": "boolean" },
        "ready_for_real_upload": { "const": false },
        "upload_allowed": { "const": false },
        "upload_execution_enabled": { "const": false },
        "platform_api_calls_allowed": { "const": false },
        "network_calls_allowed": { "const": false },
        "credentials_accessed": { "const": false },
        "token_accessed": { "const": false },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": { "type": "object", "additionalProperties": true }
  }
}
