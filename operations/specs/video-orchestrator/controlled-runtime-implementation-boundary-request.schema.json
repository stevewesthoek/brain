{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-implementation-boundary-request.schema.json",
  "title": "Controlled Runtime Implementation Boundary Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_implementation_boundary_request_id", "controlled_runtime_activation_boundary_completion_summary_id", "render_plan_id", "project_id", "platform", "created_at", "boundary_request_state", "required_artifacts", "boundary_scope", "implementation_controls", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_implementation_boundary_request_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_boundary_completion_summary_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "boundary_request_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_boundary_safety_contract", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_boundary_completion_summary_validated"], "properties": { "controlled_runtime_activation_boundary_completion_summary_validated": { "type": "boolean", "const": true } } },
    "boundary_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "implementation_controls": { "type": "object", "additionalProperties": false, "required": ["boundary_request_only", "safe_stub_only", "single_upload_limit", "operator_kill_switch_required", "real_upload_still_blocked"], "properties": { "boundary_request_only": { "type": "boolean", "const": true }, "safe_stub_only": { "type": "boolean", "const": true }, "single_upload_limit": { "type": "integer", "const": 1 }, "operator_kill_switch_required": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_boundary_completion_summary_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeImplementationBoundaryRequest", "revokeControlledRuntimeImplementationBoundaryRequest"] }, "source_controlled_runtime_activation_boundary_completion_summary_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
