{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-boundary-completion-summary.schema.json",
  "title": "Controlled Runtime Activation Boundary Completion Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_boundary_completion_summary_id", "controlled_runtime_activation_final_safe_report_id", "controlled_runtime_activation_go_no_go_id", "render_plan_id", "project_id", "platform", "created_at", "boundary_completion_state", "required_artifacts", "summary_scope", "completion_findings", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_boundary_completion_summary_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_final_safe_report_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_go_no_go_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "boundary_completion_state": { "type": "string", "enum": ["draft", "complete", "approved_for_future_runtime_activation_implementation_boundary", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_final_safe_report_validated", "controlled_runtime_activation_go_no_go_validated"], "properties": { "controlled_runtime_activation_final_safe_report_validated": { "type": "boolean", "const": true }, "controlled_runtime_activation_go_no_go_validated": { "type": "boolean", "const": true } } },
    "summary_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "completion_findings": { "type": "object", "additionalProperties": false, "required": ["artifact_chain_complete", "runtime_implementation_still_required", "separate_activation_commit_required", "real_upload_still_blocked"], "properties": { "artifact_chain_complete": { "type": "boolean", "const": true }, "runtime_implementation_still_required": { "type": "boolean", "const": true }, "separate_activation_commit_required": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_final_safe_report_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationBoundaryCompletionSummary", "revokeControlledRuntimeActivationBoundaryCompletionSummary"] }, "source_controlled_runtime_activation_final_safe_report_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
