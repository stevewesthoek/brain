{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-upload-enablement-review-gate.schema.json",
  "title": "Real Upload Enablement Review Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "real_upload_enablement_review_gate_id", "real_upload_enablement_safety_plan_id", "real_upload_enablement_request_id", "render_plan_id", "project_id", "platform", "created_at", "review_gate_state", "required_artifacts", "review_scope", "review_findings", "operator_acknowledgements", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "real_upload_enablement_review_gate_id": { "type": "string", "minLength": 1 },
    "real_upload_enablement_safety_plan_id": { "type": "string", "minLength": 1 },
    "real_upload_enablement_request_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "review_gate_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_controlled_enablement_artifact", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["real_upload_enablement_safety_plan_validated", "real_upload_enablement_request_validated"], "properties": { "real_upload_enablement_safety_plan_validated": { "type": "boolean", "const": true }, "real_upload_enablement_request_validated": { "type": "boolean", "const": true } } },
    "review_scope": { "type": "object", "additionalProperties": false, "required": ["review_gate_only", "future_controlled_enablement_artifact_requested", "real_upload_enabled_now", "upload_execution_enabled_now", "network_calls_enabled_now", "platform_api_calls_enabled_now", "credential_access_enabled_now", "media_read_enabled_now", "dependencies_requested", "package_metadata_changes_requested"], "properties": { "review_gate_only": { "type": "boolean", "const": true }, "future_controlled_enablement_artifact_requested": { "type": "boolean" }, "real_upload_enabled_now": { "type": "boolean", "const": false }, "upload_execution_enabled_now": { "type": "boolean", "const": false }, "network_calls_enabled_now": { "type": "boolean", "const": false }, "platform_api_calls_enabled_now": { "type": "boolean", "const": false }, "credential_access_enabled_now": { "type": "boolean", "const": false }, "media_read_enabled_now": { "type": "boolean", "const": false }, "dependencies_requested": { "type": "boolean", "const": false }, "package_metadata_changes_requested": { "type": "boolean", "const": false } } },
    "review_findings": { "type": "object", "additionalProperties": false, "required": ["safety_plan_complete", "enablement_request_complete", "kill_switch_planned", "single_upload_limit_planned", "real_upload_still_blocked", "blocking_reasons", "warnings"], "properties": { "safety_plan_complete": { "type": "boolean" }, "enablement_request_complete": { "type": "boolean" }, "kill_switch_planned": { "type": "boolean", "const": true }, "single_upload_limit_planned": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true }, "blocking_reasons": { "type": "array", "items": { "type": "string" } }, "warnings": { "type": "array", "items": { "type": "string" } } } },
    "operator_acknowledgements": { "type": "object", "additionalProperties": false, "required": ["checklist_acknowledged", "understands_review_gate_only", "understands_real_upload_not_enabled", "understands_future_controlled_enablement_artifact_required", "understands_no_credentials_accessed", "understands_no_network_calls", "understands_no_media_reads", "understands_no_platform_api_calls"], "properties": { "reviewed_by_label": { "type": "string" }, "checklist_acknowledged": { "type": "boolean" }, "understands_review_gate_only": { "type": "boolean" }, "understands_real_upload_not_enabled": { "type": "boolean" }, "understands_future_controlled_enablement_artifact_required": { "type": "boolean" }, "understands_no_credentials_accessed": { "type": "boolean" }, "understands_no_network_calls": { "type": "boolean" }, "understands_no_media_reads": { "type": "boolean" }, "understands_no_platform_api_calls": { "type": "boolean" }, "decision_note_summary": { "type": "string" } } },
    "execution_boundary": { "$ref": "real-upload-enablement-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "real-upload-enablement-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_real_upload_enablement_safety_plan_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRealUploadEnablementReviewGate", "revokeRealUploadEnablementReviewGate"] }, "source_real_upload_enablement_safety_plan_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
