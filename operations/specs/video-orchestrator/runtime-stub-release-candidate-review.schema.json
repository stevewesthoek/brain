{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-release-candidate-review.schema.json",
  "title": "Runtime Stub Release Candidate Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_release_candidate_review_id", "runtime_stub_release_candidate_id", "runtime_stub_manifest_id", "runtime_stub_store_id", "render_plan_id", "project_id", "platform", "created_at", "release_candidate_review_state", "required_artifacts", "review_scope", "review_controls", "review_entries", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_release_candidate_review_id": { "type": "string", "minLength": 1 },
    "runtime_stub_release_candidate_id": { "type": "string", "minLength": 1 },
    "runtime_stub_manifest_id": { "type": "string", "minLength": 1 },
    "runtime_stub_store_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "release_candidate_review_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_release_candidate_safe_report", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_release_candidate_validated", "runtime_stub_manifest_validated"], "properties": { "runtime_stub_release_candidate_validated": { "type": "boolean", "const": true }, "runtime_stub_manifest_validated": { "type": "boolean", "const": true } } },
    "review_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "review_controls": { "type": "object", "additionalProperties": false, "required": ["review_only", "release_candidate_reviewed", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "review_only": { "type": "boolean", "const": true }, "release_candidate_reviewed": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "review_entries": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["entry_id", "entry_kind", "review_state", "safe_summary", "runtime_callable_present", "raw_payload_present", "secret_material_present", "released_now"], "properties": { "entry_id": { "type": "string" }, "entry_kind": { "type": "string" }, "review_state": { "type": "string", "enum": ["passed", "failed", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "runtime_callable_present": { "type": "boolean", "const": false }, "raw_payload_present": { "type": "boolean", "const": false }, "secret_material_present": { "type": "boolean", "const": false }, "released_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_release_candidate_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubReleaseCandidateReview", "revokeRuntimeStubReleaseCandidateReview"] }, "source_runtime_stub_release_candidate_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
