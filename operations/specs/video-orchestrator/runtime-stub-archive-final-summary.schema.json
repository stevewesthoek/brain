  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_archive_final_summary_id": { "type": "string", "minLength": 1 },
    "runtime_stub_archive_review_id": { "type": "string", "minLength": 1 },
    "runtime_stub_archive_id": { "type": "string", "minLength": 1 },
    "runtime_stub_closeout_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "final_summary_state": { "type": "string", "enum": ["draft", "complete", "runtime_stub_sequence_complete", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_archive_review_validated", "runtime_stub_archive_validated"], "properties": { "runtime_stub_archive_review_validated": { "type": "boolean", "const": true }, "runtime_stub_archive_validated": { "type": "boolean", "const": true } } },
    "final_summary_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "final_summary_controls": { "type": "object", "additionalProperties": false, "required": ["final_summary_only", "runtime_stub_sequence_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "final_summary_only": { "type": "boolean", "const": true }, "runtime_stub_sequence_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "final_summary_sections": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["section_id", "section_kind", "safe_summary", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "ready_for_real_upload_now"], "properties": { "section_id": { "type": "string" }, "section_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_archive_review_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubArchiveFinalSummary", "revokeRuntimeStubArchiveFinalSummary"] }, "source_runtime_stub_archive_review_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
