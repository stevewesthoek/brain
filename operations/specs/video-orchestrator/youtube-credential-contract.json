{
  "schema_version": "1.0",
  "platform": "youtube",
  "phase": "3D",
  "status": "design_only",
  "real_oauth_enabled": false,
  "oauth_scaffold_phase": "3E-B",
  "auth_url_generation_enabled": true,
  "token_exchange_enabled": false,
  "keychain_write_enabled": false,
  "upload_enabled": false,
  "real_upload_enabled": false,
  "recommended_scope": "https://www.googleapis.com/auth/youtube.upload",
  "oauth": {
    "client_type": "installed_or_web_localhost",
    "redirect_uri_pattern": "http://127.0.0.1:<port>/oauth/youtube/callback",
    "redirect_path": "/oauth/youtube/callback",
    "localhost_only_redirect": true,
    "requires_state": true,
    "pkce_preferred": true,
    "pkce_method": "S256",
    "service_accounts_supported": false
  },
  "storage": {
    "recommended": "macos_keychain_reference",
    "credential_reference_format": "keychain://video-orchestrator/youtube/<account-label>",
    "db_stores": ["credential_reference", "account_id", "platform", "status"],
    "db_must_not_store": ["access_token", "refresh_token", "client_secret", "authorization_code"],
    "repo_must_not_store": ["client_secret_json", "token_json", "oauth_cache"]
  },
  "quota": {
    "videos_insert_units": 1600,
    "quota_preflight_required": true
  },
  "privacy": {
    "default": "private",
    "allowed": ["private", "unlisted", "public"],
    "unverified_project_private_only_risk": true
  },
  "approval_gate_before_phase_3e": [
    "OAuth app created outside repo",
    "YouTube Data API enabled",
    "redirect URI approved",
    "manual test account selected",
    "token storage implementation approved",
    "logging redaction verified",
    "quota behavior accepted",
    "manual fallback verified"
  ],
  "helper": {
    "script_path": "tools/scripts/video-orchestrator-credential-helper.mjs",
    "commands": [
      "validate-ref",
      "redact",
      "dry-run-keychain-read",
      "dry-run-keychain-write-placeholder",
      "generate-pkce",
      "generate-state",
      "build-youtube-auth-url",
      "validate-callback",
      "oauth-self-test",
      "self-test"
    ]
  }
}
