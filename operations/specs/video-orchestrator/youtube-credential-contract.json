{
  "schema_version": "1.0",
  "platform": "youtube",
  "phase": "3D",
  "status": "design_only",
  "real_oauth_enabled": false,
  "oauth_scaffold_phase": "3E-B",
  "token_exchange_phase": "3E-C",
  "credential_backed_preflight_phase": "3E-D",
  "first_private_upload_phase": "3E-E",
  "upload_lifecycle_phase": "3E-F",
  "auth_url_generation_enabled": true,
  "status_check_enabled": true,
  "status_check_endpoint": "videos.list",
  "status_check_parts": ["status", "processingDetails"],
  "status_check_arbitrary_video_polling_allowed": false,
  "token_exchange_enabled_by_default": false,
  "token_exchange_requires_explicit_flag": true,
  "keychain_write_requires_explicit_flag": true,
  "keychain_read_requires_explicit_flag": true,
  "keychain_delete_requires_explicit_flag": true,
  "credential_summary_read_enabled": true,
  "credential_summary_requires_explicit_keychain_read": true,
  "raw_token_output_allowed": false,
  "token_values_printed": false,
  "token_exchange_enabled": false,
  "keychain_write_enabled": false,
  "keychain_read_enabled": false,
  "keychain_delete_enabled": false,
  "upload_enabled": true,
  "real_upload_enabled": true,
  "private_upload_enabled_with_explicit_approval": true,
  "public_upload_enabled": false,
  "unlisted_upload_enabled": false,
  "bulk_upload_enabled": false,
  "thumbnail_upload_enabled": false,
  "caption_upload_enabled": false,
  "playlists_enabled": false,
  "token_values_logged": false,
  "manual_fallback_required": true,
  "refresh_flow_enabled": false,
  "youtube_api_calls_enabled": false,
  "recommended_scope": "https://www.googleapis.com/auth/youtube.upload",
  "oauth": {
    "client_type": "installed_or_web_localhost",
    "redirect_uri_pattern": "http://127.0.0.1:<port>/oauth/youtube/callback",
    "redirect_path": "/oauth/youtube/callback",
    "localhost_only_redirect": true,
    "requires_state": true,
    "pkce_preferred": true,
    "pkce_method": "S256",
    "service_accounts_supported": false
  },
  "storage": {
    "recommended": "macos_keychain_reference",
    "credential_reference_format": "keychain://video-orchestrator/youtube/<account-label>",
    "db_stores": ["credential_reference", "account_id", "platform", "status"],
    "db_must_not_store": ["access_token", "refresh_token", "client_secret", "authorization_code"],
    "repo_must_not_store": ["client_secret_json", "token_json", "oauth_cache"]
  },
  "quota": {
    "videos_insert_units": 1600,
    "quota_preflight_required": true
  },
  "privacy": {
    "default": "private",
    "allowed": ["private", "unlisted", "public"],
    "unverified_project_private_only_risk": true
  },
  "approval_gate_before_phase_3e": [
    "OAuth app created outside repo",
    "YouTube Data API enabled",
    "redirect URI approved",
    "manual test account selected",
    "token storage implementation approved",
    "logging redaction verified",
    "quota behavior accepted",
    "manual fallback verified"
  ],
  "helper": {
    "script_path": "tools/scripts/video-orchestrator-credential-helper.mjs",
    "commands": [
      "validate-ref",
      "redact",
      "dry-run-keychain-read",
      "dry-run-keychain-write-placeholder",
      "generate-pkce",
      "generate-state",
      "build-youtube-auth-url",
      "validate-callback",
      "keychain-summary-youtube-token",
      "oauth-self-test",
      "self-test"
    ]
  }
}
