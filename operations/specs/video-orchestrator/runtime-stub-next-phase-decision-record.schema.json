{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-next-phase-decision-record.schema.json",
  "title": "Runtime Stub Next Phase Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_next_phase_decision_record_id", "runtime_stub_operator_handoff_checklist_id", "runtime_stub_sequence_index_id", "render_plan_id", "project_id", "platform", "created_at", "decision_state", "required_artifacts", "decision_scope", "decision_controls", "decision_options", "selected_decision", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_next_phase_decision_record_id": { "type": "string", "minLength": 1 },
    "runtime_stub_operator_handoff_checklist_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_index_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "decision_state": { "type": "string", "enum": ["draft", "recorded", "deferred", "approved_for_future_explicit_runtime_activation_design", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_operator_handoff_checklist_validated", "runtime_stub_sequence_index_validated"], "properties": { "runtime_stub_operator_handoff_checklist_validated": { "type": "boolean", "const": true }, "runtime_stub_sequence_index_validated": { "type": "boolean", "const": true } } },
    "decision_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "decision_controls": { "type": "object", "additionalProperties": false, "required": ["decision_record_only", "future_phase_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "decision_record_only": { "type": "boolean", "const": true }, "future_phase_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "decision_options": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["option_id", "option_kind", "safe_summary", "would_enable_runtime_now", "would_enable_real_upload_now"], "properties": { "option_id": { "type": "string" }, "option_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "would_enable_runtime_now": { "type": "boolean", "const": false }, "would_enable_real_upload_now": { "type": "boolean", "const": false } } } },
    "selected_decision": { "type": "object", "additionalProperties": false, "required": ["decision_id", "decision_kind", "safe_summary", "runtime_enabled_now", "ready_for_real_upload_now"], "properties": { "decision_id": { "type": "string" }, "decision_kind": { "type": "string", "enum": ["defer", "document_future_activation_design", "stop_runtime_stub_track", "blocked"] }, "safe_summary": { "type": "string" }, "runtime_enabled_now": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_operator_handoff_checklist_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubNextPhaseDecisionRecord", "revokeRuntimeStubNextPhaseDecisionRecord"] }, "source_runtime_stub_operator_handoff_checklist_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
