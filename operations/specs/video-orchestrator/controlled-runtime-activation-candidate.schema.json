{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-candidate.schema.json",
  "title": "Controlled Runtime Activation Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_candidate_id", "controlled_runtime_activation_implementation_dry_run_review_id", "controlled_runtime_activation_implementation_contract_id", "render_plan_id", "project_id", "platform", "created_at", "activation_candidate_state", "required_artifacts", "candidate_scope", "candidate_controls", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_candidate_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_implementation_dry_run_review_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_implementation_contract_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "activation_candidate_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_final_review", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_implementation_dry_run_review_validated", "controlled_runtime_activation_implementation_contract_validated"], "properties": { "controlled_runtime_activation_implementation_dry_run_review_validated": { "type": "boolean", "const": true }, "controlled_runtime_activation_implementation_contract_validated": { "type": "boolean", "const": true } } },
    "candidate_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "candidate_controls": { "type": "object", "additionalProperties": false, "required": ["single_upload_limit", "operator_kill_switch_required", "rollback_plan_required", "final_review_required", "runtime_activation_separate_commit_required", "real_upload_still_blocked"], "properties": { "single_upload_limit": { "type": "integer", "const": 1 }, "operator_kill_switch_required": { "type": "boolean", "const": true }, "rollback_plan_required": { "type": "boolean", "const": true }, "final_review_required": { "type": "boolean", "const": true }, "runtime_activation_separate_commit_required": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_implementation_dry_run_review_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationCandidate", "revokeControlledRuntimeActivationCandidate"] }, "source_controlled_runtime_activation_implementation_dry_run_review_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
