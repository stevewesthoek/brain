{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-upload-executor-contracts.schema.json",
  "title": "Real Upload Executor Contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "real_upload_executor_contracts_id", "real_upload_executor_adapter_design_id", "real_upload_readiness_gate_v2_id", "render_plan_id", "project_id", "platform", "created_at", "executor_contracts_state", "executor_contracts_mode", "required_artifacts", "contracts_scope", "executor_contracts", "operator_review", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "real_upload_executor_contracts_id": { "type": "string", "minLength": 1 },
    "real_upload_executor_adapter_design_id": { "type": "string", "minLength": 1 },
    "real_upload_readiness_gate_v2_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "executor_contracts_state": { "type": "string", "enum": ["draft", "blocked", "ready_for_operator_review", "approved_for_future_executor_contract_tests", "rejected", "revoked"] },
    "executor_contracts_mode": { "type": "string", "enum": ["real_upload_executor_contracts_only", "operator_review_real_upload_executor_contracts"] },
    "required_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_upload_executor_adapter_design_validated", "real_upload_readiness_gate_v2_validated"],
      "properties": {
        "real_upload_executor_adapter_design_validated": { "type": "boolean", "const": true },
        "real_upload_readiness_gate_v2_validated": { "type": "boolean", "const": true }
      }
    },
    "contracts_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_executor_contract_tests_requested", "executor_contracts_only", "adapter_code_created", "runtime_enabled", "upload_execution_enabled_now", "network_calls_enabled_now", "platform_api_calls_enabled_now", "credential_access_enabled_now", "media_read_enabled_now", "dependencies_requested", "package_metadata_changes_requested"],
      "properties": {
        "future_executor_contract_tests_requested": { "type": "boolean" },
        "executor_contracts_only": { "type": "boolean", "const": true },
        "adapter_code_created": { "type": "boolean", "const": false },
        "runtime_enabled": { "type": "boolean", "const": false },
        "upload_execution_enabled_now": { "type": "boolean", "const": false },
        "network_calls_enabled_now": { "type": "boolean", "const": false },
        "platform_api_calls_enabled_now": { "type": "boolean", "const": false },
        "credential_access_enabled_now": { "type": "boolean", "const": false },
        "media_read_enabled_now": { "type": "boolean", "const": false },
        "dependencies_requested": { "type": "boolean", "const": false },
        "package_metadata_changes_requested": { "type": "boolean", "const": false }
      }
    },
    "executor_contracts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "contract_kind", "safe_summary", "contract_defined", "code_created", "runtime_enabled", "upload_enabled", "network_enabled", "platform_api_enabled", "credential_access_enabled", "media_read_enabled", "raw_payload_allowed", "raw_response_allowed", "blocking_reasons", "warnings"],
        "properties": {
          "contract_id": { "type": "string" },
          "contract_kind": { "type": "string", "enum": ["credential_boundary_contract", "media_read_boundary_contract", "payload_builder_contract", "platform_client_contract", "network_boundary_contract", "response_redaction_contract", "executor_orchestration_contract"] },
          "safe_summary": { "type": "string" },
          "contract_defined": { "type": "boolean" },
          "code_created": { "type": "boolean", "const": false },
          "runtime_enabled": { "type": "boolean", "const": false },
          "upload_enabled": { "type": "boolean", "const": false },
          "network_enabled": { "type": "boolean", "const": false },
          "platform_api_enabled": { "type": "boolean", "const": false },
          "credential_access_enabled": { "type": "boolean", "const": false },
          "media_read_enabled": { "type": "boolean", "const": false },
          "raw_payload_allowed": { "type": "boolean", "const": false },
          "raw_response_allowed": { "type": "boolean", "const": false },
          "blocking_reasons": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "operator_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checklist_acknowledged", "understands_contracts_only", "understands_no_adapter_code_created", "understands_real_upload_not_enabled", "understands_no_network_calls", "understands_no_platform_api_calls", "understands_no_credentials_accessed", "understands_no_media_reads", "understands_future_executor_contract_tests_required"],
      "properties": {
        "reviewed_by_label": { "type": "string" },
        "checklist_acknowledged": { "type": "boolean" },
        "understands_contracts_only": { "type": "boolean" },
        "understands_no_adapter_code_created": { "type": "boolean" },
        "understands_real_upload_not_enabled": { "type": "boolean" },
        "understands_no_network_calls": { "type": "boolean" },
        "understands_no_platform_api_calls": { "type": "boolean" },
        "understands_no_credentials_accessed": { "type": "boolean" },
        "understands_no_media_reads": { "type": "boolean" },
        "understands_future_executor_contract_tests_required": { "type": "boolean" },
        "decision_note_summary": { "type": "string" }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_for_real_upload", "real_upload_enabled", "adapter_code_created", "runtime_enabled", "runtime_executed", "upload_allowed", "upload_execution_enabled", "platform_api_calls_allowed", "network_calls_allowed", "credentials_accessed", "token_accessed", "keychain_accessed", "env_accessed", "media_file_read", "file_mutation_allowed", "dependencies_added", "package_metadata_changed"],
      "properties": {
        "ready_for_real_upload": { "type": "boolean", "const": false },
        "real_upload_enabled": { "type": "boolean", "const": false },
        "adapter_code_created": { "type": "boolean", "const": false },
        "runtime_enabled": { "type": "boolean", "const": false },
        "runtime_executed": { "type": "boolean", "const": false },
        "upload_allowed": { "type": "boolean", "const": false },
        "upload_execution_enabled": { "type": "boolean", "const": false },
        "platform_api_calls_allowed": { "type": "boolean", "const": false },
        "network_calls_allowed": { "type": "boolean", "const": false },
        "credentials_accessed": { "type": "boolean", "const": false },
        "token_accessed": { "type": "boolean", "const": false },
        "keychain_accessed": { "type": "boolean", "const": false },
        "env_accessed": { "type": "boolean", "const": false },
        "media_file_read": { "type": "boolean", "const": false },
        "file_mutation_allowed": { "type": "boolean", "const": false },
        "dependencies_added": { "type": "boolean", "const": false },
        "package_metadata_changed": { "type": "boolean", "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_contracts_complete", "ready_for_future_executor_contract_tests", "ready_for_real_upload", "real_upload_enabled", "adapter_code_created", "upload_allowed", "network_calls_allowed", "platform_api_calls_allowed", "credentials_accessed", "media_file_read", "blocking_reasons", "warnings"],
      "properties": {
        "executor_contracts_complete": { "type": "boolean" },
        "ready_for_future_executor_contract_tests": { "type": "boolean" },
        "ready_for_real_upload": { "type": "boolean", "const": false },
        "real_upload_enabled": { "type": "boolean", "const": false },
        "adapter_code_created": { "type": "boolean", "const": false },
        "upload_allowed": { "type": "boolean", "const": false },
        "network_calls_allowed": { "type": "boolean", "const": false },
        "platform_api_calls_allowed": { "type": "boolean", "const": false },
        "credentials_accessed": { "type": "boolean", "const": false },
        "media_file_read": { "type": "boolean", "const": false },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "source_real_upload_executor_adapter_design_id", "source_real_upload_readiness_gate_v2_id", "source_render_plan_id"],
      "properties": {
        "generated_by": { "type": "string", "enum": ["createRealUploadExecutorContracts", "revokeRealUploadExecutorContracts"] },
        "source_real_upload_executor_adapter_design_id": { "type": "string" },
        "source_real_upload_readiness_gate_v2_id": { "type": "string" },
        "source_render_plan_id": { "type": "string" }
      }
    }
  }
}
