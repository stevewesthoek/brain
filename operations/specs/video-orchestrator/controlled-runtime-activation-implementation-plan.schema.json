{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-implementation-plan.schema.json",
  "title": "Controlled Runtime Activation Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_implementation_plan_id", "controlled_runtime_activation_dry_run_result_id", "controlled_runtime_activation_safety_contract_id", "render_plan_id", "project_id", "platform", "created_at", "implementation_plan_state", "required_artifacts", "implementation_scope", "planned_changes", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_implementation_plan_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_dry_run_result_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_safety_contract_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "implementation_plan_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_implementation_contract", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_dry_run_result_validated", "controlled_runtime_activation_safety_contract_validated"], "properties": { "controlled_runtime_activation_dry_run_result_validated": { "type": "boolean", "const": true }, "controlled_runtime_activation_safety_contract_validated": { "type": "boolean", "const": true } } },
    "implementation_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "planned_changes": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["change_id", "change_kind", "safe_summary", "implemented_now"], "properties": { "change_id": { "type": "string" }, "change_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "implemented_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_dry_run_result_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationImplementationPlan", "revokeControlledRuntimeActivationImplementationPlan"] }, "source_controlled_runtime_activation_dry_run_result_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
