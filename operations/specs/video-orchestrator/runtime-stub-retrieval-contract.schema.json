{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-retrieval-contract.schema.json",
  "title": "Runtime Stub Retrieval Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_retrieval_contract_id", "runtime_stub_store_id", "noop_runtime_stub_id", "render_plan_id", "project_id", "platform", "created_at", "retrieval_contract_state", "required_artifacts", "retrieval_scope", "retrieval_controls", "retrieval_checks", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_retrieval_contract_id": { "type": "string", "minLength": 1 },
    "runtime_stub_store_id": { "type": "string", "minLength": 1 },
    "noop_runtime_stub_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "retrieval_contract_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_store_retrieval_safe_report", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_store_validated", "noop_runtime_stub_validated"], "properties": { "runtime_stub_store_validated": { "type": "boolean", "const": true }, "noop_runtime_stub_validated": { "type": "boolean", "const": true } } },
    "retrieval_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "retrieval_controls": { "type": "object", "additionalProperties": false, "required": ["retrieval_contract_only", "retrieves_summary_only", "runtime_callable_retrieved", "raw_payload_retrieved", "raw_response_retrieved", "secret_material_retrieved", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "retrieval_contract_only": { "type": "boolean", "const": true }, "retrieves_summary_only": { "type": "boolean", "const": true }, "runtime_callable_retrieved": { "type": "boolean", "const": false }, "raw_payload_retrieved": { "type": "boolean", "const": false }, "raw_response_retrieved": { "type": "boolean", "const": false }, "secret_material_retrieved": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "retrieval_checks": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["check_id", "check_kind", "safe_summary", "retrieved_now", "runtime_executed_now"], "properties": { "check_id": { "type": "string" }, "check_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "retrieved_now": { "type": "boolean", "const": false }, "runtime_executed_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_store_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubRetrievalContract", "revokeRuntimeStubRetrievalContract"] }, "source_runtime_stub_store_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
