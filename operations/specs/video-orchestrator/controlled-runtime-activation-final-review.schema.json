{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-final-review.schema.json",
  "title": "Controlled Runtime Activation Final Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_final_review_id", "controlled_runtime_activation_candidate_id", "render_plan_id", "project_id", "platform", "created_at", "final_review_state", "required_artifacts", "final_review_scope", "final_review_controls", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_final_review_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_candidate_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "final_review_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_rollback_plan", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_candidate_validated"], "properties": { "controlled_runtime_activation_candidate_validated": { "type": "boolean", "const": true } } },
    "final_review_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "final_review_controls": { "type": "object", "additionalProperties": false, "required": ["candidate_reviewed", "rollback_plan_required", "operator_kill_switch_required", "single_upload_limit", "real_upload_still_blocked"], "properties": { "candidate_reviewed": { "type": "boolean", "const": true }, "rollback_plan_required": { "type": "boolean", "const": true }, "operator_kill_switch_required": { "type": "boolean", "const": true }, "single_upload_limit": { "type": "integer", "const": 1 }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_candidate_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationFinalReview", "revokeControlledRuntimeActivationFinalReview"] }, "source_controlled_runtime_activation_candidate_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
