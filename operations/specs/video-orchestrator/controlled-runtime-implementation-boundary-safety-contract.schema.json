{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-implementation-boundary-safety-contract.schema.json",
  "title": "Controlled Runtime Implementation Boundary Safety Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_implementation_boundary_safety_contract_id", "controlled_runtime_implementation_boundary_request_id", "render_plan_id", "project_id", "platform", "created_at", "safety_contract_state", "required_artifacts", "contract_scope", "safety_controls", "implementation_contracts", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_implementation_boundary_safety_contract_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_implementation_boundary_request_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "safety_contract_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_boundary_dry_run", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_implementation_boundary_request_validated"], "properties": { "controlled_runtime_implementation_boundary_request_validated": { "type": "boolean", "const": true } } },
    "contract_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "safety_controls": { "type": "object", "additionalProperties": false, "required": ["safe_stub_only", "single_upload_limit", "operator_kill_switch_required", "raw_payload_storage_allowed", "raw_response_storage_allowed", "real_upload_still_blocked"], "properties": { "safe_stub_only": { "type": "boolean", "const": true }, "single_upload_limit": { "type": "integer", "const": 1 }, "operator_kill_switch_required": { "type": "boolean", "const": true }, "raw_payload_storage_allowed": { "type": "boolean", "const": false }, "raw_response_storage_allowed": { "type": "boolean", "const": false }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "implementation_contracts": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["contract_id", "contract_kind", "safe_summary", "implemented_now"], "properties": { "contract_id": { "type": "string" }, "contract_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "implemented_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_implementation_boundary_request_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeImplementationBoundarySafetyContract", "revokeControlledRuntimeImplementationBoundarySafetyContract"] }, "source_controlled_runtime_implementation_boundary_request_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
