{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-store.schema.json",
  "title": "Runtime Stub Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_store_id", "noop_runtime_stub_safe_report_id", "noop_runtime_stub_id", "render_plan_id", "project_id", "platform", "created_at", "store_state", "required_artifacts", "store_scope", "store_controls", "stored_stub_summary", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_store_id": { "type": "string", "minLength": 1 },
    "noop_runtime_stub_safe_report_id": { "type": "string", "minLength": 1 },
    "noop_runtime_stub_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "store_state": { "type": "string", "enum": ["draft", "stored", "ready_for_operator_review", "approved_for_future_retrieval_contract", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["noop_runtime_stub_safe_report_validated", "noop_runtime_stub_validated"], "properties": { "noop_runtime_stub_safe_report_validated": { "type": "boolean", "const": true }, "noop_runtime_stub_validated": { "type": "boolean", "const": true } } },
    "store_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "store_controls": { "type": "object", "additionalProperties": false, "required": ["store_artifact_only", "stores_stub_summary_only", "stores_runtime_callable", "stores_raw_payload", "stores_raw_response", "stores_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "store_artifact_only": { "type": "boolean", "const": true }, "stores_stub_summary_only": { "type": "boolean", "const": true }, "stores_runtime_callable": { "type": "boolean", "const": false }, "stores_raw_payload": { "type": "boolean", "const": false }, "stores_raw_response": { "type": "boolean", "const": false }, "stores_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "stored_stub_summary": { "type": "object", "additionalProperties": false, "required": ["summary_only", "noop_runtime_stub_id", "runtime_callable_stored", "raw_payload_stored", "raw_response_stored", "secret_material_stored"], "properties": { "summary_only": { "type": "boolean", "const": true }, "noop_runtime_stub_id": { "type": "string" }, "runtime_callable_stored": { "type": "boolean", "const": false }, "raw_payload_stored": { "type": "boolean", "const": false }, "raw_response_stored": { "type": "boolean", "const": false }, "secret_material_stored": { "type": "boolean", "const": false } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_noop_runtime_stub_safe_report_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubStore", "revokeRuntimeStubStore"] }, "source_noop_runtime_stub_safe_report_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
