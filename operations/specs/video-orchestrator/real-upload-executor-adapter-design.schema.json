{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "real-upload-executor-adapter-design.schema.json",
  "title": "Real Upload Executor Adapter Design",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "real_upload_executor_adapter_design_id", "real_upload_readiness_gate_v2_id", "real_upload_noop_wiring_smoke_test_result_id", "render_plan_id", "project_id", "platform", "created_at", "executor_adapter_design_state", "executor_adapter_design_mode", "required_artifacts", "design_scope", "adapter_boundaries", "planned_adapter_modules", "operator_review", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "real_upload_executor_adapter_design_id": { "type": "string", "minLength": 1 },
    "real_upload_readiness_gate_v2_id": { "type": "string", "minLength": 1 },
    "real_upload_noop_wiring_smoke_test_result_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "executor_adapter_design_state": { "type": "string", "enum": ["draft", "blocked", "ready_for_operator_review", "approved_for_future_executor_contracts", "rejected", "revoked"] },
    "executor_adapter_design_mode": { "type": "string", "enum": ["real_upload_executor_adapter_design_only", "operator_review_real_upload_executor_adapter_design"] },
    "required_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_upload_readiness_gate_v2_validated", "real_upload_noop_wiring_smoke_test_result_validated"],
      "properties": {
        "real_upload_readiness_gate_v2_validated": { "type": "boolean", "const": true },
        "real_upload_noop_wiring_smoke_test_result_validated": { "type": "boolean", "const": true }
      }
    },
    "design_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_executor_contracts_requested", "executor_adapter_design_only", "adapter_code_created", "runtime_adapter_enabled", "upload_execution_enabled_now", "network_calls_enabled_now", "platform_api_calls_enabled_now", "credential_access_enabled_now", "media_read_enabled_now", "dependencies_requested", "package_metadata_changes_requested"],
      "properties": {
        "future_executor_contracts_requested": { "type": "boolean" },
        "executor_adapter_design_only": { "type": "boolean", "const": true },
        "adapter_code_created": { "type": "boolean", "const": false },
        "runtime_adapter_enabled": { "type": "boolean", "const": false },
        "upload_execution_enabled_now": { "type": "boolean", "const": false },
        "network_calls_enabled_now": { "type": "boolean", "const": false },
        "platform_api_calls_enabled_now": { "type": "boolean", "const": false },
        "credential_access_enabled_now": { "type": "boolean", "const": false },
        "media_read_enabled_now": { "type": "boolean", "const": false },
        "dependencies_requested": { "type": "boolean", "const": false },
        "package_metadata_changes_requested": { "type": "boolean", "const": false }
      }
    },
    "adapter_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_boundary_required", "network_boundary_required", "platform_api_boundary_required", "media_read_boundary_required", "payload_contract_required", "response_redaction_required", "dry_run_first_required", "real_upload_still_blocked"],
      "properties": {
        "credential_boundary_required": { "type": "boolean", "const": true },
        "network_boundary_required": { "type": "boolean", "const": true },
        "platform_api_boundary_required": { "type": "boolean", "const": true },
        "media_read_boundary_required": { "type": "boolean", "const": true },
        "payload_contract_required": { "type": "boolean", "const": true },
        "response_redaction_required": { "type": "boolean", "const": true },
        "dry_run_first_required": { "type": "boolean", "const": true },
        "real_upload_still_blocked": { "type": "boolean", "const": true }
      }
    },
    "planned_adapter_modules": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_id", "module_kind", "safe_summary", "code_created", "runtime_enabled", "upload_enabled", "network_enabled", "platform_api_enabled", "credential_access_enabled", "media_read_enabled", "blocking_reasons", "warnings"],
        "properties": {
          "module_id": { "type": "string" },
          "module_kind": { "type": "string", "enum": ["credential_boundary_adapter_design", "media_read_boundary_adapter_design", "payload_builder_adapter_design", "platform_client_adapter_design", "network_boundary_adapter_design", "response_redaction_adapter_design", "executor_orchestration_adapter_design"] },
          "safe_summary": { "type": "string" },
          "code_created": { "type": "boolean", "const": false },
          "runtime_enabled": { "type": "boolean", "const": false },
          "upload_enabled": { "type": "boolean", "const": false },
          "network_enabled": { "type": "boolean", "const": false },
          "platform_api_enabled": { "type": "boolean", "const": false },
          "credential_access_enabled": { "type": "boolean", "const": false },
          "media_read_enabled": { "type": "boolean", "const": false },
          "blocking_reasons": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "operator_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checklist_acknowledged", "understands_design_only", "understands_no_adapter_code_created", "understands_real_upload_not_enabled", "understands_no_network_calls", "understands_no_platform_api_calls", "understands_no_credentials_accessed", "understands_no_media_reads", "understands_future_executor_contracts_required"],
      "properties": {
        "reviewed_by_label": { "type": "string" },
        "checklist_acknowledged": { "type": "boolean" },
        "understands_design_only": { "type": "boolean" },
        "understands_no_adapter_code_created": { "type": "boolean" },
        "understands_real_upload_not_enabled": { "type": "boolean" },
        "understands_no_network_calls": { "type": "boolean" },
        "understands_no_platform_api_calls": { "type": "boolean" },
        "understands_no_credentials_accessed": { "type": "boolean" },
        "understands_no_media_reads": { "type": "boolean" },
        "understands_future_executor_contracts_required": { "type": "boolean" },
        "decision_note_summary": { "type": "string" }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_for_real_upload", "real_upload_enabled", "adapter_code_created", "runtime_enabled", "runtime_executed", "upload_allowed", "upload_execution_enabled", "platform_api_calls_allowed", "network_calls_allowed", "credentials_accessed", "token_accessed", "keychain_accessed", "env_accessed", "media_file_read", "file_mutation_allowed", "dependencies_added", "package_metadata_changed"],
      "properties": {
        "ready_for_real_upload": { "type": "boolean", "const": false },
        "real_upload_enabled": { "type": "boolean", "const": false },
        "adapter_code_created": { "type": "boolean", "const": false },
        "runtime_enabled": { "type": "boolean", "const": false },
        "runtime_executed": { "type": "boolean", "const": false },
        "upload_allowed": { "type": "boolean", "const": false },
        "upload_execution_enabled": { "type": "boolean", "const": false },
        "platform_api_calls_allowed": { "type": "boolean", "const": false },
        "network_calls_allowed": { "type": "boolean", "const": false },
        "credentials_accessed": { "type": "boolean", "const": false },
        "token_accessed": { "type": "boolean", "const": false },
        "keychain_accessed": { "type": "boolean", "const": false },
        "env_accessed": { "type": "boolean", "const": false },
        "media_file_read": { "type": "boolean", "const": false },
        "file_mutation_allowed": { "type": "boolean", "const": false },
        "dependencies_added": { "type": "boolean", "const": false },
        "package_metadata_changed": { "type": "boolean", "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_adapter_design_complete", "ready_for_future_executor_contracts", "ready_for_real_upload", "real_upload_enabled", "adapter_code_created", "upload_allowed", "network_calls_allowed", "platform_api_calls_allowed", "credentials_accessed", "media_file_read", "blocking_reasons", "warnings"],
      "properties": {
        "executor_adapter_design_complete": { "type": "boolean" },
        "ready_for_future_executor_contracts": { "type": "boolean" },
        "ready_for_real_upload": { "type": "boolean", "const": false },
        "real_upload_enabled": { "type": "boolean", "const": false },
        "adapter_code_created": { "type": "boolean", "const": false },
        "upload_allowed": { "type": "boolean", "const": false },
        "network_calls_allowed": { "type": "boolean", "const": false },
        "platform_api_calls_allowed": { "type": "boolean", "const": false },
        "credentials_accessed": { "type": "boolean", "const": false },
        "media_file_read": { "type": "boolean", "const": false },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "source_real_upload_readiness_gate_v2_id", "source_real_upload_noop_wiring_smoke_test_result_id", "source_render_plan_id"],
      "properties": {
        "generated_by": { "type": "string", "enum": ["createRealUploadExecutorAdapterDesign", "revokeRealUploadExecutorAdapterDesign"] },
        "source_real_upload_readiness_gate_v2_id": { "type": "string" },
        "source_real_upload_noop_wiring_smoke_test_result_id": { "type": "string" },
        "source_render_plan_id": { "type": "string" }
      }
    }
  }
}
