{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noop-runtime-stub-review.schema.json",
  "title": "No-Op Runtime Stub Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "noop_runtime_stub_review_id", "noop_runtime_stub_id", "render_plan_id", "project_id", "platform", "created_at", "stub_review_state", "required_artifacts", "review_scope", "review_controls", "review_items", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "noop_runtime_stub_review_id": { "type": "string", "minLength": 1 },
    "noop_runtime_stub_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "stub_review_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_noop_runtime_stub_safe_report", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["noop_runtime_stub_validated"], "properties": { "noop_runtime_stub_validated": { "type": "boolean", "const": true } } },
    "review_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "review_controls": { "type": "object", "additionalProperties": false, "required": ["review_only", "noop_stub_reviewed", "runtime_invocation_disabled", "network_client_absent", "platform_adapter_absent", "credential_provider_absent", "media_resolver_absent", "real_upload_still_blocked"], "properties": { "review_only": { "type": "boolean", "const": true }, "noop_stub_reviewed": { "type": "boolean", "const": true }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "network_client_absent": { "type": "boolean", "const": true }, "platform_adapter_absent": { "type": "boolean", "const": true }, "credential_provider_absent": { "type": "boolean", "const": true }, "media_resolver_absent": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "review_items": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["item_id", "item_kind", "review_state", "safe_summary", "implemented_now", "runtime_executed_now"], "properties": { "item_id": { "type": "string" }, "item_kind": { "type": "string" }, "review_state": { "type": "string", "enum": ["passed", "failed", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "implemented_now": { "type": "boolean", "const": false }, "runtime_executed_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_noop_runtime_stub_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createNoopRuntimeStubReview", "revokeNoopRuntimeStubReview"] }, "source_noop_runtime_stub_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
