{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-operator-handoff-checklist.schema.json",
  "title": "Runtime Stub Operator Handoff Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_operator_handoff_checklist_id", "runtime_stub_sequence_index_id", "runtime_stub_sequence_final_handoff_id", "render_plan_id", "project_id", "platform", "created_at", "checklist_state", "required_artifacts", "checklist_scope", "checklist_controls", "checklist_items", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_operator_handoff_checklist_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_index_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_final_handoff_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "checklist_state": { "type": "string", "enum": ["draft", "ready_for_operator_review", "approved_for_future_next_phase_decision_record", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_sequence_index_validated", "runtime_stub_sequence_final_handoff_validated"], "properties": { "runtime_stub_sequence_index_validated": { "type": "boolean", "const": true }, "runtime_stub_sequence_final_handoff_validated": { "type": "boolean", "const": true } } },
    "checklist_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "checklist_controls": { "type": "object", "additionalProperties": false, "required": ["checklist_only", "operator_handoff_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "checklist_only": { "type": "boolean", "const": true }, "operator_handoff_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "checklist_items": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["item_id", "item_kind", "item_state", "safe_summary", "operator_action_required_now", "runtime_executed_now", "ready_for_real_upload_now"], "properties": { "item_id": { "type": "string" }, "item_kind": { "type": "string" }, "item_state": { "type": "string", "enum": ["checked", "unchecked", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "operator_action_required_now": { "type": "boolean", "const": false }, "runtime_executed_now": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_sequence_index_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubOperatorHandoffChecklist", "revokeRuntimeStubOperatorHandoffChecklist"] }, "source_runtime_stub_sequence_index_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
