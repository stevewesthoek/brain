{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-stub-sequence-regression-report.schema.json",
  "title": "Runtime Stub Sequence Regression Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_stub_sequence_regression_report_id", "runtime_stub_sequence_integrity_audit_id", "runtime_stub_archive_final_summary_id", "runtime_stub_archive_id", "render_plan_id", "project_id", "platform", "created_at", "regression_report_state", "required_artifacts", "regression_scope", "regression_controls", "regression_checks", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "runtime_stub_sequence_regression_report_id": { "type": "string", "minLength": 1 },
    "runtime_stub_sequence_integrity_audit_id": { "type": "string", "minLength": 1 },
    "runtime_stub_archive_final_summary_id": { "type": "string", "minLength": 1 },
    "runtime_stub_archive_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "regression_report_state": { "type": "string", "enum": ["draft", "passed", "failed", "blocked", "approved_for_future_sequence_final_handoff", "revoked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["runtime_stub_sequence_integrity_audit_validated", "runtime_stub_archive_final_summary_validated"], "properties": { "runtime_stub_sequence_integrity_audit_validated": { "type": "boolean", "const": true }, "runtime_stub_archive_final_summary_validated": { "type": "boolean", "const": true } } },
    "regression_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "regression_controls": { "type": "object", "additionalProperties": false, "required": ["regression_report_only", "sequence_regression_only", "contains_runtime_callable", "contains_raw_payload", "contains_raw_response", "contains_secret_material", "runtime_invocation_disabled", "real_upload_still_blocked"], "properties": { "regression_report_only": { "type": "boolean", "const": true }, "sequence_regression_only": { "type": "boolean", "const": true }, "contains_runtime_callable": { "type": "boolean", "const": false }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false }, "runtime_invocation_disabled": { "type": "boolean", "const": true }, "real_upload_still_blocked": { "type": "boolean", "const": true } } },
    "regression_checks": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["check_id", "check_kind", "check_state", "safe_summary", "runtime_executed_now", "ready_for_real_upload_now"], "properties": { "check_id": { "type": "string" }, "check_kind": { "type": "string" }, "check_state": { "type": "string", "enum": ["passed", "failed", "blocked", "deferred"] }, "safe_summary": { "type": "string" }, "runtime_executed_now": { "type": "boolean", "const": false }, "ready_for_real_upload_now": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_runtime_stub_sequence_integrity_audit_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createRuntimeStubSequenceRegressionReport", "revokeRuntimeStubSequenceRegressionReport"] }, "source_runtime_stub_sequence_integrity_audit_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
