{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-runtime-activation-final-safe-report.schema.json",
  "title": "Controlled Runtime Activation Final Safe Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controlled_runtime_activation_final_safe_report_id", "controlled_runtime_activation_go_no_go_id", "render_plan_id", "project_id", "platform", "created_at", "final_safe_report_state", "required_artifacts", "report_scope", "safe_report_sections", "execution_boundary", "validation", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "controlled_runtime_activation_final_safe_report_id": { "type": "string", "minLength": 1 },
    "controlled_runtime_activation_go_no_go_id": { "type": "string", "minLength": 1 },
    "render_plan_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "final_safe_report_state": { "type": "string", "enum": ["draft", "complete", "approved_for_boundary_completion_summary", "rejected", "revoked", "blocked"] },
    "required_artifacts": { "type": "object", "additionalProperties": false, "required": ["controlled_runtime_activation_go_no_go_validated"], "properties": { "controlled_runtime_activation_go_no_go_validated": { "type": "boolean", "const": true } } },
    "report_scope": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/scope" },
    "safe_report_sections": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["section_id", "section_kind", "safe_summary", "contains_raw_payload", "contains_raw_response", "contains_secret_material"], "properties": { "section_id": { "type": "string" }, "section_kind": { "type": "string" }, "safe_summary": { "type": "string" }, "contains_raw_payload": { "type": "boolean", "const": false }, "contains_raw_response": { "type": "boolean", "const": false }, "contains_secret_material": { "type": "boolean", "const": false } } } },
    "execution_boundary": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/falseBoundary" },
    "validation": { "$ref": "controlled-runtime-activation-request.schema.json#/$defs/validation" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["generated_by", "source_controlled_runtime_activation_go_no_go_id", "source_render_plan_id"], "properties": { "generated_by": { "type": "string", "enum": ["createControlledRuntimeActivationFinalSafeReport", "revokeControlledRuntimeActivationFinalSafeReport"] }, "source_controlled_runtime_activation_go_no_go_id": { "type": "string" }, "source_render_plan_id": { "type": "string" } } }
  }
}
