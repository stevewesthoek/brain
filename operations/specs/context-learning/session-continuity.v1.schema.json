{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/specs/context-learning/session-continuity.v1.schema.json",
  "title": "Infinite Brain Session Continuity Contract v1",
  "description": "Provider- and model-agnostic references and state for bounded cross-environment task continuation.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "initiative_id",
    "repository",
    "worktree",
    "branch",
    "base_revision",
    "brain_revision",
    "timestamps",
    "environment_history",
    "objective",
    "state",
    "artifacts",
    "handoff",
    "freshness"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": { "$ref": "#/$defs/identifier" },
    "initiative_id": { "$ref": "#/$defs/identifier" },
    "repository": { "$ref": "#/$defs/reference" },
    "worktree": { "$ref": "#/$defs/reference" },
    "branch": { "$ref": "#/$defs/reference" },
    "base_revision": { "$ref": "#/$defs/revision" },
    "brain_revision": { "$ref": "#/$defs/revision" },
    "timestamps": { "$ref": "#/$defs/timestamps" },
    "environment_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/environmentEvent" },
      "minItems": 1
    },
    "objective": { "$ref": "#/$defs/objective" },
    "state": { "$ref": "#/$defs/state" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "handoff": { "$ref": "#/$defs/handoff" },
    "freshness": { "$ref": "#/$defs/freshness" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 160
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timestamps": {
      "type": "object",
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "last_handoff_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "environmentEvent": {
      "type": "object",
      "required": ["environment_id", "entered_at"],
      "properties": {
        "environment_id": { "$ref": "#/$defs/identifier" },
        "entered_at": { "$ref": "#/$defs/timestamp" },
        "exited_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "role": {
          "enum": ["orchestration", "review", "execution", "handoff", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "required": ["goal", "active_initiative", "current_packet", "scope", "completion_state"],
      "properties": {
        "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "active_initiative": { "$ref": "#/$defs/identifier" },
        "current_packet": { "$ref": "#/$defs/identifier" },
        "scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "uniqueItems": true
        },
        "completion_state": {
          "enum": [
            "not_started",
            "in_progress",
            "paused",
            "blocked",
            "acceptance_pending",
            "accepted",
            "completed",
            "superseded"
          ]
        }
      },
      "additionalProperties": false
    },
    "stateItem": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "decisionItem": {
      "type": "object",
      "required": ["summary", "status"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": {
          "enum": ["proposed", "approved", "rejected", "deferred", "superseded", "unknown"]
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["completed_work", "pending_work", "blockers", "decisions", "assumptions", "rejected_paths"],
      "properties": {
        "completed_work": { "type": "array", "items": { "$ref": "#/$defs/stateItem" } },
        "pending_work": { "type": "array", "items": { "$ref": "#/$defs/stateItem" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/stateItem" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decisionItem" } },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/stateItem" } },
        "rejected_paths": { "type": "array", "items": { "$ref": "#/$defs/stateItem" } }
      },
      "additionalProperties": false
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "change"],
      "properties": {
        "path": { "$ref": "#/$defs/reference" },
        "change": { "enum": ["added", "modified", "deleted", "unchanged", "unknown"] },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "commitReference": {
      "type": "object",
      "required": ["revision"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "message": { "type": "string", "maxLength": 500 },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "validationReference": {
      "type": "object",
      "required": ["name", "result", "observed_at", "references"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "result": { "enum": ["passed", "failed", "blocked", "not_run", "unknown"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "reportReference": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/reference" },
        "kind": {
          "enum": ["acceptance", "validation", "reconciliation", "handoff", "decision", "other"]
        },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["changed_files", "commits", "validations", "reports", "acceptance_evidence"],
      "properties": {
        "changed_files": { "type": "array", "items": { "$ref": "#/$defs/fileReference" } },
        "commits": { "type": "array", "items": { "$ref": "#/$defs/commitReference" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validationReference" } },
        "reports": { "type": "array", "items": { "$ref": "#/$defs/reportReference" } },
        "acceptance_evidence": { "type": "array", "items": { "$ref": "#/$defs/reportReference" } }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["previous_environment", "current_environment", "continuation_point", "next_action", "confirmation_required"],
      "properties": {
        "previous_environment": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "current_environment": { "$ref": "#/$defs/identifier" },
        "next_environment": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "continuation_point": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "next_action": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confirmation_required": { "const": true }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["source_revision", "repository_revision", "state", "confidence", "supersedes", "conflicts"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/revision" },
        "repository_revision": { "$ref": "#/$defs/revision" },
        "state": {
          "enum": ["fresh", "review_due", "stale", "superseded", "contradicted", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
