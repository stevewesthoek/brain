{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinite-brain-recovery-inventory.schema.json",
  "title": "Infinite Brain Recovery Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRepository",
          "sourcePath",
          "stateClass",
          "recoveryMode",
          "restoreOrder",
          "sampleContent",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sourceRepository": {
            "type": "string",
            "enum": ["brain", "mind"]
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+$"
          },
          "stateClass": {
            "type": "string",
            "enum": ["canonical", "generated", "runtime", "cache"]
          },
          "recoveryMode": {
            "type": "string",
            "enum": ["required", "optional", "excluded"]
          },
          "restoreOrder": {
            "type": "integer",
            "minimum": 1
          },
          "sampleContent": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reproducibleSourceRefs", "backupEvidenceRefs"],
            "properties": {
              "reproducibleSourceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+$"
                }
              },
              "backupEvidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
