{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "contractRef", "status", "consumer", "domain", "mode", "defaultActive", "productionActive", "adapter", "priorPath", "scope", "states", "activation"],
  "properties": {
    "$schema": { "type": "string" }, "$id": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" }, "contractRef": { "type": "string" }, "status": { "enum": ["CANARY_ACCEPTED_NO_DEFAULT", "CANARY_DEGRADED_NO_DEFAULT", "ROLLED_BACK", "BLOCKED"] }, "consumer": { "const": "codex" }, "domain": { "const": "research" }, "mode": { "const": "CANARY" }, "defaultActive": { "const": false }, "productionActive": { "const": false }, "adapter": { "type": "object", "required": ["adapterId", "revision"], "properties": { "adapterId": { "const": "adapter.codex-research.v1" }, "revision": { "type": "string" } }, "additionalProperties": false }, "priorPath": { "const": "codex-current-research-entry" }, "scope": { "type": "object", "required": ["included", "excluded"], "properties": { "included": { "contains": { "const": "Codex × Research" } }, "excluded": { "type": "array", "minItems": 1 } }, "additionalProperties": false }, "states": { "type": "array", "contains": { "const": "CANARY_ACTIVE" } }, "activation": { "type": "object", "required": ["authorization", "brainOwnedRouting", "readOnlySourceAcquisition", "rollback"], "properties": { "authorization": { "type": "string" }, "brainOwnedRouting": { "const": true }, "readOnlySourceAcquisition": { "const": true }, "rollback": { "type": "string" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
