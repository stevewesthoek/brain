{
  "profileVersion": "2.0.0",
  "profileId": "graphify-bounded-semantic",
  "operationalOutputRoot": "runtime/local/graphify",
  "compatibilityOutputRoots": ["graphify-out", ".graphify-out"],
  "generatedOutputAuthority": "non-authoritative",
  "publication": "atomic-staged-rename",
  "partialRunReceipt": "runtime/local/graphify/receipts",
  "freshnessState": "runtime/local/graphify/semantic-state.json",
  "retention": {
    "maxRuns": 7,
    "maxAgeDays": 14,
    "keepFailureReceipts": 14
  },
  "corpus": {
    "mode": "explicit-allowlist",
    "repositories": ["brain"],
    "mindApproved": false,
    "semanticScopes": [
      {
        "scopeId": "brain-architecture-docs",
        "repository": "brain",
        "paths": [
          "docs/system/brain-agentic-os-strategy.md",
          "docs/system/brain-agentic-os-roadmap.md",
          "docs/system/brain-console-architecture.md",
          "docs/system/graphify-context-standard.md",
          "operations/specs/infinite-brain-runtime-implementation-plan.md"
        ]
      }
    ],
    "excluded": [
      ".env",
      "**/.env",
      "operations/system-configs",
      "operations/infrastructure",
      "operations/automations/n8n/n8n_backup",
      "vendor",
      "node_modules",
      "runtime",
      "graphify-out",
      ".graphify-out",
      ".git",
      "**/*credential*",
      "**/*secret*",
      "**/*backup*",
      "**/*generated*"
    ]
  },
  "caps": {
    "maxDocuments": 8,
    "maxBytes": 2097152,
    "maxEstimatedTokens": 500000,
    "maxRuntimeSeconds": 300,
    "maxOutputBytes": 5242880
  },
  "execution": {
    "automaticFullScan": false,
    "nightlyMode": "event-gate-only",
    "incrementalMode": "changed-approved-documents-only",
    "repositoryMutation": "forbidden",
    "schedulerMode": "event-driven-semantic-gate",
    "runnerMode": "explicit-only",
    "codeOnlyInvokeRunner": false,
    "interpretUnchangedCode": false,
    "manualTriggerRequiresScope": true,
    "structuralGraphGeneration": "frozen"
  },
  "freshness": {
    "relevantChangeMarksStale": true,
    "codeOnlyChangeMarksStale": false,
    "missingReceipt": "unknown",
    "failedRegeneration": "stale",
    "successfulRegeneration": "fresh",
    "sourceIdentity": "git-head-plus-approved-document-sha256"
  },
  "safety": {
    "exactSourceAuthority": true,
    "cbmStructuralDefault": true,
    "graphifyMayAuthorizeWrites": false,
    "graphifyMayOverrideRoadmap": false,
    "graphifyMayReadMind": false,
    "externalOrLocalModelRequired": false
  }
}
