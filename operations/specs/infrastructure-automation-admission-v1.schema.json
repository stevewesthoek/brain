{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.prochat.local/ikhp/infrastructure-automation-admission-v1.schema.json","title":"Infrastructure Automation Admission Proposal v1","type":"object","required":["schemaVersion","proposalId","resourceIds","policyRevision","healthEvidence","provenance","riskClass","decision","rollbackExpectation","receiptId","lifecycle"],"properties":{"schemaVersion":{"const":"1.0.0"},"proposalId":{"type":"string","pattern":"^proposal:[a-z0-9._:-]+$"},"resourceIds":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z_]+:[a-z0-9][a-z0-9._-]*$"}},"policyRevision":{"type":"string","minLength":1},"healthEvidence":{"type":"object","required":["freshness"],"properties":{"freshness":{"enum":["fresh","stale","unknown"]}},"additionalProperties":true},"provenance":{"type":"array","minItems":1,"items":{"type":"object"}},"riskClass":{"enum":["read-only","low-risk-reversible","guarded-reversible","high-risk-human-approval-required","forbidden"]},"decision":{"enum":["proposed","evaluated","admitted","rejected","expired"]},"rollbackExpectation":{"type":"object"},"receiptId":{"type":"string","pattern":"^receipt:[a-z0-9._:-]+$"},"lifecycle":{"type":"object","required":["state"],"properties":{"state":{"enum":["proposed","evaluated","admitted","rejected","expired"]},"evaluatedAt":{"type":"string"},"expiresAt":{"type":"string"},"rejectionReason":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false}