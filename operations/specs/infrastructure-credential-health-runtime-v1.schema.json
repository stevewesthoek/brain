{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prochat.local/ikhp/infrastructure-credential-health-runtime-v1.schema.json",
  "title": "Infrastructure Credential Health Runtime v1",
  "description": "Non-secret scheduled credential health evidence and scheduling metadata.",
  "type": "object",
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$" },
    "status": { "enum": ["healthy", "degraded", "unhealthy", "unknown"] },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "detailedState": { "enum": ["unknown", "vault_unavailable", "credential_missing", "credential_present", "credential_expiring", "credential_expired", "provider_rejected", "provider_revoked", "wrong_account", "insufficient_scope", "interactive_reauthentication_required", "refresh_available", "refresh_failed", "provider_unavailable", "verified_healthy"] },
    "rateLimit": {
      "type": ["object", "null"],
      "properties": {
        "limit": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "resetAt": { "type": ["string", "null"], "format": "date-time" },
        "retryAfterSeconds": { "type": "integer", "minimum": 0, "maximum": 31536000 }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["checkCode", "outcome", "evidenceSummary"],
      "properties": {
        "checkCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "outcome": { "enum": ["pass", "fail", "skipped", "unknown"] },
        "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "readOnly", "authority"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "readOnly": { "const": true },
        "authority": { "const": "derived-runtime" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["credentialId", "accountId", "providerId", "providerCredentialType", "status", "freshness", "detailedState", "observedAt", "freshnessDeadline", "evaluationStatus", "conditionCodes", "cadenceSeconds", "backoffSeconds", "consecutiveTransientFailures", "missedIntervals", "lastAttemptAt", "nextDueAt", "expectedPrincipalMatch", "observedPrincipalLabel", "observedScopeSummary", "scopeEvidence", "observedExpiresAt", "expiryMetadataSource", "refreshAvailable", "providerReasonCode", "rateLimit", "checks", "provenance"],
      "properties": {
        "credentialId": { "$ref": "#/$defs/identifier" },
        "accountId": { "$ref": "#/$defs/identifier" },
        "providerId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "providerCredentialType": { "type": ["string", "null"], "maxLength": 128 },
        "status": { "$ref": "#/$defs/status" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "detailedState": { "$ref": "#/$defs/detailedState" },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "freshnessDeadline": { "type": ["string", "null"], "format": "date-time" },
        "evaluationStatus": { "enum": ["verified", "not_due", "not_verified", "overdue", "skipped"] },
        "conditionCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "uniqueItems": true },
        "cadenceSeconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
        "backoffSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "consecutiveTransientFailures": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "missedIntervals": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
        "nextDueAt": { "$ref": "#/$defs/timestamp" },
        "expectedPrincipalMatch": { "enum": ["verified", "mismatched", "unknown", "not_applicable"] },
        "observedPrincipalLabel": { "type": ["string", "null"], "maxLength": 256 },
        "observedScopeSummary": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
        "scopeEvidence": { "enum": ["provider_observed", "declared_only", "not_observable", "unknown"] },
        "observedExpiresAt": { "type": ["string", "null"], "format": "date-time" },
        "expiryMetadataSource": { "enum": ["user_declared", "provider_observed", "policy_derived", "unknown", null] },
        "refreshAvailable": { "type": ["boolean", "null"] },
        "providerReasonCode": { "type": ["string", "null"], "maxLength": 128 },
        "rateLimit": { "$ref": "#/$defs/rateLimit" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "generatedAt", "policyCatalogVersion", "containsSecrets", "evaluations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "policyCatalogVersion": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "containsSecrets": { "const": false },
    "evaluations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/evaluation" } }
  },
  "additionalProperties": false
}
