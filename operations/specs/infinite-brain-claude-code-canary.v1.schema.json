{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "activationId", "consumer", "domain", "mode", "status", "universalConsumerContractVersion", "adapterId", "adapterRevision", "legacyPath", "defaultActive", "productionActive", "activationPerformed", "scope", "fallback", "rollback", "states"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "activationId": { "type": "string", "minLength": 1 },
    "consumer": { "const": "claude-code" },
    "domain": { "const": "code" },
    "mode": { "const": "CANARY" },
    "status": { "enum": ["CONFORMANT", "CANARY_ACTIVE", "CANARY_ACCEPTED", "DEGRADED", "ROLLED_BACK"] },
    "universalConsumerContractVersion": { "const": "1.0.0" },
    "adapterId": { "const": "adapter.claude-code.v1" },
    "adapterRevision": { "type": "string", "minLength": 1 },
    "legacyPath": { "const": "claude-code-current-entry" },
    "defaultActive": { "const": false },
    "productionActive": { "const": false },
    "activationPerformed": { "type": "boolean" },
    "scope": { "type": "object", "required": ["consumerOnly", "domainOnly", "otherConsumersActivated", "otherDomainsActivated"] },
    "fallback": { "type": "object", "required": ["path", "manualConfigSurgeryRequired", "silentFallbacks"] },
    "rollback": { "type": "object", "required": ["mechanism", "targetTimeSeconds", "validation"] },
    "states": { "type": "array", "items": { "enum": ["CONFORMANT", "CANARY_ACTIVE", "CANARY_ACCEPTED", "DEGRADED", "ROLLED_BACK"] } }
  },
  "additionalProperties": true
}
