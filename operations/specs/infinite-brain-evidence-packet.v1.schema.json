{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/specs/infinite-brain-evidence-packet.v1.schema.json",
  "title": "Infinite Brain Evidence Packet v1",
  "description": "Bounded evidence for one atomic task step. It records what is known without becoming canonical knowledge or an execution receipt.",
  "type": "object",
  "required": ["schemaVersion", "evidenceId", "taskId", "subtaskId", "producerCapability", "sourceRevision", "inputRefs", "outputRefs", "evidenceRefs", "validationRefs", "claims", "uncertainties", "conflicts", "gateResults", "sideEffectsObserved", "continuationRefs", "status", "execution"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "subtaskId": { "$ref": "#/$defs/id" },
    "producerCapability": { "type": "object", "required": ["capabilityId", "sourceRef", "sourceRevision"], "properties": { "capabilityId": { "$ref": "#/$defs/id" }, "sourceRef": { "type": "string", "minLength": 1 }, "sourceRevision": { "$ref": "#/$defs/revision" } }, "additionalProperties": false },
    "provider": { "type": "object", "required": ["providerId", "providerRevision", "resolution", "authority"], "properties": { "providerId": { "$ref": "#/$defs/id" }, "providerRevision": { "$ref": "#/$defs/revision" }, "resolution": { "enum": ["NATIVE_CONSUMER", "SHARED_BRAIN", "APPROVED_ALTERNATIVE"] }, "authority": { "const": "brain" } }, "additionalProperties": false },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "inputRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 },
    "outputRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 },
    "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 },
    "validationRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1 },
    "research": { "$ref": "#/$defs/research" },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "object", "required": ["summary", "sourceRefs", "resolutionState"], "properties": { "summary": { "type": "string", "minLength": 1 }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 2 }, "resolutionState": { "enum": ["OPEN", "RECONCILED", "BLOCKING"] } }, "additionalProperties": false } },
    "gateResults": { "type": "array", "items": { "$ref": "#/$defs/gateResult" } },
    "sideEffectsObserved": { "type": "object", "required": ["declared", "observed", "evidenceRefs", "noneObserved"], "properties": { "declared": { "type": "array", "items": { "type": "string" } }, "observed": { "type": "array", "items": { "type": "string" } }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "noneObserved": { "type": "boolean" } }, "additionalProperties": false },
    "continuationRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 },
    "status": { "enum": ["PLANNED", "OBSERVED", "VALIDATED", "PARTIAL", "FAILED", "BLOCKED", "CONFLICTED", "INCOMPLETE"] },
    "execution": { "type": "object", "required": ["mode", "providerCalls", "writesPerformed", "mindWrites", "externalMutations"], "properties": { "mode": { "enum": ["shadow_fixture", "research_read_only", "shared_capability"] }, "providerCalls": { "type": "integer", "minimum": 0 }, "writesPerformed": { "type": "integer", "minimum": 0 }, "mindWrites": { "const": 0 }, "externalMutations": { "const": 0 } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]*$", "minLength": 1, "maxLength": 180 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 180 },
    "ref": { "type": "object", "required": ["refId", "refType", "value"], "properties": { "refId": { "$ref": "#/$defs/id" }, "refType": { "enum": ["capability", "adapter", "source", "context_pack", "context_request", "task", "evidence", "validation", "artifact", "continuation", "gate", "mind"] }, "value": { "type": "string", "minLength": 1, "maxLength": 500 }, "sourceRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] } }, "additionalProperties": false },
    "claim": { "type": "object", "required": ["claimId", "type", "statement", "sourceRefs", "evidenceRefs", "confidence"], "properties": { "claimId": { "$ref": "#/$defs/id" }, "type": { "enum": ["FACT", "SOURCE_EVIDENCE", "EXTRACTED_CLAIM", "INTERPRETATION", "CONCLUSION", "UNCERTAINTY", "CONFLICT", "FAILURE", "FOLLOW_UP_REQUIREMENT", "OUTPUT", "REPO_EVIDENCE", "IMPLEMENTATION_RESULT", "TEST_EVIDENCE", "REVIEW_EVIDENCE", "MEMORY_SOURCE", "PROVENANCE", "FACT_STATUS", "DECISION"] }, "statement": { "type": "string", "minLength": 1, "maxLength": 1000 }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
    "gateResult": { "type": "object", "required": ["gateRef", "status", "blocking", "evidenceRefs", "reason"], "properties": { "gateRef": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASS", "FAIL", "ADVISORY", "NOT_RUN"] }, "blocking": { "type": "boolean" }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }, "additionalProperties": false },
    "research": { "type": "object", "required": ["mode", "sourceRecords", "claimLedger", "evidenceLayers", "deepening", "stopping", "quality"], "properties": { "mode": { "const": "read_only_source_acquisition" }, "question": { "type": "string" }, "subquestions": { "type": "array", "items": { "type": "string" } }, "sourceRecords": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRecord" } }, "claimLedger": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/researchClaim" } }, "citationChecks": { "type": "array", "items": { "$ref": "#/$defs/citationCheck" } }, "sourceIndependence": { "$ref": "#/$defs/sourceIndependence" }, "freshness": { "$ref": "#/$defs/freshness" }, "authorityAssessment": { "$ref": "#/$defs/authorityAssessment" }, "evidenceLayers": { "type": "array", "items": { "enum": ["SOURCE", "EXTRACTED_EVIDENCE", "INTERPRETATION", "CONCLUSION", "UNCERTAINTY"] }, "minItems": 1, "uniqueItems": true }, "deepening": { "type": "object", "required": ["round1", "decision", "additionalRequests", "finalBudget"], "properties": { "round1": { "enum": ["MINIMUM_EVIDENCE"] }, "decision": { "enum": ["SUFFICIENT", "GAP_DETECTED"] }, "additionalRequests": { "type": "array", "maxItems": 1, "items": { "type": "object", "required": ["requestId", "reason", "atomic"], "properties": { "requestId": { "type": "string" }, "reason": { "type": "string" }, "atomic": { "const": true } }, "additionalProperties": false } }, "finalBudget": { "type": "object", "required": ["sourceFetches", "depthRounds", "estimatedTokens"], "properties": { "sourceFetches": { "type": "integer", "minimum": 0 }, "depthRounds": { "type": "integer", "minimum": 1 }, "estimatedTokens": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false }, "stopping": { "type": "object", "required": ["answerReady", "importantClaimsSupported", "contradictionsAddressed", "sourceQualityChecked", "retrievalValueChecked", "budgetChecked"], "properties": { "answerReady": { "type": "boolean" }, "importantClaimsSupported": { "type": "boolean" }, "contradictionsAddressed": { "type": "boolean" }, "sourceQualityChecked": { "type": "boolean" }, "retrievalValueChecked": { "type": "boolean" }, "budgetChecked": { "type": "boolean" } }, "additionalProperties": false }, "quality": { "type": "object", "required": ["primaryOrAuthoritativeUse", "relevance", "diversity", "weakSourceDependence", "contradictionsRetained"], "properties": { "primaryOrAuthoritativeUse": { "type": "number", "minimum": 0, "maximum": 1 }, "relevance": { "type": "number", "minimum": 0, "maximum": 1 }, "diversity": { "type": "number", "minimum": 0, "maximum": 1 }, "weakSourceDependence": { "type": "number", "minimum": 0, "maximum": 1 }, "contradictionsRetained": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
    "sourceRecord": { "type": "object", "required": ["sourceId", "title", "publisher", "url", "retrievedAt", "sourceClass", "retrievalStatus", "contentDigest", "claimRefs", "confidence", "uncertainty", "contradictionState"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 }, "author": { "type": "string" }, "sourceAuthority": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "retrievedAt": { "type": "string", "format": "date-time" }, "freshnessRequirement": { "enum": ["none", "current", "fresh", "archival"] }, "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN", "ARCHIVAL"] }, "retrievalMethod": { "type": "string" }, "independenceGroup": { "type": "string" }, "sourceClass": { "enum": ["PRIMARY", "OFFICIAL", "DIRECT_DATA", "SCHOLARLY", "HIGH_QUALITY_SECONDARY", "SUPPLEMENTARY", "UNAVAILABLE"] }, "sourceType": { "type": "string" }, "claimTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "peerReviewStatus": { "enum": ["VERIFIED", "UNKNOWN", "NOT_APPLICABLE"] }, "criticalEditionStatus": { "type": "string" }, "accessLevel": { "enum": ["FULL_TEXT_VERIFIED", "ABSTRACT/METADATA_ONLY", "REFERENCE_IDENTIFIED", "UNAVAILABLE"] }, "licenseConstraint": { "type": "string" }, "citationCapability": { "type": "string" }, "language": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "editionVersion": { "type": "string" }, "retrievalStatus": { "enum": ["RETRIEVED", "UNAVAILABLE", "STALE", "WEAK"] }, "contentDigest": { "type": "string", "minLength": 1 }, "excerpt": { "type": "string" }, "extractedEvidence": { "type": "string" }, "claimSynopsis": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "claimRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "uncertainty": { "type": "string" }, "contradictionState": { "enum": ["NONE", "OPEN", "RECONCILED", "BLOCKING"] } }, "additionalProperties": false },
    "citationCheck": { "type": "object", "required": ["citationId", "sourceId", "resolves", "sourceMatchesClaim", "claimBoundedByEvidence", "freshnessConsidered", "quotedMaterial", "passed"], "properties": { "citationId": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "resolves": { "type": "boolean" }, "sourceMatchesClaim": { "type": "boolean" }, "claimBoundedByEvidence": { "type": "boolean" }, "freshnessConsidered": { "type": "boolean" }, "quotedMaterial": { "type": "boolean" }, "passed": { "type": "boolean" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "sourceIndependence": { "type": "object", "required": ["sourceCount", "independentSourceCount", "independenceGroups", "repeatedUpstreamCount"], "properties": { "sourceCount": { "type": "integer", "minimum": 0 }, "independentSourceCount": { "type": "integer", "minimum": 0 }, "independenceGroups": { "type": "array", "items": { "type": "string" } }, "repeatedUpstreamCount": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "freshness": { "type": "object", "required": ["requirement", "retrievedAt", "staleSourceCount", "currentEnough"], "properties": { "requirement": { "enum": ["none", "current", "fresh", "archival"] }, "retrievedAt": { "type": "string", "format": "date-time" }, "staleSourceCount": { "type": "integer", "minimum": 0 }, "currentEnough": { "type": "boolean" } }, "additionalProperties": false },
    "authorityAssessment": { "type": "object", "required": ["claimType", "preferredSourceTypes", "selectedSourceTypes", "metadataOnlySources", "fullTextSources", "authorityGap", "allBibleSourcesPreloaded", "allCommentariesPreloaded", "allCriticalResourcesPreloaded"], "properties": { "claimType": { "type": "string" }, "preferredSourceTypes": { "type": "array", "items": { "type": "string" } }, "selectedSourceTypes": { "type": "array", "items": { "type": "string" } }, "metadataOnlySources": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "fullTextSources": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "authorityGap": { "type": "boolean" }, "allBibleSourcesPreloaded": { "const": false }, "allCommentariesPreloaded": { "const": false }, "allCriticalResourcesPreloaded": { "const": false } }, "additionalProperties": false },
    "researchClaim": { "type": "object", "required": ["claimId", "layer", "statement", "sourceRefs", "evidenceRefs", "confidence", "uncertainty", "relation"], "properties": { "claimId": { "$ref": "#/$defs/id" }, "layer": { "enum": ["SOURCE", "EXTRACTED_EVIDENCE", "INTERPRETATION", "CONCLUSION", "UNCERTAINTY"] }, "statement": { "type": "string", "minLength": 1, "maxLength": 1000 }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "uncertainty": { "type": "string" }, "relation": { "enum": ["SUPPORTS", "QUALIFIES", "CONTRADICTS", "UNRESOLVED"] } }, "additionalProperties": false }
  }
}
