{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brain MCP Provider Admission Registry",
  "type": "object",
  "required": ["schemaVersion", "reviewedAt", "admissions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["admissionId", "status", "owner", "consumer", "provider", "transport", "authentication", "scope", "limits", "verification", "revocation"],
        "properties": {
          "admissionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "status": { "enum": ["candidate", "active-local", "paused", "revoked"] },
          "owner": { "const": "brain-runtime" },
          "provider": {
            "type": "object",
            "required": ["providerId", "repository", "revision", "sourceState", "version", "entrypoint", "artifacts"]
          },
          "transport": {
            "type": "object",
            "required": ["kind", "serverName", "projectScoped", "shell", "networkPolicy"],
            "properties": {
              "kind": { "const": "stdio" },
              "serverName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "projectScoped": { "const": true },
              "shell": { "const": false },
              "networkPolicy": { "enum": ["loopback-only", "loopback-with-bounded-egress"] },
              "boundedEgressExceptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["host", "purpose", "protocol", "method", "failureBehavior", "sourceDataTransmitted"],
                  "properties": {
                    "host": { "type": "string" },
                    "purpose": { "type": "string" },
                    "protocol": { "enum": ["https", "http"] },
                    "method": { "enum": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"] },
                    "failureBehavior": { "enum": ["non-blocking-non-fatal", "blocking-fatal", "blocking-non-fatal"] },
                    "sourceDataTransmitted": { "const": false },
                    "disableableByEnvVar": { "type": ["string", "null"] },
                    "note": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "networkNote": { "type": "string" }
            },
            "if": {
              "properties": { "networkPolicy": { "const": "loopback-with-bounded-egress" } },
              "required": ["networkPolicy"]
            },
            "then": {
              "required": ["boundedEgressExceptions"]
            },
            "else": {
              "properties": { "boundedEgressExceptions": false }
            }
          },
          "authentication": {
            "type": "object",
            "required": ["mode", "relayAllowed"],
            "if": {
              "properties": { "mode": { "const": "derived-credential-file" } },
              "required": ["mode"]
            },
            "then": {
              "required": ["credentialFileEnvironmentVariable", "principal", "audience", "storage"]
            },
            "else": {
              "properties": {
                "credentialFileEnvironmentVariable": false,
                "principal": false,
                "audience": false,
                "storage": false
              }
            }
          },
          "scope": {
            "type": "object",
            "required": ["toolAllowlistEnvironmentVariable", "suboperationAllowlistEnvironmentVariable", "tools"],
            "properties": {
              "toolAllowlistEnvironmentVariable": { "type": "string" },
              "suboperationAllowlistEnvironmentVariable": { "type": "string" },
              "fixedEnvironment": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "tools": { "type": "array" }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
