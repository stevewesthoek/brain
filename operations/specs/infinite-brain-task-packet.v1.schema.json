{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/specs/infinite-brain-task-packet.v1.schema.json",
  "title": "Infinite Brain Task Packet v1",
  "description": "Bounded, provider-neutral orchestration state. References canonical sources and never grants execution authority.",
  "type": "object",
  "required": [
    "schemaVersion", "taskId", "sourceRevision", "request", "route", "primaryAdapter", "selectedCapabilityRefs",
    "requiredQualityGates", "requiredSafetyGates", "contextRequests", "scope", "context", "qualification",
    "permissions", "plan", "state", "evidenceRefs", "artifactRefs", "validationRefs", "stateRefs",
    "continuityRef", "nextAction", "failurePolicy", "authority", "execution"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "$ref": "#/$defs/id" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "request": { "type": "object", "required": ["rawIntent", "goal", "intent", "domains", "outputExpectations"], "properties": { "rawIntent": { "type": "string", "minLength": 1, "maxLength": 2000 }, "goal": { "type": "string", "minLength": 1, "maxLength": 2000 }, "intent": { "type": "string", "minLength": 1, "maxLength": 80 }, "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "desiredArtifact": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "constraints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "unknowns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "outputExpectations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "riskIndicators": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "riskClass": { "type": "string" }, "confirmationClass": { "type": "string" }, "contextRequirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }, "additionalProperties": true },
    "route": { "$ref": "#/$defs/route" },
    "primaryAdapter": { "$ref": "#/$defs/adapterRef" },
    "selectedCapabilityRefs": { "type": "array", "items": { "$ref": "#/$defs/capabilityRef" }, "minItems": 1 },
    "requiredQualityGates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "requiredSafetyGates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "contextRequests": { "type": "array", "items": { "$ref": "#/$defs/contextRequest" }, "minItems": 1 },
    "scope": { "type": "object", "required": ["inScope", "outOfScope"], "properties": { "inScope": { "type": "array", "items": { "type": "string" } }, "outOfScope": { "type": "array", "items": { "type": "string" } }, "repository": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }, "additionalProperties": false },
    "context": { "$ref": "#/$defs/context" },
    "qualification": { "type": "object", "required": ["questionAsked", "questionRef", "assumptions"], "properties": { "questionAsked": { "type": "boolean" }, "questionRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }, "assumptions": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "permissions": { "type": "object", "required": ["riskClass", "confirmationClass", "confirmationState"], "properties": { "riskClass": { "enum": ["read-only", "low", "medium", "high", "critical"] }, "confirmationClass": { "enum": ["none", "policy", "user", "admin"] }, "confirmationState": { "enum": ["not_required", "required", "received", "denied"] } }, "additionalProperties": false },
    "plan": { "type": "object", "required": ["nodes", "currentNode"], "properties": { "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 1 }, "currentNode": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } }, "additionalProperties": false },
    "state": { "type": "object", "required": ["status", "completed", "pending", "blockers", "decisions"], "properties": { "status": { "enum": ["PLANNED", "NEEDS_QUALIFICATION", "CONFIRMATION_REQUIRED", "READY", "BLOCKED", "STALE", "CONFLICTED", "UNAVAILABLE", "COMPLETE"] }, "completed": { "type": "array", "items": { "type": "string" } }, "pending": { "type": "array", "items": { "type": "string" } }, "blockers": { "type": "array", "items": { "type": "string" } }, "decisions": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
    "artifactRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
    "validationRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true },
    "stateRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1, "uniqueItems": true },
    "continuityRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 500 },
    "failurePolicy": { "type": "object", "required": ["outcomes", "stopOn", "optionalFallback"], "properties": { "outcomes": { "type": "array", "items": { "enum": ["NEEDS_QUALIFICATION", "CAPABILITY_UNAVAILABLE", "CONTEXT_MISSING", "CONTEXT_STALE", "CONTEXT_CONFLICT", "AUTHORITY_AMBIGUOUS", "CONFIRMATION_REQUIRED", "GATE_FAILED", "DEPENDENCY_FAILED", "EVIDENCE_INSUFFICIENT", "SOURCE_CHANGED", "UNSAFE_TO_PROCEED"] }, "minItems": 1, "uniqueItems": true }, "stopOn": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "optionalFallback": { "type": "string", "minLength": 1, "maxLength": 300 } }, "additionalProperties": false },
    "authority": { "type": "object", "required": ["taskState", "evidence", "context", "execution", "conversationCanonical"], "properties": { "taskState": { "const": "task_packet" }, "evidence": { "const": "evidence_packet" }, "context": { "const": "context_pack_or_broker" }, "execution": { "const": "existing_execution_and_gate_systems" }, "conversationCanonical": { "const": false } }, "additionalProperties": false },
    "execution": { "type": "object", "required": ["mode", "providerCalls", "externalMutations", "mindWrites", "profileActivations", "clientConfigChanges", "automaticResumeAllowed"], "properties": { "mode": { "const": "shadow" }, "providerCalls": { "const": 0 }, "externalMutations": { "const": 0 }, "mindWrites": { "const": 0 }, "profileActivations": { "const": 0 }, "clientConfigChanges": { "const": 0 }, "automaticResumeAllowed": { "const": false } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]*$", "minLength": 1, "maxLength": 180 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 180 },
    "ref": { "type": "object", "required": ["refId", "refType", "value"], "properties": { "refId": { "$ref": "#/$defs/id" }, "refType": { "enum": ["capability", "adapter", "source", "context_pack", "context_request", "task", "evidence", "validation", "artifact", "continuation", "gate", "mind"] }, "value": { "type": "string", "minLength": 1, "maxLength": 500 }, "sourceRevision": { "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] } }, "additionalProperties": false },
    "route": { "type": "object", "required": ["routeId", "routeFamily", "primaryAdapter", "selectedCapabilities", "rejectedAlternatives", "rationale"], "properties": { "routeId": { "$ref": "#/$defs/id" }, "routeFamily": { "type": "string", "minLength": 1 }, "primaryAdapter": { "$ref": "#/$defs/adapterRef" }, "selectedCapabilities": { "type": "array", "items": { "$ref": "#/$defs/capabilityRef" }, "minItems": 1 }, "rejectedAlternatives": { "type": "array", "items": { "type": "object", "required": ["id", "reason"], "properties": { "id": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } }, "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "specialization": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }, "additionalProperties": false },
    "adapterRef": { "type": "object", "required": ["adapterId", "sourceRef", "sourceRevision", "mode"], "properties": { "adapterId": { "$ref": "#/$defs/id" }, "sourceRef": { "type": "string", "minLength": 1 }, "sourceRevision": { "$ref": "#/$defs/revision" }, "mode": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "capabilityRef": { "type": "object", "required": ["capabilityId", "role", "sourceRef", "sourceRevision"], "properties": { "capabilityId": { "$ref": "#/$defs/id" }, "role": { "enum": ["PRIMARY_OWNER", "SPECIALIST", "QUALITY_GATE", "SAFETY_GATE", "CONTEXT_SERVICE", "CONTINUITY_SERVICE", "DEPENDENCY"] }, "sourceRef": { "type": "string", "minLength": 1 }, "sourceRevision": { "$ref": "#/$defs/revision" } }, "additionalProperties": false },
    "context": { "type": "object", "required": ["bootstrapRef", "contextPackRefs", "requiredScopes", "budget"], "properties": { "bootstrapRef": { "$ref": "#/$defs/ref" }, "contextPackRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "uniqueItems": true }, "requiredScopes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }, "budget": { "type": "object", "required": ["maxTokens", "usedTokens"], "properties": { "maxTokens": { "type": "integer", "minimum": 1, "maximum": 4000 }, "usedTokens": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
    "contextRequest": { "type": "object", "required": ["requestId", "contextScope", "authority", "query", "exactRefs", "freshnessRequirement", "maxBudget", "required", "conflictPolicy", "fallback", "resolutionStatus", "contextPackRef"], "properties": { "requestId": { "$ref": "#/$defs/id" }, "contextScope": { "type": "string", "minLength": 1 }, "authority": { "enum": ["git", "brain", "mind", "context_broker", "session_continuity", "fixture"] }, "query": { "type": "string", "maxLength": 1000 }, "exactRefs": { "type": "array", "items": { "type": "string" } }, "freshnessRequirement": { "enum": ["none", "current", "fresh", "live", "archival"] }, "maxBudget": { "type": "integer", "minimum": 1, "maximum": 4000 }, "required": { "type": "boolean" }, "conflictPolicy": { "enum": ["surface", "block", "prefer_canonical"] }, "fallback": { "enum": ["exact_source", "bounded_summary", "ask_one_question", "stop"] }, "resolutionStatus": { "enum": ["PLANNED", "RESOLVED", "STALE", "CONFLICTED", "UNAVAILABLE"] }, "contextPackRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] } }, "additionalProperties": false },
    "gate": { "type": "object", "required": ["gateRef", "inputRequired", "scope", "expectedOutput", "semantics", "evidenceRequired", "failureBehavior", "blocking"], "properties": { "gateRef": { "type": "string", "minLength": 1 }, "inputRequired": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "scope": { "type": "string", "minLength": 1 }, "expectedOutput": { "type": "string", "minLength": 1 }, "semantics": { "type": "array", "items": { "enum": ["PASS", "FAIL", "ADVISORY", "NOT_RUN"] }, "minItems": 2, "uniqueItems": true }, "evidenceRequired": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "failureBehavior": { "type": "string", "minLength": 1 }, "blocking": { "type": "boolean" } }, "additionalProperties": false },
    "node": { "type": "object", "required": ["nodeId", "nodeRole", "ownerCapabilityRef", "action", "instructionRefs", "contextRequestRefs", "expectedOutput", "evidenceRequirements", "qualityGateRefs", "safetyGateRefs", "dependsOn", "nextOnSuccess", "nextOnFailure", "mergePoint", "riskClass", "failureBehavior"], "properties": { "nodeId": { "$ref": "#/$defs/id" }, "nodeRole": { "enum": ["PRIMARY_OWNER", "SPECIALIST", "QUALITY_GATE", "SAFETY_GATE", "CONTEXT_SERVICE", "CONTINUITY_SERVICE", "DEPENDENCY"] }, "ownerCapabilityRef": { "$ref": "#/$defs/capabilityRef" }, "action": { "type": "string", "minLength": 1, "maxLength": 300 }, "instructionRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "contextRequestRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1 }, "expectedOutput": { "type": "string", "minLength": 1, "maxLength": 300 }, "evidenceRequirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "qualityGateRefs": { "type": "array", "items": { "$ref": "#/$defs/gate" } }, "safetyGateRefs": { "type": "array", "items": { "$ref": "#/$defs/gate" } }, "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "nextOnSuccess": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "nextOnFailure": { "type": "string", "minLength": 1 }, "mergePoint": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "riskClass": { "enum": ["read-only", "low", "medium", "high", "critical"] }, "failureBehavior": { "type": "string", "minLength": 1, "maxLength": 300 } }, "additionalProperties": false }
  }
}
