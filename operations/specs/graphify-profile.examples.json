{
  "examples": {
    "mind-knowledge": {
      "graphifyStandardVersion": "1",
      "profile": "mind-knowledge",
      "repoRole": "strategy-memory",
      "modes": [
        "knowledge-research",
        "human-file-relationship",
        "ai-context",
        "operations-freshness"
      ],
      "outputs": ["report", "json", "html"],
      "optionalOutputs": [],
      "initialBuildPolicy": {
        "taskType": "codebase_semantic_graph",
        "qualityTier": "highest",
        "selectionPolicy": "ordered_premium",
        "preferredProviders": ["claude-bedrock", "ollama-m4pro", "ollama-m1"],
        "preferredModels": ["us.anthropic.claude-opus-4-6-v1"],
        "fallbackPolicy": "ordered_then_selector_default"
      },
      "criticalRebuildPolicy": {
        "taskType": "codebase_semantic_graph",
        "qualityTier": "highest",
        "selectionPolicy": "ordered_premium",
        "preferredProviders": ["claude-bedrock", "ollama-m4pro", "ollama-m1"],
        "preferredModels": ["us.anthropic.claude-opus-4-6-v1"],
        "fallbackPolicy": "ordered_then_selector_default"
      },
      "incrementalPolicy": {
        "taskType": "codebase_semantic_graph",
        "qualityTier": "efficient",
        "selectionPolicy": "selector_default",
        "preferLocalWhenSafe": true,
        "allowAstOnly": true,
        "fallbackPolicy": "selector_default"
      },
      "exclude": [
        ".git/**",
        ".obsidian/**",
        "graphify-out/**",
        ".graphify-out/**",
        "daily/**",
        "**/.venv/**",
        "**/.venv*/**",
        "**/venv/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "**/.cache/**"
      ],
      "trackGeneratedArtifacts": [
        "graphify-out/GRAPH_REPORT.md",
        "graphify-out/graph.json",
        "graphify-out/graph.html"
      ],
      "dashboardVisibility": true,
      "humanReadableFileGraph": true,
      "aiContextMode": true,
      "hooks": {
        "enabled": false,
        "postCommit": false,
        "postCheckout": false,
        "operation": "update"
      },
      "watch": {
        "enabled": false,
        "debounceMs": 30000,
        "maxRunsPerHour": 4,
        "operation": "update"
      }
    },
