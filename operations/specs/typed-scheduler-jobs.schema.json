{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/schemas/typed-scheduler-jobs.schema.json",
  "title": "Brain Scheduler registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "authority", "scheduler", "jobs"],
  "properties": {
    "registryVersion": { "type": "string", "const": "2.0.0" },
    "authority": { "type": "string", "const": "canonical-job-registry" },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "launchMechanism", "launchAgentLabel", "timezone", "scheduleType", "schedule", "hour", "minute", "runAtLoad", "bootstrap", "runner", "stateDirectory", "logDirectory", "latestReport"],
      "properties": {
        "id": { "type": "string", "const": "brain-scheduler" },
        "name": { "type": "string", "const": "Brain Scheduler" },
        "launchMechanism": { "type": "string", "const": "macOS launchd LaunchAgent" },
        "launchAgentLabel": { "type": "string", "const": "com.office.nightly-scheduler" },
        "timezone": { "type": "string", "const": "Europe/Lisbon" },
        "scheduleType": { "type": "string", "enum": ["daily"] },
        "schedule": { "type": "string", "const": "daily at 03:00 Europe/Lisbon" },
        "hour": { "type": "integer", "const": 3 },
        "minute": { "type": "integer", "const": 0 },
        "runAtLoad": { "type": "boolean", "const": true },
        "bootstrap": { "type": "string", "const": "tools/scripts/office-nightly-scheduler.sh" },
        "runner": { "type": "string", "const": "tools/scripts/brain-scheduler-runner.mjs" },
        "stateDirectory": { "type": "string", "const": "~/.local/state/office-scheduler" },
        "logDirectory": { "type": "string", "const": "~/Library/Logs/office-scheduler" },
        "latestReport": { "type": "string", "const": "runtime/local/office-scheduler/latest-run.md" }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "owner", "entrypoint", "fixedArguments", "dependencies", "scheduleType", "schedule", "lifecycle", "mode", "authority", "networkAccess", "credentialSensitive", "destructive", "mindWrite", "timeoutSeconds", "retries", "concurrency", "idempotency", "receipt", "outputArtifacts", "policyReason", "runbook", "tags", "humanAction", "reviewCategory", "evidenceState", "externalActivation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "fixedArguments": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
          "scheduleType": { "type": "string", "enum": ["daily", "event-driven", "manual", "disabled"] },
          "schedule": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "enum": ["active", "manual-only", "policy-blocked", "disabled", "deprecated"] },
          "mode": { "type": "string", "enum": ["report-only", "dry-run-report-only", "event-driven-semantic-only", "disabled"] },
          "authority": { "type": "string", "enum": ["brain", "mind-read-only", "external-review-required", "manual-operator"] },
          "networkAccess": { "type": "string", "enum": ["none", "read-only", "external-write-capable", "unknown"] },
          "credentialSensitive": { "type": "boolean" },
          "destructive": { "type": "boolean" },
          "mindWrite": { "type": "boolean" },
          "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "retries": { "type": "integer", "const": 0 },
          "concurrency": { "type": "string", "const": "single" },
          "idempotency": { "type": "string", "enum": ["once-per-lisbon-day", "event-receipt", "manual-receipt"] },
          "receipt": { "type": "string", "minLength": 1 },
          "outputArtifacts": { "type": "array", "items": { "type": "string" } },
          "policyReason": { "type": "string", "minLength": 1 },
          "runbook": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "humanAction": { "type": "string", "minLength": 1 },
          "reviewCategory": { "type": "string", "enum": ["ACTIVE", "BLOCKED", "NEEDS REVIEW", "OBSOLETE"] },
          "evidenceState": { "type": "string", "enum": ["repository-configured", "historical-only", "live-observed"] },
          "externalActivation": { "type": "string", "const": "unknown" }
        }
      }
    }
  }
}
