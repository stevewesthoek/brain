{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prochat.local/ikhp/infrastructure-observation-v1.schema.json",
  "title": "Infrastructure Observation v1",
  "type": "object",
  "$defs": {
    "resourceId": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9][a-z0-9._-]*$" },
    "status": { "enum": ["healthy", "degraded", "unhealthy", "unknown"] },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "provenance": {
      "type": "object",
      "required": ["source", "readOnly", "authority"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "readOnly": { "const": true },
        "authority": { "enum": ["provider-evidence", "local-observation", "derived-runtime"] }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["schemaVersion", "observationId", "resourceId", "providerId", "observedAt", "status", "freshness", "sourceEntityId", "metricsSummary", "conditionCodes", "provenance"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "observationId": { "type": "string", "pattern": "^observation:[a-z0-9._:-]+$" },
        "resourceId": { "$ref": "#/$defs/resourceId" },
        "providerId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "observedAt": { "type": "string", "format": "date-time" },
        "status": { "$ref": "#/$defs/status" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "sourceEntityId": { "type": ["string", "null"] },
        "metricsSummary": { "type": "object" },
        "conditionCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "uniqueItems": true },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        { "if": { "properties": { "freshness": { "enum": ["stale", "unknown"] } } }, "then": { "properties": { "status": { "enum": ["degraded", "unhealthy", "unknown"] } } } }
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "maxObservations", "maxAgeSeconds", "observations"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "maxObservations": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxAgeSeconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      },
      "additionalProperties": false
    }
  },
  "required": ["observation"],
  "properties": { "observation": { "$ref": "#/$defs/observation" } },
  "additionalProperties": false
}
