{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.local/specs/infinite-brain-codex-research-default.v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "activationId", "consumer", "domain", "mode", "status", "universalConsumerContractVersion", "adapterRevision", "priorPath", "defaultActive", "productionActive", "activationPerformed", "scope", "fallback", "rollback", "states"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "activationId": { "type": "string", "minLength": 1 },
    "consumer": { "const": "codex" },
    "domain": { "const": "research" },
    "mode": { "const": "DEFAULT" },
    "status": { "enum": ["CANARY_ACCEPTED", "RESEARCH_V2_DEFAULT_FOR_CODEX", "ROLLED_BACK"] },
    "universalConsumerContractVersion": { "const": "1.0.0" },
    "adapterRevision": { "type": "string", "minLength": 1 },
    "priorPath": { "const": "codex-current-research-entry" },
    "defaultActive": { "type": "boolean" },
    "productionActive": { "const": false },
    "activationPerformed": { "type": "boolean" },
    "activationTimestamp": { "type": "string", "format": "date-time" },
    "brainRevision": { "type": "string", "minLength": 1 },
    "scope": { "type": "object", "required": ["consumerOnly", "domainOnly", "otherConsumersActivated", "otherDomainsActivated", "codeDefaultChanged"], "properties": { "consumerOnly": { "const": "codex" }, "domainOnly": { "const": "research" }, "otherConsumersActivated": { "const": 0 }, "otherDomainsActivated": { "const": 0 }, "codeDefaultChanged": { "const": false } }, "additionalProperties": false },
    "fallback": { "type": "object", "required": ["path", "trigger", "manualConfigSurgeryRequired"], "properties": { "path": { "const": "codex-current-research-entry" }, "trigger": { "type": "string" }, "manualConfigSurgeryRequired": { "const": false } }, "additionalProperties": false },
    "rollback": { "type": "object", "required": ["mechanism", "targetTimeSeconds", "validation"], "properties": { "mechanism": { "type": "string" }, "targetTimeSeconds": { "type": "integer", "minimum": 0 }, "validation": { "type": "string" } }, "additionalProperties": false },
    "states": { "type": "array", "items": { "enum": ["CANARY_ACCEPTED", "RESEARCH_V2_DEFAULT_FOR_CODEX", "ROLLED_BACK"] }, "contains": { "const": "RESEARCH_V2_DEFAULT_FOR_CODEX" } }
  },
  "additionalProperties": false
}
