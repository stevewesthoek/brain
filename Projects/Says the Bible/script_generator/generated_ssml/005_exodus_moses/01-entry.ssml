<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Take a slow breath in.<break time="500ms"/>
      And let it out.<break time="1000ms"/>
      Again, breathe in.<break time="500ms"/>
      And breathe out.<break time="1800ms"/>
      Let your shoulders loosen.<break time="500ms"/>
      Let your forehead soften.<break time="1000ms"/>
      There is nothing you need to prove right now.<break time="1800ms"/>
      Tonight we will move slowly through the book of Exodus, following the life of Moses.<break time="500ms"/>
      We will hear how God sees the afflicted, speaks from the fire, brings His people out, and stays with them in the wilderness.<break time="1000ms"/>
      This is a story of deliverance, but it is also a story of presence.<break time="500ms"/>
      The Lord does not forget the cries that rise to Him.<break time="500ms"/>
      The Lord does not lose the people He has chosen to keep.<break time="1000ms"/>
      And as the story slows, the same steady truth will remain: God sees, God hears, and God stays.<break time="1800ms"/>
      You do not need to rush ahead of the words.<break time="500ms"/>
      You can simply listen and receive.<break time="1000ms"/>
      You do not have to hold every detail in your mind.<break time="500ms"/>
      You can let the story carry you slowly.<break time="1800ms"/>
    </prosody>
  </voice>
</speak>