<speak xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="http://www.w3.org/2001/mstts" xmlns:emo="http://www.w3.org/2009/10/emotionml" version="1.0" xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      Now the story can grow quieter.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      Only the truths that remained underneath every scene.<break time="1800ms"/>
      God saw His people.<break time="1800ms"/>
      God heard their cry.<break time="1800ms"/>
      God called Moses.<break time="1800ms"/>
      God opened the way.<break time="1800ms"/>
      God fed them in wilderness.<break time="1800ms"/>
      God gave His presence on the road.<break time="1800ms"/>
      You are safe in God's leading.<break time="3800ms"/>
      The hard middle is not outside His sight.<break time="1800ms"/>
      The slow road is not outside His care.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
