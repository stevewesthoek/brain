<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
      The last part of the Psalm becomes very still.<break time="500ms"/>
      You prepare a table before me.<break time="500ms"/>
      You anoint my head with oil.<break time="500ms"/>
      My cup overflows.<break time="1800ms"/>

      The Shepherd is no longer only leading through open land.<break time="500ms"/>
      He is hosting.<break time="500ms"/>
      Caring.<break time="500ms"/>
      Filling what was empty.<break time="1800ms"/>

      Then the words grow even quieter.<break time="500ms"/>
      Surely goodness and mercy shall follow me all the days of my life.<break time="1000ms"/>
      And I shall dwell in the house of the Lord forever.<break time="1800ms"/>

      Goodness follows.<break time="500ms"/>
      Mercy follows.<break time="500ms"/>
      Not for one brief moment only.<break time="500ms"/>
      For all the days.<break time="1800ms"/>

      And the Psalm ends at home.<break time="500ms"/>
      Not in striving.<break time="500ms"/>
      Not in fear.<break time="500ms"/>
      At home with the Lord.<break time="1800ms"/>

      Even goodness and mercy are described like companions close behind.<break time="500ms"/>
      What follows you in the Psalm is not threat, but kindness.<break time="500ms"/>
      Not accusation, but mercy.<break time="1800ms"/>

      And dwelling in the house of the Lord is not a rushed visit.<break time="500ms"/>
      It is abiding.<break time="500ms"/>
      Staying.<break time="500ms"/>
      Remaining where the Shepherd's care does not run out.<break time="1800ms"/>

      The Shepherd leads to enough.<break time="500ms"/>
      The Shepherd leads to peace.<break time="500ms"/>
      The Shepherd leads to home.<break time="1800ms"/>

      Goodness and mercy are not behind you by accident.<break time="1000ms"/>
      You are being led all the way home.<break time="1000ms"/>
      You are safe in the Shepherd's care.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
