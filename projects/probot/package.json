{
  "name": "probot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Telegram control plane for Brain, Claude, and Codex workflows.",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/bot/local-apps.test.ts src/bot/video-orchestrator-jobs.test.ts src/scripts/video-orchestrator-scheduler.test.ts",
    "ci": "npm run typecheck && npm test",
    "probot:video:jobs": "tsx src/scripts/video-orchestrator-scheduler.mjs list",
    "probot:video:status": "tsx src/scripts/video-orchestrator-scheduler.mjs status",
    "probot:video:reset-quota": "tsx src/scripts/video-orchestrator-scheduler.mjs reset-quota",
    "probot:video:schedule-month": "tsx src/scripts/video-orchestrator-scheduler.mjs schedule-month",
    "probot:video:run-due": "tsx src/scripts/video-orchestrator-scheduler.mjs run-due",
    "probot:video:plan-projects": "tsx src/scripts/video-orchestrator-project-scheduler.mjs"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.38.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
