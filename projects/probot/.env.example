TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USER_IDS=

PROBOT_BRAIN_ROOT=/Users/Office/Repos/stevewesthoek/brain
PROBOT_DATA_DIR=/Users/Office/Repos/stevewesthoek/brain/projects/probot/data
PROBOT_NOTES_DIR=/Users/Office/Repos/stevewesthoek/brain/projects/probot/inbox

PROBOT_ALLOWED_ROOTS=/Users/Office/Repos/stevewesthoek/brain,/Users/Office/Documents,/Users/Office/Desktop,/Users/Office/Downloads
PROBOT_MAX_FILE_MB=20
PROBOT_DEBUG=false

CLAUDE_PROJECTS_DIR=/Users/Office/.claude/projects
CODEX_SESSIONS_DIR=/Users/Office/.codex/sessions
CODEX_SESSION_INDEX=/Users/Office/.codex/session_index.jsonl

# Cloudflare — for Domains tab (zones list + RDAP expiry, cached 1h)
CLOUDFLARE_API_TOKEN=               # Zone:Read scope is sufficient

# Umami analytics (self-hosted) — powers the Analytics tab
# Note: self-hosted Umami has no API key support — uses username/password login (JWT, cached 55 min)
UMAMI_URL=https://umami.yourdomain.com
UMAMI_USERNAME=admin
UMAMI_PASSWORD=
