{
  "name": "brain-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local read-only Brain Core API for Obsidian-first machine state.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:local-app-actions-live": "npm run build && node scripts/test-local-app-actions-live.mjs",
    "ci": "npm run typecheck && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
