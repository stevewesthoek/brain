<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            Now the story can become simple.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      The same truth remains.<break time="1800ms"/>
      The Lord is still faithful.<break time="1800ms"/>
      The star led to Jesus.<break time="1800ms"/>
      The wise men worshipped the child.<break time="1800ms"/>
      A great light dawned in Galilee.<break time="1800ms"/>
      Jesus called His people the light of the world.<break time="1800ms"/>
      The lamp was set on a stand.<break time="1800ms"/>
      Good works were meant to glorify the Father.<break time="1800ms"/>
      You are called to walk in His light.<break time="3800ms"/>
      You are safe in the light of Christ.<break time="3800ms"/>
      You do not have to carry anything more from the story.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>