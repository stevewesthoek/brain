<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
      God told Noah to build an ark.<break time="500ms"/>
      Not a small boat, but a large wooden shelter.<break time="500ms"/>
      A place to hold his family, and to hold living creatures.<break time="1000ms"/>

      God gave clear instructions.<break time="500ms"/>
      Room by room.<break time="500ms"/>
      Measurements and beams.<break time="500ms"/>
      A door in the side.<break time="500ms"/>
      A covering over the wood, so the water would stay outside.<break time="1800ms"/>

      Then God spoke a promise to Noah.<break time="500ms"/>
      A covenant.<break time="500ms"/>
      A word of preservation.<break time="1000ms"/>
      A way of being kept.<break time="1800ms"/>

      And Noah did what God asked.<break time="500ms"/>
      Day after day.<break time="500ms"/>
      Quiet obedience.<break time="1800ms"/>

      Noah built, one piece at a time.<break time="1000ms"/>
      God is patient and steady.<break time="1000ms"/>
      You do not have to rush to be held.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
