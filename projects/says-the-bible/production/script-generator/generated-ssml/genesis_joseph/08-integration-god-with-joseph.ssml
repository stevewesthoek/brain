<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      Now the story can grow quieter.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      Only the truths that remained beneath every scene.<break time="1800ms"/>

      God was with Joseph in the house of his father.<break time="1800ms"/>
      God was with Joseph on the road to Egypt.<break time="1800ms"/>
      God was with Joseph in Potiphar's house.<break time="1800ms"/>
      God was with Joseph in prison.<break time="1800ms"/>
      God was with Joseph in the years no one hurried.<break time="1800ms"/>
      God was with Joseph when the answer came.<break time="1800ms"/>

      His presence was not limited to low places.<break time="1800ms"/>
      His presence was not limited to high places.<break time="1800ms"/>
      His presence was not limited to quick answers.<break time="1800ms"/>

      The pit did not erase God's presence.<break time="1800ms"/>
      The prison did not erase God's presence.<break time="1800ms"/>
      The waiting did not erase God's presence.<break time="1800ms"/>

      You are not forgotten in waiting.<break time="3800ms"/>
      The hidden years are not empty to God.<break time="1800ms"/>
      The slow years are not wasted to God.<break time="1800ms"/>
      You are safe in God's care.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
