<!--ID=B7267351-473F-409D-9765-754A8EBCDE05;Version=1|{"VoiceNameToIdMapItems":[{"Id":"f1b99834-fbfc-4d32-846d-c4dbd3050c19","Name":"Microsoft Server Speech Text to Speech Voice (en-GB, OllieMultilingualNeural)","ShortName":"en-GB-OllieMultilingualNeural","Locale":"en-GB","VoiceType":"StandardVoice"}]}-->
<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
            He finds the sheep.
            <break time="1800ms"/>
            And notice what he does not do.
            <break time="1800ms"/>
            He does not scold it.
            <break time="1000ms"/>
            He does not stand over it and wait for it to get up.
            <break time="1000ms"/>
            He does not point it back toward the path and say, walk.
            <break time="1800ms"/>
            He lays it on his shoulders.
            <break time="1800ms"/>
            The sheep, worn out from wandering,
            <break time="500ms"/>
            possibly injured,
            <break time="500ms"/>
            possibly too frightened to move,
            <break time="1000ms"/>
            is lifted.
            <break time="1800ms"/>
            Not led.
            <break time="1000ms"/>
            Carried.
            <break time="1800ms"/>
            The shepherd bears the weight.
            <break time="1000ms"/>
            The sheep contributes nothing to the journey home
            <break time="500ms"/>
            except its presence.
            <break time="1800ms"/>
            And the shepherd is rejoicing as he walks.
            <break time="1000ms"/>
            Not relieved that it is over.
            <break time="500ms"/>
            Not frustrated by the time it took.
            <break time="1000ms"/>
            Rejoicing.
            <break time="1800ms"/>
            There is something in this detail that asks to be received.
            <break time="1000ms"/>
            You do not have to earn your way back.
            <break time="1000ms"/>
            You do not have to be strong enough to walk.
            <break time="1800ms"/>
            The shepherd carries.
            <break time="1000ms"/>
            The shepherd rejoices.
            <break time="1000ms"/>
            The weight is his.
            <break time="1000ms"/>
            The joy is his.
            <break time="1800ms"/>
            And you are on his shoulders.
    </prosody>
  </voice>
</speak>
