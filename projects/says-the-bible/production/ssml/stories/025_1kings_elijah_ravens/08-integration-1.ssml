<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
      Now the story can grow quieter.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      Only the truths that remained beneath every scene.<break time="1800ms"/>

      The ravens came morning and evening.<break time="1800ms"/>
      The brook gave water.<break time="1800ms"/>
      The jar did not empty.<break time="1800ms"/>
      The oil did not run dry.<break time="1800ms"/>
      God provided.<break time="3800ms"/>

      He provided through wild birds in a ravine.<break time="1800ms"/>
      He provided through a widow with almost nothing left.<break time="1800ms"/>
      He provided not in the way anyone would have planned.<break time="1800ms"/>
      But He provided.<break time="3800ms"/>

      You are held by the same provision.<break time="1800ms"/>
      The same God who fed Elijah by the brook.<break time="1800ms"/>
      The same God who kept the jar from emptying.<break time="1800ms"/>
      He knows what you need.<break time="3800ms"/>

      Enough for today.<break time="1800ms"/>
      That is the word beneath this story.<break time="1800ms"/>
      Not enough for every fear. Not enough for every worry.<break time="1800ms"/>
      But enough for today.<break time="3800ms"/>

      You are provided for.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
