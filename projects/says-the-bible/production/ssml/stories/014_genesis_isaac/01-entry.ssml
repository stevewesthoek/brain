<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Take a slow breath in.<break time="500ms"/>
      And let it out.<break time="1000ms"/>
      Again, breathe in.<break time="500ms"/>
      And breathe out.<break time="1800ms"/>
      Let your body grow heavy against wherever you are resting.<break time="500ms"/>
      Let your hands be still.<break time="500ms"/>
      Let the noise of the day fall away.<break time="1000ms"/>
      There is nothing you need to hold onto right now.<break time="1800ms"/>
      Tonight we will hear the story of Isaac and Rebekah, from Genesis chapter twenty-four.<break time="500ms"/>
      It is one of the longest chapters in all of Genesis, and one of the most gentle.<break time="500ms"/>
      It is a story of a prayer answered at a well.<break time="500ms"/>
      Of faithfulness rewarded with open arms.<break time="500ms"/>
      Of love found not by chance, but in God's own quiet timing.<break time="1000ms"/>
      An old father sends a trusted servant on a long journey.<break time="500ms"/>
      A young woman offers water to a stranger.<break time="500ms"/>
      And God weaves their stories together in the cool of an evening field.<break time="1800ms"/>
      You do not need to follow every detail.<break time="500ms"/>
      You do not need to stay awake for all of it.<break time="500ms"/>
      You can let the story carry you slowly.<break time="1800ms"/>
    </prosody>
  </voice>
</speak>
