<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            Now the story can become simple.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      The same truth remains.<break time="1800ms"/>
      The prayer was heard.<break time="1800ms"/>
      The journey was not in vain.<break time="1800ms"/>
      Kindness was the sign.<break time="1800ms"/>
      Rebekah chose to go.<break time="1800ms"/>
      Isaac waited in the field.<break time="1800ms"/>
      God brought them together.<break time="1800ms"/>
      Nothing was left to chance.<break time="3800ms"/>
      The servant trusted and was led.<break time="3800ms"/>
      The father prayed and was answered.<break time="3800ms"/>
      The young woman said yes and was blessed.<break time="3800ms"/>
      You do not have to carry anything more from the story.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
