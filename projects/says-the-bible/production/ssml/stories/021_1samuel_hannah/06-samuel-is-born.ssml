<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.50%" pitch="-2.90%">
      They rose early in the morning and worshipped before the Lord.<break time="500ms"/>
      Then they returned home to Ramah.<break time="1000ms"/>
      And the Lord remembered Hannah.<break time="1800ms"/>

      In due time she conceived and bore a son.<break time="500ms"/>
      She called his name Samuel.<break time="500ms"/>
      Because, she said, I have asked for him from the Lord.<break time="1800ms"/>

      The name itself held the prayer inside it.<break time="500ms"/>
      Samuel. Asked of God.<break time="500ms"/>
      Every time she spoke his name, she remembered the answer.<break time="1800ms"/>

      Hannah nursed him.<break time="500ms"/>
      She held him close through the early months and years.<break time="500ms"/>
      She cared for him with the tenderness of a woman who had waited a very long time.<break time="1800ms"/>

      When the child was weaned, she brought him up to Shiloh.<break time="500ms"/>
      She brought a three-year-old bull, flour, and a skin of wine.<break time="500ms"/>
      A sacrifice to go with the offering of her son.<break time="1000ms"/>
      The child was young.<break time="500ms"/>
      And she brought him to the house of the Lord.<break time="1800ms"/>

      She had asked for him.<break time="500ms"/>
      God had given him.<break time="500ms"/>
      And now she would give him back.<break time="1000ms"/>
      Not out of duty, but out of the same faith that had carried her prayer in the first place.<break time="1800ms"/>

      God remembers.<break time="500ms"/>
      God answers in the fullness of time.<break time="1000ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
