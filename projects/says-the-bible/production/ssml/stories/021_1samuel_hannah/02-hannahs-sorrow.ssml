<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.25%" pitch="-2.25%">
      There was a man from the hill country of Ephraim.<break time="500ms"/>
      His name was Elkanah.<break time="500ms"/>
      And he had two wives.<break time="1000ms"/>
      One was called Peninnah, and the other was called Hannah.<break time="1800ms"/>

      Peninnah had children.<break time="500ms"/>
      Sons and daughters filled her home with noise and motion.<break time="1000ms"/>
      But Hannah had no children.<break time="500ms"/>
      The Lord had closed her womb.<break time="1800ms"/>

      Year after year the family went up to Shiloh to worship the Lord of hosts.<break time="500ms"/>
      Year after year they offered their sacrifice.<break time="500ms"/>
      And year after year the same sorrow followed Hannah like a shadow she could not outrun.<break time="1800ms"/>

      Peninnah provoked her.<break time="500ms"/>
      She made it sharp.<break time="500ms"/>
      She reminded Hannah of what was missing, again and again, until Hannah wept.<break time="1000ms"/>
      And she could not eat.<break time="1800ms"/>

      The feast was set before her, but her appetite was gone.<break time="500ms"/>
      The worship continued around her, but the ache sat heavy in her chest.<break time="1000ms"/>
      She carried it quietly, the way some griefs must be carried.<break time="1800ms"/>

      Not every sorrow has a quick answer.<break time="500ms"/>
      Not every prayer is answered in the same season it is spoken.<break time="1000ms"/>
      But the sorrow is still seen.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
