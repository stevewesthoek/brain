<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Take a slow breath in.<break time="500ms"/>
      And let it out.<break time="1000ms"/>
      Again, breathe in.<break time="500ms"/>
      And breathe out.<break time="1800ms"/>
      Let your shoulders loosen.<break time="500ms"/>
      Let your forehead soften.<break time="1000ms"/>
      There is nothing you need to prove right now.<break time="1800ms"/>
      Tonight we will move through the book of Ruth, one of the quietest stories in all of Scripture.<break time="500ms"/>
      It is not a story of great battles or parting seas.<break time="500ms"/>
      It is a story of loyalty, of kindness, and of God's gentle provision through ordinary faithfulness.<break time="1000ms"/>
      A young woman chooses to stay with her mother-in-law when she has every reason to leave.<break time="500ms"/>
      A man notices her in a field and decides to protect her.<break time="500ms"/>
      And through their quiet obedience, God weaves something far greater than either of them could see.<break time="1800ms"/>
      You do not need to rush ahead of the words.<break time="500ms"/>
      You can simply listen and receive.<break time="1000ms"/>
      You do not have to hold every detail in your mind.<break time="500ms"/>
      You can let the story carry you slowly.<break time="1800ms"/>
    </prosody>
  </voice>
</speak>
