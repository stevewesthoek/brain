<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            Now the story can become simple.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      The same truth remains.<break time="1800ms"/>
      God is faithful in the ordinary.<break time="1800ms"/>
      Naomi lost everything.<break time="1800ms"/>
      Ruth chose to stay.<break time="1800ms"/>
      Boaz chose to be kind.<break time="1800ms"/>
      God chose to provide through their faithfulness.<break time="1800ms"/>
      Where you go, I will go.<break time="1800ms"/>
      Your people shall be my people.<break time="1800ms"/>
      Your God, my God.<break time="1800ms"/>
      You are not alone in the field.<break time="3800ms"/>
      You are not forgotten on the road.<break time="3800ms"/>
      You do not have to carry anything more from the story.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
