<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
      Let your body settle.<break time="1800ms"/>
      Take a slow breath in.<break time="1000ms"/>
      And let it go.<break time="1800ms"/>
      Again.<break time="1000ms"/>
      Breathe in gently.<break time="1000ms"/>
      And release.<break time="3800ms"/>
      Tonight we rest in Psalm 121.<break time="1800ms"/>
      A song of pilgrimage.<break time="1800ms"/>
      A song carried by travelers on a long road,<break time="1000ms"/>
      eyes lifted toward the horizon.<break time="3800ms"/>
      "I lift my eyes to the hills."<break time="1800ms"/>
      From where does my help come?<break time="3800ms"/>
      It is one of the oldest questions of the human heart.<break time="1800ms"/>
      Asked on roads, in darkness, in uncertainty.<break time="1800ms"/>
      And the psalm answers it simply.<break time="3800ms"/>
      Help comes from the Lord,<break time="1000ms"/>
      who made heaven and earth.<break time="3800ms"/>
      The maker of every mountain and every star<break time="1000ms"/>
      is the one who keeps you.<break time="3800ms"/>
      You do not need to climb to find Him.<break time="1800ms"/>
      You do not need to reach.<break time="1800ms"/>
      He is already watching.<break time="1800ms"/>
      He does not sleep.<break time="3800ms"/>
      So tonight,<break time="1000ms"/>
      let the words of this psalm settle over you<break time="1000ms"/>
      like a covering.<break time="1800ms"/>
      You can let the words carry you slowly.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
