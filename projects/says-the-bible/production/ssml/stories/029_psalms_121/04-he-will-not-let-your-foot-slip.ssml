<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.75%" pitch="-2.60%">
      "He will not let your foot be moved."<break time="3800ms"/>
      Think of what that means on a mountain path.<break time="1800ms"/>
      The stone is uneven.<break time="500ms"/>
      The edge is close.<break time="500ms"/>
      One wrong step and everything shifts.<break time="1800ms"/>
      And the psalm says:<break time="500ms"/>
      He will not let your foot be moved.<break time="3800ms"/>
      Not because the path is easy.<break time="1000ms"/>
      Not because there are no steep places.<break time="1800ms"/>
      But because someone is watching every step.<break time="3800ms"/>
      "He who keeps you will not slumber."<break time="3800ms"/>
      We sleep because we must.<break time="1000ms"/>
      At some point every human body gives out.<break time="500ms"/>
      The eyes close.<break time="500ms"/>
      The mind goes quiet.<break time="1800ms"/>
      We cannot watch through the night.<break time="500ms"/>
      We cannot hold ourselves alert forever.<break time="3800ms"/>
      But He can.<break time="1800ms"/>
      He who keeps you does not need sleep.<break time="1800ms"/>
      He does not get tired.<break time="500ms"/>
      He does not drift off<break time="500ms"/>
      and miss a moment of your need.<break time="3800ms"/>
      Right now, as you lie still,<break time="1000ms"/>
      as your body begins to let go,<break time="1800ms"/>
      there is a keeper who is fully awake.<break time="3800ms"/>
      Watching over you.<break time="500ms"/>
      Attending to what you cannot attend to yourself.<break time="1800ms"/>
      The path may be steep.<break time="500ms"/>
      The night may be long.<break time="1000ms"/>
      But the foot will not slip.<break time="1000ms"/>
      The keeper does not sleep.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
