<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
      "He who keeps Israel<break time="500ms"/>
      will neither slumber nor sleep."<break time="3800ms"/>
      The psalm says it twice now.<break time="1800ms"/>
      First: he who keeps you will not slumber.<break time="1000ms"/>
      Then: he who keeps Israel will neither slumber nor sleep.<break time="3800ms"/>
      This is not an accident.<break time="1800ms"/>
      The repetition is deliberate.<break time="1000ms"/>
      The psalm wants you to be sure of this.<break time="3800ms"/>
      Ancient cities had watchmen.<break time="1800ms"/>
      Men stationed on the walls through the dark hours.<break time="1000ms"/>
      Their job was to stay awake while everyone else rested.<break time="1800ms"/>
      To watch for what might come in the night.<break time="1000ms"/>
      To call out if danger approached.<break time="3800ms"/>
      But watchmen were human.<break time="1800ms"/>
      They grew tired.<break time="500ms"/>
      They nodded off.<break time="500ms"/>
      There were gaps in the watch.<break time="1800ms"/>
      Moments when no one was fully alert.<break time="3800ms"/>
      God is not that kind of watchman.<break time="1800ms"/>
      He does not close His eyes.<break time="500ms"/>
      He does not drift into drowsiness<break time="500ms"/>
      in the last hour before dawn.<break time="1800ms"/>
      He is as fully awake in the middle of the night<break time="500ms"/>
      as He is at noon.<break time="3800ms"/>
      Right now, this moment,<break time="1000ms"/>
      while you close your eyes,<break time="1800ms"/>
      God is not closing His.<break time="1800ms"/>
      He is the watchman who never tires.<break time="1000ms"/>
      The keeper who never falters.<break time="1800ms"/>
      You can sleep<break time="500ms"/>
      because He will not.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
