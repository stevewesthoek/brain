<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.75%" pitch="-3.10%">
      Even after the name and the signs, Moses still hesitated.<break time="500ms"/>
      He said, O Lord, I am not eloquent.<break time="500ms"/>
      I am slow of speech and slow of tongue.<break time="1800ms"/>

      God answered, who has made man's mouth?<break time="500ms"/>
      Is it not I, the Lord?<break time="1000ms"/>
      Now go, and I will be with your mouth and teach you what to speak.<break time="1800ms"/>

      Still Moses asked, please send someone else.<break time="500ms"/>
      And God's anger kindled, but he did not take back the call.<break time="1000ms"/>
      Instead he gave Moses his brother Aaron as a spokesman.<break time="500ms"/>
      You shall speak to Aaron, and he shall speak to the people.<break time="1800ms"/>

      So Moses went back to Jethro and said, let me return to Egypt to see whether my brothers are still alive.<break time="500ms"/>
      And Jethro said, go in peace.<break time="1800ms"/>

      Moses took his wife and his sons.<break time="500ms"/>
      He took the staff of God in his hand.<break time="500ms"/>
      And he set out for Egypt.<break time="1800ms"/>

      He carried with him the name of God.<break time="500ms"/>
      He carried the promise of deliverance.<break time="500ms"/>
      He carried the memory of a fire that burned but did not consume.<break time="1800ms"/>

      The bush had stopped burning.<break time="500ms"/>
      But the word of God had not stopped speaking.<break time="1000ms"/>
      It was alive in Moses as he walked.<break time="500ms"/>
      And it is alive still.<break time="1800ms"/>

      You are held by that same word tonight.<break time="500ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
