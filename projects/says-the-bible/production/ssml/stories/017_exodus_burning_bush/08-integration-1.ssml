<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
      Now the story can grow quieter.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      Only the truths that remained beneath every scene.<break time="3800ms"/>

      The ground was holy.<break time="1800ms"/>
      The bush burned and was not consumed.<break time="1800ms"/>
      The fire was gentle and did not destroy.<break time="3800ms"/>

      God called Moses by name.<break time="1800ms"/>
      Not by title, not by role.<break time="1800ms"/>
      By his own name, spoken twice.<break time="3800ms"/>

      God heard the cry of his people.<break time="1800ms"/>
      He saw their affliction.<break time="1800ms"/>
      He knew their sufferings.<break time="1800ms"/>
      And he came down.<break time="3800ms"/>

      You are known by name tonight.<break time="1800ms"/>
      You are heard tonight.<break time="1800ms"/>
      Not from far away, but close.<break time="1800ms"/>
      The way a voice comes from a bush on a quiet hillside.<break time="3800ms"/>

      The ground is holy.<break time="1800ms"/>
      God knows your name.<break time="3800ms"/>
      You are heard.<break time="1800ms"/>
      You are held.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
