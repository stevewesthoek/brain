<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
      Then God spoke from the fire.<break time="500ms"/>
      I am the God of your father.<break time="500ms"/>
      The God of Abraham, the God of Isaac, and the God of Jacob.<break time="1800ms"/>

      I have surely seen the affliction of my people who are in Egypt.<break time="500ms"/>
      I have heard their cry because of their taskmasters.<break time="1000ms"/>
      I know their sufferings.<break time="1800ms"/>

      Three things God said he had done.<break time="500ms"/>
      He had seen.<break time="500ms"/>
      He had heard.<break time="500ms"/>
      He knew.<break time="1800ms"/>

      And then a fourth.<break time="500ms"/>
      I have come down to deliver them.<break time="1000ms"/>
      God did not only observe from a distance.<break time="500ms"/>
      He came down.<break time="1800ms"/>

      And he said to Moses, come, I will send you to Pharaoh.<break time="500ms"/>
      That you may bring my people out of Egypt.<break time="1800ms"/>

      Moses answered quietly.<break time="500ms"/>
      Who am I that I should go to Pharaoh?<break time="1000ms"/>
      Who am I that I should bring the children of Israel out of Egypt?<break time="1800ms"/>

      He did not feel ready.<break time="500ms"/>
      He did not feel qualified.<break time="500ms"/>
      He had been a shepherd for forty years, not a leader of nations.<break time="1000ms"/>
      But God did not call him because he was ready.<break time="500ms"/>
      God called him because God had heard the cry.<break time="1800ms"/>

      You are heard tonight as well.<break time="500ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
