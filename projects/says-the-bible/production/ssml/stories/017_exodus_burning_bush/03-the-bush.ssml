<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.50%" pitch="-2.50%">
      One day Moses led the flock to the far side of the wilderness.<break time="500ms"/>
      Past the familiar paths, past the usual grazing grounds.<break time="500ms"/>
      He came to Horeb, the mountain of God.<break time="1000ms"/>
      Though he did not yet know it by that name.<break time="1800ms"/>

      There, on the mountainside, he saw something strange.<break time="500ms"/>
      A bush was burning with fire.<break time="500ms"/>
      The flames moved through the branches, bright and alive.<break time="1000ms"/>
      But the bush was not consumed.<break time="1800ms"/>

      The leaves did not curl and blacken.<break time="500ms"/>
      The thorns did not crumble to ash.<break time="500ms"/>
      The fire burned steadily, gently, as though it belonged there.<break time="1000ms"/>
      As though the bush and the flame were at peace with one another.<break time="1800ms"/>

      Moses stopped.<break time="500ms"/>
      He said to himself, I will turn aside to see this great sight.<break time="1000ms"/>
      Why is the bush not burned up?<break time="1800ms"/>

      He did not keep walking.<break time="500ms"/>
      He did not look away and continue with his sheep.<break time="500ms"/>
      He turned toward the strange and quiet fire.<break time="1000ms"/>
      And that turning was the beginning of everything.<break time="1800ms"/>

      Sometimes the most important moment is simply the decision to look.<break time="1000ms"/>
      To pause and pay attention to what God is doing nearby.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
