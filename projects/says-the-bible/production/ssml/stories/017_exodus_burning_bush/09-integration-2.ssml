<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The fire was gentle.<break time="1800ms"/>
      It did not consume the bush.<break time="1800ms"/>
      It did not scorch the ground.<break time="1800ms"/>
      It burned with a warmth that held rather than destroyed.<break time="3800ms"/>

      The ground held Moses.<break time="1800ms"/>
      Bare feet on the earth, and the earth was steady.<break time="1800ms"/>
      Holy ground does not shift or give way.<break time="1800ms"/>
      It holds you where you stand.<break time="3800ms"/>

      God's voice was near.<break time="1800ms"/>
      Not distant thunder, not a roar from the sky.<break time="1800ms"/>
      A voice from a bush, close enough to answer.<break time="1800ms"/>
      Close enough to hear your breath.<break time="3800ms"/>

      You are standing on ground that is held.<break time="1800ms"/>
      You can take off the weight.<break time="1800ms"/>
      The way Moses took off his sandals.<break time="1800ms"/>
      You can set down what you have been carrying.<break time="3800ms"/>

      Let your thoughts grow smaller now.<break time="1800ms"/>
      Let your breathing slow.<break time="1800ms"/>
      Let the fire be gentle around you.<break time="3800ms"/>

      The ground is holy.<break time="1800ms"/>
      God knows your name.<break time="3800ms"/>
      The fire is gentle.<break time="1800ms"/>
      You are heard.<break time="1800ms"/>
      You are held.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
