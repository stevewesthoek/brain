<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            Now the story can become simple.<break time="1800ms"/>
      No new scene is needed.<break time="1800ms"/>
      The same truth remains.<break time="1800ms"/>
      The valley is quiet.<break time="1800ms"/>
      The giant has fallen.<break time="1800ms"/>
      The stone was enough.<break time="1800ms"/>
      God's name was enough.<break time="1800ms"/>
      David remembered the lion and the bear.<break time="1800ms"/>
      He stepped forward on the ground of God's faithfulness.<break time="1800ms"/>
      You are carried by the same faithfulness.<break time="3800ms"/>
      You do not face tomorrow alone.<break time="3800ms"/>
      The battle is the Lord's, and you can lay it down.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>