<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Take a slow breath in.<break time="500ms"/>
      And let it out.<break time="1000ms"/>
      Again, breathe in.<break time="500ms"/>
      And breathe out.<break time="1800ms"/>
      Let your shoulders loosen.<break time="500ms"/>
      Let your forehead soften.<break time="1000ms"/>
      There is nothing you need to carry right now.<break time="1800ms"/>
      Tonight we will follow the story of David and Goliath from First Samuel.<break time="500ms"/>
      It is the story of a shepherd boy who remembered God's faithfulness with the lion and the bear, and who stepped forward when grown men held back.<break time="1000ms"/>
      It is a story of a valley, a giant, and a single stone.<break time="500ms"/>
      It is a story of faith that does not calculate the odds but trusts the name of the Lord.<break time="500ms"/>
      The battle was never about size or strength.<break time="500ms"/>
      It was about who stood behind the boy with the sling.<break time="1800ms"/>
      You do not need to rush ahead of the words.<break time="500ms"/>
      You can simply listen and let the story settle over you.<break time="1000ms"/>
      You do not have to hold every detail in your mind.<break time="500ms"/>
      You can let the story carry you slowly.<break time="1800ms"/>
    </prosody>
  </voice>
</speak>