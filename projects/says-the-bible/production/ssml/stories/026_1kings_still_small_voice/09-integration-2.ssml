<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The mountain is quiet now.<break time="1800ms"/>
      The cave is still.<break time="1800ms"/>
      The voice has spoken.<break time="3800ms"/>

      You are held in the same gentleness that held Elijah.<break time="1800ms"/>
      The same God who brought bread to the wilderness brings rest to you now.<break time="1800ms"/>
      The same whisper that reached the mouth of the cave reaches you here.<break time="3800ms"/>

      The storm has passed.<break time="1800ms"/>
      You do not need to run any further.<break time="1800ms"/>
      You do not need to be strong any longer.<break time="1800ms"/>
      You can let go.<break time="3800ms"/>

      Let there be less effort now.<break time="1800ms"/>
      Less inner noise.<break time="1800ms"/>
      Less holding on.<break time="3800ms"/>

      Your breathing can follow the rhythm of the whisper.<break time="1800ms"/>
      In, and out.<break time="1800ms"/>
      Held, and known.<break time="1800ms"/>
      Quiet, and safe.<break time="3800ms"/>

      The storm has passed.<break time="1800ms"/>
      The whisper remains.<break time="1800ms"/>
      God is near.<break time="3800ms"/>
      You are held.<break time="1800ms"/>
      You are not alone.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
