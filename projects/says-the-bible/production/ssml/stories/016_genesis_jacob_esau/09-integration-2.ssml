<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The river is crossed.<break time="1800ms"/>
      The night is behind you.<break time="1800ms"/>
      The long wrestling has ended.<break time="3800ms"/>

      You have been held through the struggle.<break time="1800ms"/>
      Through the dark hours when nothing was clear.<break time="1800ms"/>
      Through the fear of what waited on the other side.<break time="3800ms"/>

      You are held now.<break time="1800ms"/>
      Not because the struggle was easy.<break time="1800ms"/>
      Not because everything has been resolved.<break time="1800ms"/>
      But because the One who met Jacob in the dark meets you as well.<break time="3800ms"/>

      You can let go of what you have been gripping.<break time="1800ms"/>
      You can let go of the fear.<break time="1800ms"/>
      You can let go of the need to fix everything tonight.<break time="3800ms"/>

      Let your thoughts grow quieter now.<break time="1800ms"/>
      Let your breathing slow.<break time="1800ms"/>
      Let the story settle into one simple truth.<break time="3800ms"/>

      The dawn has come.<break time="1800ms"/>
      You are at peace.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
