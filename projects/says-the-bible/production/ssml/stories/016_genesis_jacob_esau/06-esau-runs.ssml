<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.50%" pitch="-2.90%">
      Jacob lifted his eyes and saw Esau coming.<break time="500ms"/>
      Four hundred men moved with him across the plain.<break time="1000ms"/>
      The dust rose behind them in the morning light.<break time="1800ms"/>

      Jacob arranged his family behind him.<break time="500ms"/>
      The servants and their children first.<break time="500ms"/>
      Then Leah and her children.<break time="500ms"/>
      Then Rachel and Joseph last of all.<break time="1800ms"/>

      And then Jacob himself went on ahead of them.<break time="500ms"/>
      He walked toward his brother.<break time="500ms"/>
      Alone.<break time="1000ms"/>
      Limping.<break time="1800ms"/>

      He bowed himself to the ground.<break time="500ms"/>
      Seven times he bowed as he approached his brother.<break time="1000ms"/>
      Each bow an offering of humility.<break time="500ms"/>
      Each bow a wordless apology carried across twenty years.<break time="1800ms"/>

      But Esau ran to meet him.<break time="1000ms"/>
      Esau ran.<break time="1800ms"/>

      He threw his arms around Jacob's neck.<break time="500ms"/>
      He fell upon him.<break time="500ms"/>
      He kissed him.<break time="1000ms"/>
      And they wept.<break time="1800ms"/>

      The four hundred men stood still.<break time="500ms"/>
      The wives and children watched from a distance.<break time="500ms"/>
      And two brothers held each other in the dust and the light and the tears.<break time="1800ms"/>

      The fear that had kept Jacob awake for days was gone in a moment.<break time="500ms"/>
      Esau did not come with anger.<break time="500ms"/>
      He came with open arms.<break time="1000ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
