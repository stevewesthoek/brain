<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.75%" pitch="-3.10%">
            At this moment the disciples return and they are amazed to find Jesus talking with a woman.<break time="500ms"/>
            But no one asks why.<break time="500ms"/>
            No one questions him.<break time="1800ms"/>
            And the woman — she leaves her water jar.<break time="1000ms"/>
            The very thing she came to fill, she leaves behind at the well.<break time="1800ms"/>
            She goes back into the town.<break time="500ms"/>
            And she says to everyone she can find:<break time="500ms"/>
            Come and see a man who told me everything I ever did.<break time="500ms"/>
            Could this be the Messiah?<break time="1800ms"/>
            The woman who came alone to avoid people goes back and calls people together.<break time="1000ms"/>
            The woman carrying shame becomes the one carrying news.<break time="1800ms"/>
            And the people of the town come out to see Jesus.<break time="1000ms"/>
            Many believe because of what she says.<break time="1800ms"/>
            And then they ask him to stay.<break time="1000ms"/>
            He stays two days.<break time="1800ms"/>
            And many more believe because of his own words.<break time="1000ms"/>
            And they say to the woman: We no longer believe just because of what you said.<break time="500ms"/>
            We have heard for ourselves.<break time="500ms"/>
            And we know that this man really is the Savior of the world.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
