<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Breathe in slowly.<break time="1800ms"/>
            And breathe out.<break time="3800ms"/>
            Again — breathe in.<break time="1800ms"/>
            And let it go.<break time="3800ms"/>
            You are here.<break time="1000ms"/>
            You are safe.<break time="1000ms"/>
            Let your body settle.<break time="3800ms"/>
            Tonight we go to a well in Samaria.<break time="1000ms"/>
            A stone well in the middle of the day.<break time="1000ms"/>
            The sun is high.<break time="500ms"/>
            The air is still.<break time="1800ms"/>
            A woman comes alone to draw water.<break time="1000ms"/>
            A man is sitting there, tired from a long journey.<break time="1800ms"/>
            They are from different worlds.<break time="1000ms"/>
            They should not speak.<break time="1800ms"/>
            But something is about to happen that will change her life forever.<break time="3800ms"/>
            This is the story of the woman at the well, from the Gospel of John, chapter four.<break time="1800ms"/>
            A conversation at noon that changed everything.<break time="1000ms"/>
            Living water — offered to one who came only to draw from a well.<break time="3800ms"/>
            The well is quiet.<break time="1000ms"/>
            Living water is given.<break time="1000ms"/>
            You are known and loved.<break time="1000ms"/>
            You are held.<break time="1000ms"/>
            Your thirst is met.<break time="1000ms"/>
            You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
