<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
            Then Jesus says something that shifts everything.<break time="500ms"/>
            He says: Go, call your husband, and come back here.<break time="1800ms"/>
            She says, quietly: I have no husband.<break time="1800ms"/>
            And Jesus says: You are right when you say you have no husband.<break time="500ms"/>
            The fact is, you have had five husbands.<break time="500ms"/>
            And the man you are with now is not your husband.<break time="500ms"/>
            What you have said is true.<break time="1800ms"/>
            There is a long silence in this moment.<break time="1000ms"/>
            He knows her.<break time="500ms"/>
            He has never met her before and yet he knows her completely.<break time="1800ms"/>
            Every marriage.<break time="500ms"/>
            Every loss.<break time="500ms"/>
            Every arrangement made from necessity or loneliness or desperation.<break time="1000ms"/>
            Every reason she comes to this well at noon instead of morning.<break time="1800ms"/>
            And he does not flinch.<break time="500ms"/>
            He does not condemn.<break time="500ms"/>
            He simply names what is true and stays.<break time="1800ms"/>
            She sees immediately that he is a prophet.<break time="1000ms"/>
            Someone sent from God who can see past all of it.<break time="500ms"/>
            And rather than run, she leans in further.<break time="500ms"/>
            She wants to understand more.<break time="500ms"/>
            She asks him about worship.<break time="1000ms"/>
            About where God is really found.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
