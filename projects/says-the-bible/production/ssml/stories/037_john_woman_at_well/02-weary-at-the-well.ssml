<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.25%" pitch="-2.25%">
            Jesus and his disciples are traveling south through Samaria.<break time="500ms"/>
            It is a route most Jews avoided — they went around.<break time="1000ms"/>
            The Samaritans and Jews had deep hostility between them.<break time="500ms"/>
            Old wounds from centuries of division.<break time="1800ms"/>
            But Jesus goes through.<break time="1000ms"/>
            And the journey is long and the road is dusty and the sun is unrelenting.<break time="1800ms"/>
            They come to a place called Sychar.<break time="500ms"/>
            Near a plot of ground that Jacob had given to his son Joseph long ago.<break time="1000ms"/>
            And there is Jacob's well.<break time="1800ms"/>
            The disciples go into town to buy food.<break time="1000ms"/>
            Jesus stays.<break time="1000ms"/>
            He sits down beside the well.<break time="1800ms"/>
            The Gospel says simply that he was tired from the journey.<break time="1000ms"/>
            The Son of God — tired.<break time="500ms"/>
            Weary in his body the way any man is weary after a long road.<break time="1800ms"/>
            It is the sixth hour.<break time="500ms"/>
            Noon.<break time="500ms"/>
            The hottest part of the day.<break time="1000ms"/>
            The sun bearing down on the stone of the well and the dry earth all around.<break time="1800ms"/>
            He sits there, alone, in the heat, waiting.<break time="1000ms"/>
            Not performing, not preaching.<break time="500ms"/>
            Just resting at a well in the middle of an ordinary afternoon.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
