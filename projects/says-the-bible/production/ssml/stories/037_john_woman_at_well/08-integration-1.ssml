<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            He sat at the well.<break time="1800ms"/>
            Tired from the road.<break time="1800ms"/>
            He asked for water.<break time="1800ms"/>
            And in asking, he gave something far greater.<break time="3800ms"/>
            He gave living water.<break time="1800ms"/>
            A spring that does not run dry.<break time="1800ms"/>
            Water that goes all the way down to the thirst beneath the thirst.<break time="3800ms"/>
            He knew her story.<break time="1800ms"/>
            Every chapter of it.<break time="1800ms"/>
            And he loved her fully.<break time="3800ms"/>
            You are known in the same way.<break time="1800ms"/>
            Every chapter of your life is seen.<break time="1800ms"/>
            And you are offered the same water.<break time="3800ms"/>
            Your deepest thirst — the one beneath all the others — is met.<break time="1800ms"/>
            You do not have to come to the well alone anymore.<break time="3800ms"/>
            You are known.<break time="1800ms"/>
            You are loved.<break time="1800ms"/>
            You are offered the living water.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
