<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.50%" pitch="-2.50%">
            While Jesus sits at the well, a woman comes to draw water.<break time="500ms"/>
            She is a Samaritan.<break time="1000ms"/>
            And the hour is unusual — most women came in the cool of early morning or the late evening.<break time="1000ms"/>
            They came in groups, together, and talked while the water was drawn.<break time="1800ms"/>
            But this woman comes alone.<break time="500ms"/>
            At noon.<break time="500ms"/>
            In the heat.<break time="1800ms"/>
            There is something in that detail.<break time="1000ms"/>
            Avoidance.<break time="500ms"/>
            The weight of a life she perhaps didn't want to explain.<break time="1800ms"/>
            She comes with her jar to draw water, and she finds a Jewish man sitting at the well.<break time="1000ms"/>
            She says nothing to him.<break time="500ms"/>
            He is not supposed to speak to her either.<break time="1800ms"/>
            But Jesus speaks first.<break time="1000ms"/>
            He says simply: Give me a drink.<break time="1800ms"/>
            The woman is startled.<break time="500ms"/>
            She says: How is it that you, a Jew, are asking me, a Samaritan woman, for a drink?<break time="1000ms"/>
            Because Jews have no dealings with Samaritans.<break time="1000ms"/>
            He has crossed two barriers with one sentence — race and gender.<break time="500ms"/>
            He asks her for something.<break time="500ms"/>
            He needs her.<break time="1000ms"/>
            Or at least, that is how he begins.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
