<!--ID=B7267351-473F-409D-9765-754A8EBCDE05;Version=1|{"VoiceNameToIdMapItems":[{"Id":"f1b99834-fbfc-4d32-846d-c4dbd3050c19","Name":"Microsoft Server Speech Text to Speech Voice (en-GB, OllieMultilingualNeural)","ShortName":"en-GB-OllieMultilingualNeural","Locale":"en-GB","VoiceType":"StandardVoice"}]}-->
<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.25%" pitch="-2.25%">
      The psalm opens with a declaration, not a request.<break time="500ms"/>
      God is our refuge and strength.<break time="1000ms"/>
      A very present help in trouble.<break time="1800ms"/>

      Notice the order.<break time="500ms"/>
      The psalmist does not begin by describing the trouble.<break time="500ms"/>
      He begins by naming the refuge.<break time="1000ms"/>
      Before the shaking is mentioned, the shelter is already standing.<break time="1800ms"/>

      Refuge means a place you go when there is nowhere else to go.<break time="500ms"/>
      Not a last resort, but the truest resort.<break time="500ms"/>
      The place that was always meant to hold you.<break time="1000ms"/>
      The place you were always meant to return to.<break time="1800ms"/>

      And strength.<break time="500ms"/>
      Not your strength, gathered from effort and willpower.<break time="500ms"/>
      But a strength offered freely.<break time="500ms"/>
      The kind that meets you when your own has run out.<break time="1800ms"/>

      A very present help.<break time="500ms"/>
      Not a distant help.<break time="500ms"/>
      Not a theoretical help.<break time="500ms"/>
      Not a help that might arrive eventually.<break time="1000ms"/>
      Present.<break time="500ms"/>
      Here.<break time="500ms"/>
      Now.<break time="1800ms"/>

      This is the foundation on which everything else in the psalm rests.<break time="500ms"/>
      Before the mountains shake.<break time="500ms"/>
      Before the waters roar.<break time="500ms"/>
      Before the nations rage.<break time="1000ms"/>
      God is already here.<break time="1800ms"/>

      The help is not coming.<break time="500ms"/>
      It is here.<break time="1000ms"/>
      God is our refuge.<break time="1800ms"/>
      The fortress holds.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
