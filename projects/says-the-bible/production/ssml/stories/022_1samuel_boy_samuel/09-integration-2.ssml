<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The temple is quiet.<break time="1800ms"/>
      The lamp is low.<break time="1800ms"/>
      The boy has heard.<break time="1800ms"/>
      You are held in the same stillness.<break time="3800ms"/>

      God is near.<break time="1800ms"/>
      You can let go.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>

      Let there be less effort now.<break time="1800ms"/>
      Less reaching.<break time="1800ms"/>
      Less trying to understand.<break time="3800ms"/>

      The lamp burns low.<break time="1800ms"/>
      God knows your name.<break time="1800ms"/>
      You are heard.<break time="1800ms"/>
      You are held.<break time="3800ms"/>

      The voice is near.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>

      Let your breathing carry you now.<break time="1800ms"/>
      In, and out.<break time="1800ms"/>
      Known, and held.<break time="1800ms"/>
      Quiet, and safe.<break time="3800ms"/>

      The lamp burns low.<break time="1800ms"/>
      God knows your name.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
