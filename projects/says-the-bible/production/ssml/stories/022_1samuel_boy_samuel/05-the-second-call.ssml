<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
      Again the Lord calls.<break time="1000ms"/>
      "Samuel."<break time="1800ms"/>

      Again the boy rises.<break time="500ms"/>
      Again he goes to Eli.<break time="500ms"/>
      "Here I am," he says, "for you called me."<break time="1800ms"/>

      And again the old priest says, "I did not call, my son.<break time="500ms"/>
      Lie down again."<break time="1800ms"/>

      So the boy returns to his place.<break time="500ms"/>
      He lies down in the dark once more.<break time="500ms"/>
      The lamp of God still burns above him.<break time="500ms"/>
      The stone walls hold their quiet.<break time="1800ms"/>

      The pattern repeats, and there is something tender in the repetition.<break time="500ms"/>
      The voice does not grow impatient.<break time="500ms"/>
      It does not give up after the first misunderstanding.<break time="500ms"/>
      It does not withdraw because the boy does not yet recognize it.<break time="1800ms"/>

      The voice is patient.<break time="1000ms"/>
      The boy is willing.<break time="1000ms"/>
      He simply does not yet know who is speaking.<break time="1800ms"/>

      And perhaps that is how it often is.<break time="500ms"/>
      God calls more than once.<break time="500ms"/>
      God does not lose interest when we do not understand right away.<break time="1000ms"/>
      The voice returns, gentle and unhurried, as many times as it takes.<break time="1800ms"/>

      Samuel lies still.<break time="500ms"/>
      The night continues.<break time="500ms"/>
      The voice will come again.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
