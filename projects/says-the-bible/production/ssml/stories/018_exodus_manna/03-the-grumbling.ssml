<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.50%" pitch="-2.50%">
      The people begin to grumble against Moses and Aaron.<break time="500ms"/>
      The complaint rises from the camps like dust stirred by many feet.<break time="1000ms"/>
      If only we had died by the hand of the Lord in Egypt.<break time="500ms"/>
      There we sat by the meat pots.<break time="500ms"/>
      There we ate bread to the full.<break time="1800ms"/>

      The words are sharp.<break time="500ms"/>
      They carry the particular bitterness of someone who was rescued but now feels forgotten.<break time="500ms"/>
      Memory has a way of softening what was hard and sharpening what is missing.<break time="1000ms"/>
      Egypt was bondage, but it had bread.<break time="500ms"/>
      The wilderness is freedom, but the stomachs are empty.<break time="1800ms"/>

      Moses and Aaron do not answer with anger.<break time="500ms"/>
      They know the grumbling is not truly against them.<break time="500ms"/>
      It is the cry of a people who cannot yet see how they will be cared for.<break time="1000ms"/>
      And that cry, however jagged its edges, reaches God.<break time="1800ms"/>

      God does not punish the complaint.<break time="500ms"/>
      He does not silence it with rebuke.<break time="500ms"/>
      He hears the hunger beneath the words.<break time="1000ms"/>
      He hears the fear beneath the hunger.<break time="500ms"/>
      And He begins to move toward them with a plan already forming.<break time="1800ms"/>

      Sometimes the loudest frustration is simply the voice of a need that has not yet been met.<break time="500ms"/>
      God is not offended by need.<break time="1000ms"/>
      He is already preparing the answer.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
