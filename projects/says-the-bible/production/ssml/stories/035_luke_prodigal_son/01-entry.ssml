<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
      Take a slow breath in.<break time="500ms"/>
      And let it out gently.<break time="1000ms"/>
      Again, breathe in.<break time="500ms"/>
      And breathe out.<break time="1800ms"/>

      Let your shoulders drop.<break time="500ms"/>
      Let your jaw unclench.<break time="500ms"/>
      Let the weight of the day begin to settle.<break time="1000ms"/>
      There is nowhere you need to be right now.<break time="1800ms"/>

      Tonight we will listen to a story from Luke.<break time="500ms"/>
      The story of the prodigal son.<break time="1000ms"/>
      A story of a son who left, and a father who waited, and a welcome that no one expected.<break time="1800ms"/>

      This is a story about distance and return.<break time="500ms"/>
      About the long road home and what is waiting at the end of it.<break time="1000ms"/>
      About a father who does not stand still when he sees his child coming.<break time="1800ms"/>

      He runs.<break time="1000ms"/>
      That is the heart of this story.<break time="500ms"/>
      The father runs.<break time="1800ms"/>

      You do not need to carry this story in your mind tonight.<break time="500ms"/>
      You only need to let it move around you slowly.<break time="500ms"/>
      One quiet sentence at a time.<break time="1000ms"/>
      One soft breath at a time.<break time="1800ms"/>

      Tonight, hold this as we begin.<break time="500ms"/>
      The father watches the road.<break time="500ms"/>
      The father runs to meet you.<break time="1000ms"/>
      You are welcomed home.<break time="1800ms"/>
    </prosody>
  </voice>
</speak>
