<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The feast has begun.<break time="1800ms"/>
      The robe is on your shoulders.<break time="3800ms"/>
      You are found.<break time="1800ms"/>
      You are loved extravagantly.<break time="9000ms"/>

      You can let go of the far country.<break time="1800ms"/>
      It has nothing left to hold you.<break time="3800ms"/>
      You have already turned toward home.<break time="1800ms"/>
      And home has already come running toward you.<break time="9000ms"/>

      The father runs to meet you.<break time="1800ms"/>
      You are welcomed home.<break time="3800ms"/>
      You are forgiven.<break time="1800ms"/>
      You are held.<break time="3800ms"/>
      The feast has begun.<break time="1800ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
