<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      His love is everlasting.<break time="1800ms"/>
      His mercy is complete.<break time="1800ms"/>
      You are held.<break time="1800ms"/>
      You are crowned with kindness.<break time="3800ms"/>

      You can let go of everything now.<break time="1800ms"/>
      Every weight.<break time="1800ms"/>
      Every question.<break time="1800ms"/>
      Every unfinished thought.<break time="3800ms"/>

      Let there be less effort now.<break time="1800ms"/>
      Less inner noise.<break time="1800ms"/>
      Less holding on.<break time="3800ms"/>

      He knows your frame.<break time="1800ms"/>
      He remembers that you are dust.<break time="1800ms"/>
      And He loves you still.<break time="3800ms"/>

      Your breathing can follow that truth.<break time="1800ms"/>
      In, and out.<break time="1800ms"/>
      Forgiven, and held.<break time="1800ms"/>
      Quiet, and crowned with kindness.<break time="3800ms"/>

      His mercy is great.<break time="1800ms"/>
      His love is everlasting.<break time="3800ms"/>
      You are forgiven.<break time="1800ms"/>
      You are held.<break time="1800ms"/>
      You are crowned with kindness.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
