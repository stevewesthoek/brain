<!--ID=B7267351-473F-409D-9765-754A8EBCDE05;Version=1|{"VoiceNameToIdMapItems":[{"Id":"f1b99834-fbfc-4d32-846d-c4dbd3050c19","Name":"Microsoft Server Speech Text to Speech Voice (en-GB, OllieMultilingualNeural)","ShortName":"en-GB-OllieMultilingualNeural","Locale":"en-GB","VoiceType":"StandardVoice"}]}-->
<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Take a slow breath in.
            <break time="1800ms"/>
            And breathe out.
            <break time="1800ms"/>
            Let your body settle.
            <break time="1800ms"/>
            Let the day begin to release.
            <break time="3800ms"/>
            Tonight we go to a very old story.
            <break time="1000ms"/>
            A story from the book of Daniel.
            <break time="1000ms"/>
            Chapter six.
            <break time="1800ms"/>
            The lions' den.
            <break time="3800ms"/>
            A man named Daniel — a man of prayer, a man of faithfulness —
            <break time="500ms"/>
            who would not stop praying even when it cost him everything.
            <break time="1800ms"/>
            He was placed in a den of lions.
            <break time="1000ms"/>
            And he was kept safe through the darkest night.
            <break time="3800ms"/>
            The lions are shut.
            <break time="1000ms"/>
            The angel watches.
            <break time="1000ms"/>
            God is near.
            <break time="1000ms"/>
            You are safe.
            <break time="1000ms"/>
            The night will pass.
            <break time="1000ms"/>
            You can rest.
            <break time="3800ms"/>
            Let yourself be still now.
            <break time="1800ms"/>
            The story is ready.
            <break time="1800ms"/>
            And so are you.
    </prosody>
  </voice>
</speak>
