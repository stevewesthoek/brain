<!--ID=B7267351-473F-409D-9765-754A8EBCDE05;Version=1|{"VoiceNameToIdMapItems":[{"Id":"f1b99834-fbfc-4d32-846d-c4dbd3050c19","Name":"Microsoft Server Speech Text to Speech Voice (en-GB, OllieMultilingualNeural)","ShortName":"en-GB-OllieMultilingualNeural","Locale":"en-GB","VoiceType":"StandardVoice"}]}-->
<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.25%" pitch="-2.25%">
      David, the great king of Israel, has died.<break time="500ms"/>
      The man who slew Goliath, who sang psalms under open sky, who wept and worshipped and ruled for forty years.<break time="1000ms"/>
      He is gone now.<break time="1800ms"/>

      And Solomon his son sits on the throne.<break time="500ms"/>
      He is young.<break time="500ms"/>
      The kingdom stretching before him is vast.<break time="1000ms"/>
      Tribes and cities and borders and neighbours on every side.<break time="1800ms"/>

      He has inherited more than land.<break time="500ms"/>
      He has inherited the weight of a promise.<break time="500ms"/>
      God's covenant with David, passed now to the son.<break time="1000ms"/>
      A throne that carries both honour and heaviness.<break time="1800ms"/>

      But First Kings tells us something quiet about Solomon in these early days.<break time="500ms"/>
      He loves the Lord.<break time="1000ms"/>
      He walks in the statutes of his father David.<break time="1800ms"/>

      Not perfectly.<break time="500ms"/>
      Not without questions.<break time="500ms"/>
      But faithfully, in the way a young man follows the path his father walked before him.<break time="1000ms"/>
      Step by step.<break time="500ms"/>
      With reverence.<break time="500ms"/>
      With care.<break time="1800ms"/>

      The kingdom is large, and Solomon is small inside it.<break time="500ms"/>
      But he does not turn away from God.<break time="1000ms"/>
      He turns toward Him.<break time="1800ms"/>
      And that turning is where our story begins.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
