<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.00%" pitch="-2.75%">
      It pleases the Lord that Solomon asked this.<break time="1000ms"/>
      The text says it plainly.<break time="500ms"/>
      It pleased the Lord.<break time="1800ms"/>

      God responds, and in His response we hear something like delight.<break time="500ms"/>
      Because you have asked this, and have not asked for yourself long life or riches or the life of your enemies.<break time="1000ms"/>
      But have asked for yourself understanding to discern what is right.<break time="1800ms"/>

      Behold, I now do according to your word.<break time="500ms"/>
      I give you a wise and discerning mind.<break time="1000ms"/>
      So that none like you has been before you, and none like you shall arise after you.<break time="1800ms"/>

      And then, the overflow.<break time="500ms"/>
      God gives Solomon what he did not ask for.<break time="1000ms"/>
      I give you also what you have not asked.<break time="500ms"/>
      Both riches and honour.<break time="500ms"/>
      So that no other king shall compare with you all your days.<break time="1800ms"/>

      The humble request opened the door to more than Solomon imagined.<break time="500ms"/>
      Not because God rewards cleverness.<break time="500ms"/>
      But because God delights in a heart that seeks understanding over gain.<break time="1800ms"/>

      Solomon awakes.<break time="500ms"/>
      And behold, it was a dream.<break time="1000ms"/>
      The hilltop is quiet.<break time="500ms"/>
      The stars are still overhead.<break time="500ms"/>
      The morning is near.<break time="1000ms"/>
      And everything has changed.<break time="1800ms"/>

      Wisdom was given in the night.<break time="500ms"/>
      Gently.<break time="500ms"/>
      While the king slept.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
