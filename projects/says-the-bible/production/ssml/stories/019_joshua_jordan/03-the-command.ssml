<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.50%" pitch="-2.50%">
      God speaks to Joshua.<break time="500ms"/>
      Quietly, as He always does to those He has chosen to lead.<break time="1000ms"/>
      Today I will begin to exalt you in the sight of all Israel.<break time="1800ms"/>

      That they may know that as I was with Moses, so I will be with you.<break time="500ms"/>
      The same God who parted the Red Sea.<break time="500ms"/>
      The same God who brought water from rock.<break time="1000ms"/>
      The same faithfulness, now given to Joshua.<break time="1800ms"/>

      And God gives the instruction.<break time="500ms"/>
      The priests are to carry the ark of the covenant.<break time="500ms"/>
      The wooden chest overlaid with gold, the mercy seat, the presence of God among His people.<break time="1000ms"/>
      They are to carry it ahead of the nation.<break time="1800ms"/>

      And when they reach the Jordan, they are to step in.<break time="500ms"/>
      Not wait for the waters to part first.<break time="500ms"/>
      Not wait for a bridge or a shallow place.<break time="1000ms"/>
      Step in.<break time="1800ms"/>

      This is how God often works.<break time="500ms"/>
      The way opens after the step, not before it.<break time="500ms"/>
      The clarity comes after the obedience, not ahead of it.<break time="1000ms"/>
      Trust is asked for before proof is given.<break time="1800ms"/>

      Joshua does not argue.<break time="500ms"/>
      He does not ask for a sign.<break time="500ms"/>
      He gathers the people and tells them what God has said.<break time="1000ms"/>
      And tomorrow, they will walk toward the water.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
