<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.75%" pitch="-3.10%">
      All the people cross on dry ground.<break time="500ms"/>
      Every man, woman, and child.<break time="500ms"/>
      Every animal, every bundle, every family.<break time="1000ms"/>
      All of them safely on the other side.<break time="1800ms"/>

      Then the priests come up out of the Jordan.<break time="500ms"/>
      They step from the dry riverbed onto the western bank.<break time="500ms"/>
      And the moment their feet touch solid ground, the waters return.<break time="1800ms"/>

      The Jordan rushes back to its place.<break time="500ms"/>
      Flowing at flood stage, wide and strong, just as it was before.<break time="500ms"/>
      As if nothing had happened.<break time="1000ms"/>
      But everything has happened.<break time="1800ms"/>

      The twelve stones are carried to Gilgal.<break time="500ms"/>
      They are set up there, on the plains east of Jericho.<break time="500ms"/>
      A circle of rough stones from the bottom of a river.<break time="1000ms"/>
      A quiet monument to a day the waters stood still.<break time="1800ms"/>

      The promise made to Abraham, that his children would have a land, is now beginning to be fulfilled.<break time="500ms"/>
      The promise spoken to Moses, that God would bring them in, is now kept.<break time="1000ms"/>
      They stand in the land.<break time="1800ms"/>

      The wandering is over.<break time="500ms"/>
      The river is behind them.<break time="500ms"/>
      The ground beneath their feet is the ground God promised.<break time="1000ms"/>
      And the stones remember.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
