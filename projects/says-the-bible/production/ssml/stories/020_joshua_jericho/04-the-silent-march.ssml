<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.75%" pitch="-2.60%">
      Joshua gathered the people and gave them one command above all others.<break time="1000ms"/>
      You shall not shout or make your voice heard.<break time="500ms"/>
      Not a word shall come out of your mouth until the day I tell you to shout.<break time="1800ms"/>

      Silence.<break time="1000ms"/>
      That was the discipline asked of them.<break time="500ms"/>
      Not the silence of defeat, but the silence of obedience.<break time="1800ms"/>

      And so the march began.<break time="500ms"/>
      The armed guard went first, steady and watchful.<break time="500ms"/>
      Then the seven priests with their rams' horn trumpets, blowing as they walked.<break time="500ms"/>
      Behind them, the ark of the covenant, carried with reverence.<break time="500ms"/>
      And behind the ark, the rear guard, quiet and faithful.<break time="1800ms"/>

      They circled the city once.<break time="500ms"/>
      The dust rose beneath their feet.<break time="500ms"/>
      The walls of Jericho towered above them on every side.<break time="500ms"/>
      The people on the walls watched in confusion.<break time="1000ms"/>
      What kind of army marches in silence?<break time="1800ms"/>

      When the circuit was complete, they returned to camp.<break time="500ms"/>
      No battle cry.<break time="500ms"/>
      No clash of weapons.<break time="500ms"/>
      Just the soft sound of thousands of footsteps and the low voice of rams' horns fading into the evening air.<break time="1800ms"/>

      Sometimes faith looks like simply showing up and walking the path you have been given.<break time="1000ms"/>
      Without understanding everything.<break time="500ms"/>
      Without seeing the end from the beginning.<break time="1000ms"/>
      Just walking.<break time="1800ms"/>
      And trusting.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
