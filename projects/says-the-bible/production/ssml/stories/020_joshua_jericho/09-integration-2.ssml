<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.50%" pitch="-3.60%">
      The march is over.<break time="1800ms"/>
      The walls are down.<break time="1800ms"/>
      The trumpets are quiet.<break time="1800ms"/>

      You have walked far enough today.<break time="1800ms"/>
      You can stop.<break time="3800ms"/>

      The walls have fallen.<break time="1800ms"/>
      The silence held.<break time="1800ms"/>
      The obedience was not in vain.<break time="1800ms"/>

      You do not need to march any further tonight.<break time="1800ms"/>
      You do not need to carry anything more.<break time="1800ms"/>
      The work is done.<break time="3800ms"/>

      Let there be less effort now.<break time="1800ms"/>
      Less inner striving.<break time="1800ms"/>
      Less holding on.<break time="3800ms"/>

      Your breathing can slow.<break time="1800ms"/>
      In, and out.<break time="1800ms"/>
      Held, and still.<break time="1800ms"/>
      Quiet, and safe.<break time="3800ms"/>

      The walls have fallen.<break time="1800ms"/>
      The march is over.<break time="1800ms"/>
      You are held.<break time="3800ms"/>
      Obedience is enough.<break time="1800ms"/>
      God's plan holds.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
