<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.25%" pitch="-2.25%">
            Jacob left Beersheba and set out for Haran.<break time="500ms"/>
      He was leaving the land of his father Isaac and his mother Rebekah.<break time="500ms"/>
      He was leaving because his brother Esau was angry.<break time="1000ms"/>
      Jacob had taken the blessing that belonged to the firstborn.<break time="500ms"/>
      He had knelt before his father with goatskin on his hands, and Isaac, old and blind, had blessed him thinking he was Esau.<break time="1000ms"/>
      When Esau discovered what had happened, he wept bitterly and said in his heart that he would kill his brother.<break time="1800ms"/>
      So Rebekah told Jacob to flee to her brother Laban in Haran, far to the north.<break time="500ms"/>
      And Isaac sent him away with a blessing, saying, may God Almighty bless you and make you fruitful and multiply you.<break time="1000ms"/>
      But for now, Jacob was simply walking.<break time="500ms"/>
      The road stretched long ahead of him.<break time="500ms"/>
      The land of Canaan spread out dry and open around him.<break time="1000ms"/>
      He was alone, perhaps for the first time in his life.<break time="500ms"/>
      No tent of his father.<break time="500ms"/>
      No voice of his mother.<break time="500ms"/>
      Just his own steps on the dust, and the horizon ahead.<break time="1800ms"/>
      The sun moved across the sky and began to set.<break time="500ms"/>
      Jacob came to a certain place and stopped, because the sun had gone down.<break time="500ms"/>
      He would rest here for the night.<break time="1000ms"/>
      The day was done.<break time="500ms"/>
      He could go no further.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
