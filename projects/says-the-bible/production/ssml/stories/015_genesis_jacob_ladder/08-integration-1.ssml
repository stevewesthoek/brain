<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            The stone became a pillar.<break time="1800ms"/>
      The ground was holy.<break time="1800ms"/>
      The ladder reached to heaven.<break time="1800ms"/>
      God was in that place.<break time="1800ms"/>
      Jacob did not know it, but God was already there.<break time="1800ms"/>
      Before the dream, before the sleep, before Jacob even stopped walking.<break time="1800ms"/>
      God was already there.<break time="3800ms"/>
      You are not alone.<break time="1800ms"/>
      The promise still holds.<break time="1800ms"/>
      Wherever you go, God is with you.<break time="1800ms"/>
      He will keep you.<break time="1800ms"/>
      He will not leave you.<break time="3800ms"/>
      You do not need to earn that presence.<break time="3800ms"/>
      You can rest.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
