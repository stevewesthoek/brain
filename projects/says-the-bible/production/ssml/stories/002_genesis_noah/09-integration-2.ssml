<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-14.00%" pitch="-3.75%">
      God remembered Noah.<break time="1800ms"/>
      God remembers you.<break time="1800ms"/>

      God brought the waters down.<break time="1800ms"/>
      God brings your thoughts down, little by little.<break time="1800ms"/>

      You are safe in God's care.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>

      Nothing new is required from you.<break time="1800ms"/>
      No proving.<break time="1800ms"/>
      No striving.<break time="1800ms"/>

      Just breathing.<break time="1800ms"/>
      Just quiet.<break time="1800ms"/>

      You are safe in God's care.<break time="3800ms"/>
      You can rest.<break time="3800ms"/>

      And now, let there be a longer space.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
