<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-12.50%" pitch="-3.25%">
      Then Genesis gives us a simple line.<break time="500ms"/>
      God remembered Noah.<break time="1000ms"/>
      Not because He had forgotten, but because He was turning the story toward mercy.<break time="1800ms"/>

      A wind blew over the earth.<break time="500ms"/>
      And slowly, the waters began to go down.<break time="1000ms"/>
      The ark came to rest on mountains.<break time="1800ms"/>

      Still, there was waiting.<break time="500ms"/>
      Noah opened a window.<break time="500ms"/>
      He sent out a bird.<break time="500ms"/>
      And later, a dove.<break time="1000ms"/>
      First, the dove came back.<break time="500ms"/>
      Then it returned with an olive leaf.<break time="1000ms"/>
      A small sign of dry ground.<break time="1800ms"/>

      Noah waited again, and in time the dove did not return.<break time="1800ms"/>

      God remembered Noah.<break time="1000ms"/>
      God brings waters down, little by little.<break time="1000ms"/>
      God remembers you, in your quiet.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
