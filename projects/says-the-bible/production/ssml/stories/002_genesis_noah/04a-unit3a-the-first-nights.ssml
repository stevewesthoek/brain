<!--ID=FCB40C2B-1F9F-4C26-B1A1-CF8E67BE07D1;Version=1|{"Files":{}}-->
<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.75%" pitch="-3.00%">
      After the door was shut, there were first moments of quiet inside the ark.<break time="500ms"/>
      Breathing.<break time="500ms"/>
      Listening.<break time="1000ms"/>
      The sense of being enclosed, and kept.<break time="1800ms"/>

      The animals settled into their spaces.<break time="500ms"/>
      Hooves and paws shifting on wood.<break time="500ms"/>
      Soft sounds of life, close and ordinary.<break time="1800ms"/>

      Then the rain continued.<break time="500ms"/>
      At first it might have sounded like a steady tapping.<break time="500ms"/>
      Then louder, like a constant curtain of water.<break time="1000ms"/>
      Still, the ark remained a shelter.<break time="1800ms"/>

      Noah would have moved through the rooms.<break time="500ms"/>
      Checking what needed checking.<break time="500ms"/>
      Offering food.<break time="500ms"/>
      Speaking gently to his family.<break time="1000ms"/>
      We are here, together.<break time="1800ms"/>

      There is a kind of peace in being shut in by God.<break time="500ms"/>
      Not trapped, but protected.<break time="1800ms"/>

      The rain can fall, and you can still be held.<break time="1000ms"/>
      God can keep you in the middle of what is heavy.<break time="1000ms"/>
      You are safe in God's care.<break time="1800ms"/>
      You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
