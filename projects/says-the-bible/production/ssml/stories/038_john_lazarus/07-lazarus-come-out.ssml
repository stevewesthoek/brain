<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-11.75%" pitch="-3.10%">
            Jesus prays aloud at the open tomb.<break time="500ms"/>
            Father, I thank you that you have heard me.<break time="500ms"/>
            I knew that you always hear me.<break time="500ms"/>
            But I said this for the benefit of the people standing here, that they may believe that you sent me.<break time="1800ms"/>
            He is not performing the prayer.<break time="500ms"/>
            He is letting the crowd into it.<break time="500ms"/>
            Letting them see the connection between the Father and the Son.<break time="1800ms"/>
            And when he has prayed, he calls out with a loud voice:<break time="1000ms"/>
            Lazarus, come out.<break time="3800ms"/>
            Three words aimed at death itself.<break time="1800ms"/>
            And the dead man comes out.<break time="1800ms"/>
            Lazarus walks out of the tomb, his hands and feet wrapped in linen burial strips,<break time="500ms"/>
            a cloth around his face.<break time="1800ms"/>
            Bound.<break time="500ms"/>
            Still wrapped for burial.<break time="500ms"/>
            Walking.<break time="1800ms"/>
            And Jesus says to the people standing there stunned and weeping and amazed:<break time="500ms"/>
            Unbind him.<break time="500ms"/>
            And let him go.<break time="3800ms"/>
            Not just raised.<break time="500ms"/>
            Unbound.<break time="500ms"/>
            Set free from everything that held him.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
