<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-13.00%" pitch="-3.40%">
            He heard the cry.<break time="1800ms"/>
            The one you love is sick.<break time="3800ms"/>
            He came.<break time="1800ms"/>
            He did not stay away.<break time="3800ms"/>
            He wept.<break time="1800ms"/>
            He stood in the grief before he moved through it.<break time="3800ms"/>
            He called by name.<break time="1800ms"/>
            Lazarus.<break time="1800ms"/>
            One name in the darkness, aimed like light.<break time="3800ms"/>
            The grave could not hold.<break time="1800ms"/>
            Four days was not too long.<break time="1800ms"/>
            Nothing is too far gone.<break time="3800ms"/>
            He unbound.<break time="1800ms"/>
            He did not just call Lazarus out — he had the wrappings removed.<break time="3800ms"/>
            You are heard in every cry.<break time="1800ms"/>
            He comes to you.<break time="1800ms"/>
            He weeps with you.<break time="1800ms"/>
            He calls you by name.<break time="9000ms"/>
    </prosody>
  </voice>
</speak>
