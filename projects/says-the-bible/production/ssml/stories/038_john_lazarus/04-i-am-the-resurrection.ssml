<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.75%" pitch="-2.60%">
            When Jesus arrives near Bethany, Lazarus has been in the tomb four days.<break time="1000ms"/>
            Four days.<break time="1800ms"/>
            Martha hears that Jesus is coming and she runs out to meet him on the road.<break time="1000ms"/>
            Mary stays at home.<break time="1800ms"/>
            Martha reaches Jesus and the grief and the question pour out together.<break time="500ms"/>
            She says: Lord, if you had been here, my brother would not have died.<break time="1000ms"/>
            But I know that even now God will give you whatever you ask.<break time="1800ms"/>
            There is faith in the wound.<break time="500ms"/>
            She believes even in the darkness.<break time="1800ms"/>
            Jesus says: Your brother will rise again.<break time="1800ms"/>
            Martha says: I know he will rise — at the last day, at the resurrection.<break time="1000ms"/>
            She believes in a future hope, a distant day.<break time="1800ms"/>
            And Jesus looks at her and says:<break time="500ms"/>
            I am the resurrection and the life.<break time="1000ms"/>
            Whoever believes in me will live, even though they die.<break time="500ms"/>
            And whoever lives by believing in me will never die.<break time="1800ms"/>
            Do you believe this?<break time="1800ms"/>
            He is not pointing to a future event.<break time="500ms"/>
            He is saying: the resurrection is standing in front of you.<break time="1000ms"/>
            I am.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
