<!--ID=5B95B1CC-2C7B-494F-B746-CF22A0E779B7;Version=1|{"Locales":{"en-US":{"AutoApplyCustomLexiconFiles":[{}]},"en-GB":{"AutoApplyCustomLexiconFiles":[{}]}}}-->
<speak xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="http://www.w3.org/2001/mstts"
       xmlns:emo="http://www.w3.org/2009/10/emotionml"
       version="1.0"
       xml:lang="en-GB">
  <voice name="en-GB-OllieMultilingualNeural">
    <prosody rate="-10.00%" pitch="-2.00%">
            Breathe in slowly.<break time="1800ms"/>
            And breathe out.<break time="3800ms"/>
            Again — breathe in.<break time="1800ms"/>
            And let it go.<break time="3800ms"/>
            You are here.<break time="1000ms"/>
            You are safe.<break time="1000ms"/>
            Let your body settle.<break time="3800ms"/>
            Tonight we go to Bethany.<break time="1000ms"/>
            A small village outside Jerusalem.<break time="1000ms"/>
            A family Jesus loved.<break time="1800ms"/>
            A man named Lazarus.<break time="1000ms"/>
            And a grave in a hillside.<break time="1800ms"/>
            This is the story of a man who died and was called back.<break time="1000ms"/>
            Not a symbol, not a metaphor — a real man, in a real tomb, four days gone.<break time="1800ms"/>
            And the one who raised him first stood outside the grave and wept.<break time="1800ms"/>
            Power wrapped entirely in compassion.<break time="1800ms"/>
            This is Lazarus raised from the dead, from the Gospel of John, chapter eleven.<break time="1800ms"/>
            He called you by name.<break time="1000ms"/>
            Death does not have the last word.<break time="1000ms"/>
            You are held.<break time="1000ms"/>
            He wept for you.<break time="1000ms"/>
            You are unbound.<break time="1000ms"/>
            You can rest.<break time="3800ms"/>
    </prosody>
  </voice>
</speak>
