Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

# M4 Mac (Tailscale by default)
Host office
  HostName 100.86.124.66
  User office
  ConnectTimeout 5
  ServerAliveInterval 15
  ServerAliveCountMax 2

# Prefer Thunderbolt when directly connected (overrides HostName above)
Match host office exec "/usr/bin/nc -G 1 -z 192.168.2.1 22"
  HostName 192.168.2.1
  ConnectTimeout 2

Host dokploy
  HostName 100.83.38.48
  User master
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
