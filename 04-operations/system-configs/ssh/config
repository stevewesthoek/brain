# SSH to CloudPanel server via Cloudflare Tunnel
Host cloudpanel
  HostName ssh_cp.prochat.tools
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  User master
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Azure CloudPanel via Tailscale
Host cloudpanel
  HostName 100.67.211.120
  User master

