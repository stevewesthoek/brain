{
  "name": "machine-brain",
  "version": "1.0.0",
  "description": "AI infrastructure, system configs, and skills for Claude Code, Codex, and Gemini",
  "private": true,
  "bin": {
    "prochat": "tools/prochat.mjs"
  },
  "scripts": {
    "test:phase7a": "node --test tools/context-learning/codex-code-default.test.mjs tools/context-learning/phase6c-isolated-code-tasks.test.mjs",
    "validate:phase7a": "node tools/context-learning/run-phase7a-codex-code-default.mjs --summary",
    "test:phase7b": "node --test tools/context-learning/claude-code-canary.test.mjs tools/context-learning/universal-consumer-contract.test.mjs tools/context-learning/cross-session-continuity-pilot.test.mjs",
    "validate:phase7b": "node tools/context-learning/run-phase7b-claude-code-canary.mjs --summary",
    "models:sync:bedrock": "bash tools/scripts/models-sync-bedrock.sh",
    "models:validate": "bash tools/scripts/models-validate.sh",
    "sync-ai-skills": "node tools/scripts/sync-ai-skills.mjs",
    "sync-credentials": "bash tools/scripts/sync-credentials.sh",
    "graphify:brain": "node tools/graphify-semantic-event.mjs --mode=scheduler",
    "graphify:mind": "node tools/scripts/graphify-mind-disabled.mjs",
    "graphify:brain:callflow": "node tools/scripts/graphify-structural-disabled.mjs",
    "graphify:mind:callflow": "node tools/scripts/graphify-mind-disabled.mjs",
    "test:codex-managed-root": "bash operations/scripts/tests/codex-home-managed-root.test.sh",
    "validate:workstation-config": "node tools/validate-workstation-config-ownership.mjs",
    "validate:local-text-policy": "node tools/validate-local-text-inference-policy.mjs",
    "validate:mind-project-decomposer": "python3 -m py_compile tools/scripts/mind-project-decomposer.py",
    "test:mind-project-decomposer": "python3 tools/scripts/tests/mind-project-decomposer.test.py",
    "test:model-selector": "python3 -m unittest discover -s operations/system-configs/model-selector/tests -p 'test_*.py'",
    "validate:diff-check": "git diff --check",
    "ibr:atomizer:dry-run": "node tools/infinite-brain/atomizer-dry-run.mjs",
    "ibr:classify:dry-run": "node tools/infinite-brain/entity-classifier-dry-run.mjs",
    "ibr:edges:dry-run": "node tools/infinite-brain/edge-inference-dry-run.mjs",
    "ibr:relationships:audit": "node tools/infinite-brain/relationship-audit-dry-run.mjs",
    "ibr:insights:dry-run": "node tools/infinite-brain/insight-generation-dry-run.mjs",
    "ibr:proposals:dry-run": "node tools/infinite-brain/proposal-generation-dry-run.mjs",
    "ibr:pipeline:dry-run": "node tools/infinite-brain/run-report-only-pipeline.mjs",
    "validate:context-learning-contracts": "node tools/validate-context-learning-contracts.mjs",
    "test:context-learning": "node --test tools/context-learning/context-learning-contracts.test.mjs",
    "clr1:memory-inventory": "node tools/context-learning/inventory-shared-memory.mjs",
    "validate:context-learning-broker": "node tools/validate-context-learning-broker.mjs",
    "test:context-broker": "node --test tools/context-learning/context-broker.test.mjs",
    "validate:clr3-portal-contracts": "node tools/validate-clr3-portal-contracts.mjs",
    "validate:context-learning-deployment": "node tools/validate-context-learning-deployment.mjs",
    "test:context-learning-deployment": "node --test tools/context-learning/deployment-runtime.test.mjs",
    "validate:infrastructure-catalog": "node tools/validate-infrastructure-catalog.mjs",
    "test:infrastructure-catalog": "node --test tools/infrastructure-catalog/catalog-core.test.mjs",
    "validate:infrastructure-health": "node tools/validate-infrastructure-health.mjs",
    "test:infrastructure-health": "node --test projects/brain-core/src/tests/infrastructure-observation-runtime.test.mjs",
    "validate:infrastructure-incidents": "node tools/validate-infrastructure-incidents.mjs",
    "test:infrastructure-incidents": "node --test projects/brain-core/src/tests/infrastructure-incident-engine.test.mjs",
    "validate:infrastructure-actions": "node tools/validate-infrastructure-actions.mjs",
    "test:infrastructure-actions": "node --test projects/brain-core/src/tests/infrastructure-action-safety.test.mjs",
    "validate:infrastructure-action-receipts": "node tools/validate-infrastructure-action-receipts.mjs",
    "test:infrastructure-action-receipts": "node --test projects/brain-core/src/tests/infrastructure-action-receipt-runtime.test.mjs",
    "validate:infrastructure-automation-admission": "node tools/validate-infrastructure-automation-admission.mjs",
    "validate:infrastructure-automation-measurement": "node tools/validate-infrastructure-automation-measurement.mjs",
    "test:infrastructure-automation-measurement": "node --test projects/brain-core/src/tests/infrastructure-automation-measurement.test.mjs",
    "validate:infrastructure-consumers": "node tools/validate-infrastructure-consumers.mjs",
    "test:infrastructure-consumers": "node --test projects/brain-core/src/tests/infrastructure-plane.test.mjs",
    "infinite-brain:conformance": "node tools/scripts/validate-infinite-brain-conformance.mjs",
    "infinite-brain:cross-repo-contract": "node tools/scripts/validate-cross-repo-contract.mjs",
    "validate:orchestrator-v2": "node tools/validate-orchestrator-v2.mjs",
    "test:orchestrator-v2": "node --test tools/orchestration/capability-catalog.test.mjs tools/orchestration/shadow-intent-router.test.mjs",
    "validate:universal-consumer-conformance": "node tools/validate-universal-consumer-conformance.mjs",
    "test:universal-consumer-conformance": "node --test tools/context-learning/universal-consumer-contract.test.mjs"
  },
  "keywords": [
    "claude",
    "bedrock",
    "models",
    "ai-infrastructure"
  ],
  "author": "Steve Westhoek",
  "license": "MIT",
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
