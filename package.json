{
  "name": "machine-brain",
  "version": "1.0.0",
  "description": "AI infrastructure, system configs, and skills for Claude Code, Codex, and Gemini",
  "private": true,
  "scripts": {
    "models:sync:bedrock": "bash tools/scripts/models-sync-bedrock.sh",
    "models:validate": "bash tools/scripts/models-validate.sh",
    "sync-ai-skills": "node tools/scripts/sync-ai-skills.mjs",
    "sync-credentials": "bash tools/scripts/sync-credentials.sh",
    "graphify:brain": "node tools/graphify-semantic-event.mjs --mode=scheduler",
    "graphify:mind": "node tools/scripts/graphify-mind-disabled.mjs",
    "graphify:brain:callflow": "node tools/scripts/graphify-structural-disabled.mjs",
    "graphify:mind:callflow": "node tools/scripts/graphify-mind-disabled.mjs",
    "test:codex-managed-root": "bash operations/scripts/tests/codex-home-managed-root.test.sh",
    "validate:workstation-config": "node tools/validate-workstation-config-ownership.mjs",
    "validate:local-text-policy": "node tools/validate-local-text-inference-policy.mjs",
    "validate:mind-project-decomposer": "python3 -m py_compile tools/scripts/mind-project-decomposer.py",
    "test:mind-project-decomposer": "python3 tools/scripts/tests/mind-project-decomposer.test.py",
    "test:model-selector": "python3 -m unittest discover -s operations/system-configs/model-selector/tests -p 'test_*.py'",
    "validate:diff-check": "git diff --check",
    "ibr:atomizer:dry-run": "node tools/infinite-brain/atomizer-dry-run.mjs",
    "ibr:classify:dry-run": "node tools/infinite-brain/entity-classifier-dry-run.mjs",
    "ibr:edges:dry-run": "node tools/infinite-brain/edge-inference-dry-run.mjs",
    "ibr:relationships:audit": "node tools/infinite-brain/relationship-audit-dry-run.mjs",
    "ibr:insights:dry-run": "node tools/infinite-brain/insight-generation-dry-run.mjs",
    "ibr:proposals:dry-run": "node tools/infinite-brain/proposal-generation-dry-run.mjs",
    "ibr:pipeline:dry-run": "node tools/infinite-brain/run-report-only-pipeline.mjs",
    "validate:context-learning-contracts": "node tools/validate-context-learning-contracts.mjs",
    "test:context-learning": "node --test tools/context-learning/context-learning-contracts.test.mjs",
    "clr1:memory-inventory": "node tools/context-learning/inventory-shared-memory.mjs",
    "infinite-brain:conformance": "node tools/scripts/validate-infinite-brain-conformance.mjs",
    "infinite-brain:cross-repo-contract": "node tools/scripts/validate-cross-repo-contract.mjs"
  },
  "keywords": [
    "claude",
    "bedrock",
    "models",
    "ai-infrastructure"
  ],
  "author": "Steve Westhoek",
  "license": "MIT",
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
