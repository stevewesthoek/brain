{
  "name": "Apify Multi-Account Credential Manager",
  "nodes": [
    {
      "parameters": {},
      "id": "c9857c5d-2a0e-4a5a-8b3c-1234567890ab",
      "name": "When called via webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "apify-next-token",
      "method": "POST"
    },
    {
      "parameters": {
        "functionCode": "// Day-based deterministic account selection\n// Always returns the same account for the same day (stateless, no server state)\nconst now = new Date();\nconst daysSinceEpoch = Math.floor(now.getTime() / 86400000);\n\n// If caller specifies an offset, use that for Pattern A deduplication\nlet accountIndex;\nif ($input.first().json.offset !== undefined && $input.first().json.items_per_account !== undefined) {\n  // Pattern A: paginated slices\n  const itemsPerAccount = $input.first().json.items_per_account || 100;\n  accountIndex = (Math.floor($input.first().json.offset / itemsPerAccount)) % 10;\n} else {\n  // Day-based rotation (default)\n  accountIndex = daysSinceEpoch % 10;\n}\n\nconst tokenVar = `APIFY_TOKEN_${accountIndex + 1}`;\n\nreturn {\n  account_index: accountIndex + 1,\n  day_based: true,\n  token_variable: tokenVar,\n  pagination_offset: $input.first().json.offset || undefined,\n  items_per_account: $input.first().json.items_per_account || 100,\n  caller_id: $input.first().json.caller_id || 'unknown'\n};"
      },
      "id": "9f8e7d6c-5b4a-3c2d-1e0f-abcdef123456",
      "name": "Calculate account index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignment": [
          {
            "name": "token",
            "value": "={{$vars[$node[\"Calculate account index\"].json.token_variable]}}"
          },
          {
            "name": "account_name",
            "value": "=ProChat-{{$node[\"Calculate account index\"].json.account_index}}"
          },
          {
            "name": "account_index",
            "value": "={{$node[\"Calculate account index\"].json.account_index}}"
          },
          {
            "name": "pagination_offset",
            "value": "={{$node[\"Calculate account index\"].json.pagination_offset}}"
          },
          {
            "name": "items_per_account",
            "value": "={{$node[\"Calculate account index\"].json.items_per_account}}"
          },
          {
            "name": "total_accounts",
            "value": "=10"
          },
          {
            "name": "caller_id",
            "value": "={{$node[\"Calculate account index\"].json.caller_id}}"
          }
        ]
      },
      "id": "7c6b5a4d-3c2b-1a0e-f9d8-c7b6a5949384",
      "name": "Build response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "a1b2c3d4-e5f6-4g7h-8i9j-k0l1m2n3o4p5",
      "name": "Respond to webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "When called via webhook": {
      "main": [
        [
          {
            "node": "Calculate account index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate account index": {
      "main": [
        [
          {
            "node": "Build response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build response": {
      "main": [
        [
          {
            "node": "Respond to webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "instanceId": "auto-generated"
  },
  "documentation": {
    "description": "Stateless webhook endpoint for multi-account credential rotation. Returns next token based on day-based deterministic index or offset-based Pattern A deduplication.",
    "endpoint": "POST /webhook/apify-next-token",
    "request_body": {
      "caller_id": "workflow name for logging",
      "offset": "optional - for Pattern A deduplication (pagination)",
      "items_per_account": "optional - items per account slice (default 100)"
    },
    "response": {
      "token": "apify_api_... from n8n variables",
      "account_name": "ProChat-N",
      "account_index": "1-10",
      "pagination_offset": "calculated offset for this account",
      "items_per_account": "items per slice",
      "total_accounts": "10",
      "caller_id": "echoed from request"
    },
    "n8n_setup": [
      "1. In n8n Admin → Variables, create 10 variables:",
      "   APIFY_TOKEN_1 = apify_api_... (ProChat-1)",
      "   APIFY_TOKEN_2 = apify_api_... (ProChat-2)",
      "   ...",
      "   APIFY_TOKEN_10 = apify_api_... (ProChat-10)",
      "",
      "2. Deploy this workflow to n8n",
      "",
      "3. Parent workflows call:",
      "   POST https://n8n.prochat.tools/webhook/apify-next-token",
      "   {\"caller_id\": \"my-workflow-name\", \"offset\": 0}",
      "",
      "4. Response will have 'token' ready to use in subsequent HTTP nodes"
    ],
    "patterns": {
      "day_based_default": "Without offset param, returns same account for all calls on same calendar day (stateless, no race conditions)",
      "pattern_a_pagination": "With offset param, returns account based on offset position for paginated deduplication"
    }
  }
}
