{
	"name": "@prochat/prokit",
	"version": "1.0.52",
	"private": true,
	"description": "ProKit is ProChat’s developer core boilerplate for building SaaS apps.",
	"author": "Steve Westhoek",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "./scripts/runtime/start-prod.sh",
		"start:app": "next start -p $PORT",
		"lint": "next lint",
		"verify:deploy": "./scripts/db/verify.sh",
		"prokit:bootstrap": "./scripts/project/bootstrap.sh",
		"prokit:migrate": "./scripts/project/migrate.sh",
		"db:init": "node scripts/db/init-tenant.js",
		"db:cleanup": "node scripts/db/cleanup-tenant.js",
		"db:migrate:dev": "prisma migrate dev --schema=prisma/system.prisma",
		"db:migrate:prod": "prisma migrate deploy --schema=prisma/system.prisma",
		"predev": "node scripts/dev/bootstrap-env.js && npm run db:init && npm run db:migrate:dev",
		"db:rename": "node scripts/db/rename-tenant.js"
	},
	"dependencies": {
		"@clerk/nextjs": "5.7.1",
		"@prisma/client": "6.7.0",
		"@radix-ui/react-slot": "^1.1.0",
		"@react-email/components": "^0.0.25",
		"@stripe/stripe-js": "4.7.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"lucide-react": "^0.408.0",
		"next": "^14.2.31",
		"next-themes": "^0.4.4",
		"pg": "^8.12.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"resend": "^4.0.0",
		"sass": "^1.82.0",
		"stripe": "16.0.0",
		"tailwind-merge": "^2.4.0"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"@typescript-eslint/eslint-plugin": "^7.16.0",
		"@typescript-eslint/parser": "^7.16.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^8",
		"eslint-config-next": "^14.2.31",
		"postcss": "^8.4.49",
		"prisma": "6.7.0",
		"tailwindcss": "^3.4.16",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5"
	}
}
