# Config syntax crash course
# ==========================
# The config file consists of simple key-value pairs, separated by equals signs.
# Any line beginning with a # is a comment. It's not possible to put a comment
# after a config option, since it would be interpreted as part of the value.

font-family = JetBrainsMono Nerd Font
font-size = 16
font-feature = calt,liga
#font-feature = -calt,-liga,-dlig    # example: kill ligatures

theme = Cobalt2

resize-overlay-duration = 4s 200ms

working-directory = "Users/Office/Repos/Personal/Brain"

background-opacity = 0.85
background-blur = 70

window-padding-x = 30
window-padding-y = 30

# Keep native frame (so corners/edges are resizable)
window-decoration = auto

# Hide the macOS titlebar (no traffic lights / title bar)
macos-titlebar-style = hidden

confirm-close-surface = false
clipboard-paste-protection = false

cursor-style = block

selection-foreground = cell-foreground
selection-background = #36424C

scroll-to-bottom = keystroke,no-output
grapheme-width-method = legacy